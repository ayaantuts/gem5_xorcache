  action(aastp_allocateSingularTag_paired, "aastp", desc="allocate singular tag paired") {
    Addr paired_addr := tbe.paired;
    singularTag.allocate(paired_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" st++(");
    APPEND_TRANSITION_COMMENT(paired_addr);
    APPEND_TRANSITION_COMMENT(")");
    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:SS) {
      singularTagShared.allocate(paired_addr, new Entry);
      APPEND_TRANSITION_COMMENT(" sts++(");
      APPEND_TRANSITION_COMMENT(paired_addr);
      APPEND_TRANSITION_COMMENT(")");
    }
  }
