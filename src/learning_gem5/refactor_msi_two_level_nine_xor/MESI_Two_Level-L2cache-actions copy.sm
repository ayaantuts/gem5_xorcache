  action(set_primary_as_cache_entry, "s1", desc="set primary as cache entry") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    set_cache_entry(L2cache.lookup(primary_addr));
  }

  action(set_secondary_as_cache_entry, "s2", desc="set secondary as cache entry") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    set_cache_entry(L2cache.lookup(secondary_addr));
  }

  action(set_primary_as_tbe, "stbe1", desc="set primary as cache entry") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    set_tbe(TBEs[primary_addr]);
  }

  action(set_secondary_as_tbe, "stbe2", desc="set secondary as cache entry") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    set_tbe(TBEs[secondary_addr]);
  }

  action(l2_removeSecondarySharer, "l2", desc="Rm one sharer from list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      removeSecondarySharer(address, in_msg.Requestor, cache_entry);
      APPEND_TRANSITION_COMMENT( cache_entry.Sharers2 );
    }
  }

  action(nns_addSecondarySharer, "\ns", desc="Add L1 sharer to list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      addSecondarySharer(address, in_msg.Requestor, cache_entry);
      APPEND_TRANSITION_COMMENT( cache_entry.Sharers2 );
    }
  }
  action(lls_clearSecondarySharers, "\ls", desc="Rm all L1 sharers from list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      cache_entry.Sharers2.clear();
      APPEND_TRANSITION_COMMENT( cache_entry.Sharers2 );
      DPRINTF(RubySlicc, "sharers2 cleared for address: %#x\n", in_msg.addr);
      DPRINTF(RubySlicc, "sharers are %s\n", cache_entry.Sharers);
      DPRINTF(RubySlicc, "cache_entry.DataBlk:%s\n", cache_entry.DataBlk);
    }
  }
  action(mmsu_markSecondaryExclusiveFromUnblock, "\msu", desc="set the exclusive owner") {
    peek(L1unblockNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.Sharers2.clear();
      cache_entry.Exclusive := in_msg.Sender;
      addSecondarySharer(address, in_msg.Sender, cache_entry);
    }
  }

  action(bf2_forwardRequestToSharer, "fwd2", desc="Forward request to the sharer") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers2.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }
  action(bf1_forwardRequestToSharer, "fwd1", desc="Forward request to the sharer") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }


  action(c2_exclusiveCleanReplacement, "cc2", desc="Send ack to memory for clean replacement") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    enqueue(responseL2Network_out, ResponseMsg, bypass_latency) {
      out_msg.addr := secondary_addr;
      out_msg.Type := CoherenceResponseType:ACK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }
  action(c1_exclusiveReplacement, "c1", desc="Send data to memory") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := primary_addr;
      out_msg.Type := CoherenceResponseType:MEMORY_DATA;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(primary_addr, MachineType:Directory));
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.MessageSize := MessageSizeType:Response_Data;
    }
  }
  action(c2_exclusiveReplacement, "c2", desc="Send data to memory") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := secondary_addr;
      out_msg.Type := CoherenceResponseType:MEMORY_DATA;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(secondary_addr, MachineType:Directory));
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty2;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      DPRINTF(RubySlicc, "sending replacement data to mem (dirty=%d): %s\n", out_msg.Dirty, out_msg.DataBlk);
    }
  }
  action(cr_exclusiveReplacement_fromResp, "cr", desc="Send data to memory from resp") {
    peek(responseL2Network_in, ResponseMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:MEMORY_DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(mapAddressToMachine(address, MachineType:Directory));
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.Dirty := in_msg.Dirty;
        out_msg.MessageSize := MessageSizeType:Response_Data;
      }
    }
  }



  action(dpb1_sendSecondaryDataToRequestor_piggyback, "dpb1", desc="Send data from cache to reqeustor") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := secondary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Data;

        out_msg.AckCount := 0 - cache_entry.Sharers.count();
        if (cache_entry.Sharers.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
      }
    }
  }
  action(dpb2_sendPrimaryDataToRequestor_piggyback, "dpb2", desc="Send data from cache to reqeustor") {
    // assert(L2cache.hasSecondaryAddr(address) == true);
    // Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := primary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Data;

        out_msg.AckCount := 0 - cache_entry.Sharers2.count();
        if (cache_entry.Sharers2.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
        DPRINTF(RubySlicc, "this addr=0x%llx, piggyback addr=0x%llx\n", address, primary_addr);
      }
    }
  }
