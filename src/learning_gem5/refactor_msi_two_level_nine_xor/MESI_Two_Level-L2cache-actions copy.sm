  action(recover2, "rcv2", desc="secondary=in^cache") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(is_valid(getCacheEntry(secondary_addr)));

    // recover data for secondary block
    peek(L1RequestL2Network_in, RequestMsg) {
      DataBlock curData := cache_entry.DataBlk;
      DPRINTF(RubySlicc, "before xor: %s\n", curData);
      DPRINTF(RubySlicc, "xorer: %s\n", in_msg.DataBlk);
      // xor curData with in_msg.DataBlk
      DataBlock newData := dataProc.preprocess(curData, in_msg.DataBlk);
      DPRINTF(RubySlicc, "after xor: %s\n", newData);
      getCacheEntry(secondary_addr).DataBlk := newData;
      DPRINTF(RubySlicc, "dirty: %d\n", getCacheEntry(secondary_addr).Dirty);
      if (in_msg.Dirty) {
        getCacheEntry(secondary_addr).Dirty := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "recovered data secondary_addr 0x%llx, dirty=%d\n",secondary_addr, getCacheEntry(secondary_addr).Dirty);
  }
  action(l2a1_allocateL2, "l2a1", desc="allocate new L2 entry using primary addr") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    assert(L2cache.isTagPresent(primary_addr) == false);
    L2cache.allocate(primary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" l2++(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");

    getCacheEntry(primary_addr).Dirty := cache_entry.Dirty2;
    getCacheEntry(primary_addr).Sharers := cache_entry.Sharers2;
    getCacheEntry(primary_addr).DataBlk := cache_entry.DataBlk;
    getCacheEntry(primary_addr).Exclusive := cache_entry.Exclusive;
    DPRINTF(RubySlicc, "allocated L2 primary_addr: 0x%llx (dirty %s, sharers %s, data %s, E %s)\n", 
      primary_addr, getCacheEntry(primary_addr).Dirty, getCacheEntry(primary_addr).Sharers,
      getCacheEntry(primary_addr).DataBlk, getCacheEntry(primary_addr).Exclusive);
  }
  action(l2a2_allocateL2, "l2a2", desc="allocate new L2 entry using secandary addr") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(L2cache.isTagPresent(secondary_addr) == false);
    L2cache.allocate(secondary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" l2++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");

    getCacheEntry(secondary_addr).Dirty := cache_entry.Dirty2;
    getCacheEntry(secondary_addr).Sharers := cache_entry.Sharers2;
    getCacheEntry(secondary_addr).DataBlk := cache_entry.DataBlk;
    getCacheEntry(secondary_addr).Exclusive := cache_entry.Exclusive;
    DPRINTF(RubySlicc, "allocated L2 secondary_addr: 0x%llx (dirty %s, sharers %s, data %s, E %s)\n", 
      secondary_addr, getCacheEntry(secondary_addr).Dirty, getCacheEntry(secondary_addr).Sharers,
      getCacheEntry(secondary_addr).DataBlk, getCacheEntry(secondary_addr).Exclusive);
  }

