  action(mps_processWriteDataToPairedCache, "mps", desc="process and write data from response queue to secondary entry") {
    Addr paired_addr := tbe.paired;
    // DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe\n", paired_addr);
    assert(is_valid(getCacheEntry(paired_addr)));

    peek(responseL2Network_in, ResponseMsg) {
      // xor curData with in_msg.DataBlk
      DataBlock newData := dataProc.preprocess(getCacheEntry(paired_addr).DataBlk, in_msg.DataBlk);
      getCacheEntry(paired_addr).DataBlk := newData;
      if (in_msg.Dirty) {
        getCacheEntry(paired_addr).Dirty := in_msg.Dirty;
      }
    }
  }


  action(qqp_processwriteDataToTBE, "\qqp", desc="Write data from response queue to TBE") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(tbe));
      DataBlock newData := dataProc.preprocess(tbe.DataBlk, in_msg.DataBlk);
      tbe.DataBlk := newData;
      tbe.Dirty := in_msg.Dirty;
    }
  }

  action(l2_setPairedStateBack, "l2psb", desc="set paired block state back") {
    Addr paired_addr := tbe.paired;
    // DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe\n", paired_addr);
    assert(is_valid(getCacheEntry(paired_addr)));

    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:L2ONLY_s) {
      setCacheEntryState(getCacheEntry(paired_addr),paired_addr, State:L2ONLY);
      DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe set to L2ONLY\n", paired_addr);
    } else if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:SS_s) {
      setCacheEntryState(getCacheEntry(paired_addr),paired_addr, State:SS);
      DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe set to SS\n", paired_addr);
    } else {
      assert(false);
    }
  }
  action(mrid2_writeDataToCacheFromRequest, "mrid2", desc="Write data from response queue to cache (ignore dirty)") {
