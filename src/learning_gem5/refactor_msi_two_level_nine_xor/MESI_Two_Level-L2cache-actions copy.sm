  action(i1_allocateTBE, "i1", desc="Allocate TBE for request for primary") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    check_allocate(TBEs);
    assert(is_valid(getCacheEntry(primary_addr)));
    TBEs.allocate(primary_addr);
    TBEs[primary_addr].L1_GetS_IDs.clear();
    TBEs[primary_addr].DataBlk := cache_entry.DataBlk;
    TBEs[primary_addr].Dirty := cache_entry.Dirty;
    TBEs[primary_addr].pendingAcks := cache_entry.Sharers.count();
  }
  action(i2_allocateTBE, "i2", desc="Allocate TBE secondary for request") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(is_valid(getCacheEntry(secondary_addr)));

    check_allocate(TBEs);
    TBEs.allocate(secondary_addr);
    TBEs[secondary_addr].L1_GetS_IDs.clear();
    TBEs[secondary_addr].DataBlk := getCacheEntry(secondary_addr).DataBlk;
    TBEs[secondary_addr].Dirty := getCacheEntry(secondary_addr).Dirty2;
    TBEs[secondary_addr].pendingAcks := getCacheEntry(secondary_addr).Sharers2.count();
    DPRINTF(RubySlicc, "allocated tbe: 0x%llx\n", secondary_addr);
  }
  action(i2_allocateTBE2, "i22", desc="Allocate TBE secondary for request") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(is_valid(getCacheEntry(secondary_addr)));

    check_allocate(TBEs);
    TBEs.allocate(secondary_addr);
    set_tbe(TBEs[secondary_addr]);
    tbe.L1_GetS_IDs.clear();
    tbe.DataBlk := getCacheEntry(secondary_addr).DataBlk;
    tbe.Dirty := getCacheEntry(secondary_addr).Dirty2;
    tbe.pendingAcks := getCacheEntry(secondary_addr).Sharers2.count();
    DPRINTF(RubySlicc, "allocated tbe: 0x%llx\n", secondary_addr);
  }
  action(m2_writeDataToCache, "m2", desc="Write data from response queue to cache") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(is_valid(getCacheEntry(secondary_addr)));
    peek(responseL2Network_in, ResponseMsg) {
      getCacheEntry(secondary_addr).DataBlk := in_msg.DataBlk;
      if (in_msg.Dirty) {
        getCacheEntry(secondary_addr).Dirty := in_msg.Dirty;
      }
    }
  }
  action(m2d2_writeDataToCache_dirty2, "m2d2", desc="Write data from response queue to cache") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(is_valid(getCacheEntry(secondary_addr)));
    peek(responseL2Network_in, ResponseMsg) {
      getCacheEntry(secondary_addr).DataBlk := in_msg.DataBlk;
      if (in_msg.Dirty) {
        getCacheEntry(secondary_addr).Dirty2 := in_msg.Dirty;
      }
    }
  }


