  action(srx1_sendReconstructXToSharer, "srx1", desc="send Reconstruct to sharer") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, getMaxofTwo(dir.getDataLatency(), L2cache.getDataLatency())) {
        assert(is_valid(cache_entry));
        out_msg.addr := primary_addr;
        out_msg.piggybacked_addr := secondary_addr;
        out_msg.Type := CoherenceRequestType:RECONSTRUCTX;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control_Data;
        out_msg.DataBlk := cache_entry.DataBlk;

        out_msg.AckCount_communicate := 0 - cache_entry.Sharers2.count();
        if (cache_entry.Sharers2.isElement(in_msg.Requestor)) {
          out_msg.AckCount_communicate := out_msg.AckCount_communicate + 1;
        }
        DPRINTF(RubySlicc, "send RECONSTRUCT to %s, AckCount_communicate=%d\n", 
          out_msg.Destination, out_msg.AckCount_communicate);
      }
    }
  }
