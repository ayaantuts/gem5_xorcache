      getCacheEntry(secondary_addr).DataBlk := in_msg.DataBlk;
      if (in_msg.Dirty) {
        getCacheEntry(secondary_addr).Dirty := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "written data 0x%llx %s\n",secondary_addr, getCacheEntry(secondary_addr).DataBlk);
  }

