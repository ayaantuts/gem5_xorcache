  action(forward_eviction_to_cpu, "\cc", desc="sends eviction information to the processor") {
    if (send_evictions) {
      DPRINTF(RubySlicc, "Sending invalidation for %#x to the CPU\n", address);
      sequencer.evictionCallback(address);
    }
  }

  action(g_issuePUTX, "gX", desc="send data to the L2 cache, from M state") {
    enqueue(requestL1Network_out, RequestMsg, L1Dcache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:PUTX;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Requestor:= machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      if (cache_entry.Dirty) {
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
      } else {
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
      DPRINTF(RubySlicc, "g_issuePUTX %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }

  action(g_issuePUTS, "gS", desc="send data to the L2 cache, from S state") {
    enqueue(requestL1Network_out, RequestMsg, bypass_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:PUTS;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Requestor:= machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      // assert (!cache_entry.Dirty); 
      out_msg.MessageSize := MessageSizeType:Writeback_Control;

      DPRINTF(RubySlicc, "g_issuePUTS %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }
  action(g_issuePUTSData_fromTBE, "gSD", desc="send data to the L2 cache, from S state") {
    enqueue(requestL1Network_out, RequestMsg, tbe_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:PUTSDATA;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Dirty := tbe.Dirty;
      out_msg.Requestor:= machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      // assert (!cache_entry.Dirty); 
      out_msg.MessageSize := MessageSizeType:Writeback_Data;

      DPRINTF(RubySlicc, "g_issuePUTSData_fromTBE %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }

  action(j_sendUnblock, "j", desc="send unblock to the L2 cache") {
    enqueue(unblockNetwork_out, ResponseMsg, bypass_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:UNBLOCK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Response_Control;
      DPRINTF(RubySlicc, "%#x\n", address);
    }
  }

  action(jj_sendExclusiveUnblock, "\j", desc="send unblock to the L2 cache") {
    enqueue(unblockNetwork_out, ResponseMsg, bypass_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:EXCLUSIVE_UNBLOCK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Response_Control;
      DPRINTF(RubySlicc, "%#x\n", address);

    }
  }
  action(jjd_sendExclusiveUnblockData, "\jd", desc="send unblock and data to the L2 cache") {
    enqueue(unblockNetwork_out, ResponseMsg, bypass_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:EXCLUSIVE_UNBLOCK_DATA;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Response_Data;
      DPRINTF(RubySlicc, "%#x\n", address);

    }
  }

  action(h_load_hit, "hd",
         desc="Notify sequencer the load completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    L1Dcache.setMRU(cache_entry);
    sequencer.readCallback(address, cache_entry.DataBlk, false, machineIDToMachineType(machineID)); // L1 hit
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }

  action(h_ifetch_hit, "hi", desc="Notify sequencer the instruction fetch completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    L1Icache.setMRU(cache_entry);
    sequencer.readCallback(address, cache_entry.DataBlk, false, machineIDToMachineType(machineID)); // L1 hit
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }

  action(hx_load_hit_dynamic, "hxdynamic", desc="Notify sequencer the load completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    peek(responseL1Network_in, ResponseMsg) {
      if (in_msg.l2_hit_miss_path == L2HitMissPath:MISS) {
        sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:Memory); // L1 read miss serviced by mem
      } else {
        sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECT); // L1 read miss serviced by l2
      }
    }
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }
  // action(hx_load_hit, "hx", desc="Notify sequencer the load completed;l2 is the responder")
  // {
  //   assert(is_valid(cache_entry));
  //   DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
  //   // Request misses and new replacement policy info is set for new entry.
  //   // No need to setMRU on external hit.
  //   sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache); // L1 miss
  //   DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  // }

  ////////////////////////// l2 serviced load miss //////////////////////////
  action(hx_load_hit_l2resp, "hxl2", desc="Notify sequencer the load completed;l2 is the responder")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECT); // L1 miss
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }
  action(hx_load_hit_l2resp_fwde, "hxl2fe", desc="Notify sequencer the load completed;l2 is the responder; fwd-E")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:FWDE); // L1 miss
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (FWD-E)\n", cache_entry.DataBlk);
  }
  action(hx_load_hit_l2resp_pb, "hxl2pb", desc="Notify sequencer the load completed;l2 is the responder; pb")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:PB); // L1 miss
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (PB)\n", cache_entry.DataBlk);
  }
  action(hx_load_hit_l2resp_fwda, "hxl2fa", desc="Notify sequencer the load completed;l2 is the responder; fwd-A")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:FWDA); // L1 miss
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (FWD-A)\n", cache_entry.DataBlk);
  }
  action(hx_load_hit_l2resp_fwdb, "hxl2fb", desc="Notify sequencer the load completed;l2 is the responder; fwd-B")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:FWDB); // L1 miss
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (FWD-B)\n", cache_entry.DataBlk);
  }
  //////////////////////////////////////////////////////////////////////////////

  action(hx_load_hit_memresp, "hxmem", desc="Notify sequencer the load completed; mem is the responder")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:Memory); // L1 miss
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }

  action(hh_store_hit, "\h", desc="Notify sequencer that store completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    L1Dcache.setMRU(cache_entry);
    sequencer.writeCallback(address, cache_entry.DataBlk, false, machineIDToMachineType(machineID)); // L1 hit
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }

  action(hhx_store_hit_dynamic, "\hxdynamic", desc="Notify sequencer that store completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    peek(responseL1Network_in, ResponseMsg) {
      if (in_msg.l2_hit_miss_path == L2HitMissPath:MISS) {
        sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:Memory); // L1 miss TODO: change to either L2Cache or Memory
      } else {
        sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECT); // L1 miss TODO: change to either L2Cache or Memory
      }
    }
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  // action(hhx_store_hit, "\hx", desc="Notify sequencer that store completed; l2 is the responder")
  // {
  //   assert(is_valid(cache_entry));
  //   DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
  //   // Request misses and new replacement policy info is set for new entry.
  //   // No need to setMRU on external hit.
  //   sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache);
  //   cache_entry.Dirty := true;
  //   DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  //   DPRINTF(RubySlicc, "%llx dirty set\n", address);
  // }


  ////////////////////////// l2 serviced store miss //////////////////////////
  action(hhx_store_hit_l2resp, "\hxl2", desc="Notify sequencer that store completed; l2 is the responder")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECT);
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  action(hhx_store_hit_l2resp_pb, "\hxl2pb", desc="Notify sequencer that store completed; l2 is the responder; PB")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:PB);
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (PB)\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  action(hhx_store_hit_l2resp_fwda, "\hxl2fa", desc="Notify sequencer that store completed; l2 is the responder; FWD-A")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:FWDA);
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (FWD-A)\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  action(hhx_store_hit_l2resp_fwdb, "\hxl2fb", desc="Notify sequencer that store completed; l2 is the responder; FWD-B")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:FWDB);
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (FWD-B)\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  action(hhx_store_hit_l2resp_coh, "\hxl2co", desc="Notify sequencer that store completed; l2 is the responder; COHERENCE")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:COHERENCE);
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (COHERENCE)\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  //////////////////////////////////////////////////////////////////////////////

  action(hhx_store_hit_memresp, "\hxmem", desc="Notify sequencer that store completed; memory is the responder")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:Memory);
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }

  action(i_allocateTBE, "i", desc="Allocate TBE (isPrefetch=0, number of invalidates=0)") {
    check_allocate(TBEs);
    assert(is_valid(cache_entry));
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    tbe.isPrefetch := false;
    tbe.Dirty := cache_entry.Dirty;
    DPRINTF(RubySlicc, "%llx dirty set in tbe\n", address);
    tbe.DataBlk := cache_entry.DataBlk;
  }

  action(k_popMandatoryQueue, "k", desc="Pop mandatory queue.") {
    mandatoryQueue_in.dequeue(clockEdge());
  }

  action(l_popRequestQueue, "l",
    desc="Pop incoming request queue and profile the delay within this virtual network") {
    Tick delay := requestL1Network_in.dequeue(clockEdge());
    profileMsgDelay(2, ticksToCycles(delay));
  }

  action(o_popIncomingResponseQueue, "o",
    desc="Pop Incoming Response queue and profile the delay within this virtual network") {
    Tick delay := responseL1Network_in.dequeue(clockEdge());
    profileMsgDelay(1, ticksToCycles(delay));
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE") {
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(u_writeDataToL1Cache, "u", desc="Write data to cache") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk := in_msg.DataBlk;
      cache_entry.Dirty := in_msg.Dirty;
      DPRINTF(RubySlicc, "%llx dirty to (%d) in cache from in_msg\n", address, in_msg.Dirty);
    }
  }
  action(u_writeDataToL1Cache_PB, "uPB", desc="Write data to cache") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      // assert(is_valid(getCacheEntry(in_msg.piggybacked_addr))); // tbe should be valid
      // DataBlock pb := getDataBlock(in_msg.piggybacked_addr);
      // DPRINTF(RubySlicc, "read pb block (0x%llx) %s\n", in_msg.piggybacked_addr, pb);
      // DPRINTF(RubySlicc, "xorer: %s\n", in_msg.DataBlk);
      // DataBlock dataBlk := dataProcL1.preprocess(pb, in_msg.DataBlk);
      // DPRINTF(RubySlicc, "after xor: %s\n", dataBlk);
      cache_entry.DataBlk := in_msg.DataBlk;
      cache_entry.Dirty := in_msg.Dirty;
      DPRINTF(RubySlicc, "%llx dirty to (%d) in cache from in_msg\n", address, in_msg.Dirty);
    }
  }

  action(q_updateAckCount, "q", desc="Update ack count") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.pendingAcks := tbe.pendingAcks - in_msg.AckCount;
      APPEND_TRANSITION_COMMENT(in_msg.AckCount);
      APPEND_TRANSITION_COMMENT(" p: ");
      APPEND_TRANSITION_COMMENT(tbe.pendingAcks);
    }
  }

  action(ff_deallocateL1CacheBlock, "\f", desc="Deallocate L1 cache block.  Sets the cache to not present, allowing a replacement in parallel with a fetch.") {
    if (L1Dcache.isTagPresent(address)) {
      L1Dcache.deallocate(address);
    } else {
      L1Icache.deallocate(address);
    }
    unset_cache_entry();
    APPEND_TRANSITION_COMMENT(" l1--");
  }

  action(oo_allocateL1DCacheBlock, "\o", desc="Set L1 D-cache tag equal to tag of block B.") {
    if (is_invalid(cache_entry)) {
      set_cache_entry(L1Dcache.allocate(address, new Entry));
    }
    APPEND_TRANSITION_COMMENT(" l1++");
  }

  action(pp_allocateL1ICacheBlock, "\p", desc="Set L1 I-cache tag equal to tag of block B.") {
    if (is_invalid(cache_entry)) {
      set_cache_entry(L1Icache.allocate(address, new Entry));
    }
    APPEND_TRANSITION_COMMENT(" l1++");
  }

  action(z_stallAndWaitMandatoryQueue, "\z", desc="Stall and wait the L1 mandatory request queue") {
    stall_and_wait(mandatoryQueue_in, address);
  }

  action(z_stallAndWaitOptionalQueue, "\pz", desc="Stall and wait the L1 prefetch request queue") {
    stall_and_wait(optionalQueue_in, address);
  }

  action(z_stallAndWaitRequestQueue, "\zr", desc="Stall and wait the L1 request queue") {
    stall_and_wait(requestL1Network_in, address);
  }

  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpBuffers(address);
  }

  action(uu_profileInstMiss, "\uim", desc="Profile the demand miss") {
    L1Icache.profileDemandMiss();
  }

  action(uu_profileInstHit, "\uih", desc="Profile the demand hit") {
    L1Icache.profileDemandHit();
  }

  action(uu_profileDataMiss, "\udm", desc="Profile the demand miss") {
    L1Dcache.profileDemandMiss();
  }

  action(uu_profileDataHit, "\udh", desc="Profile the demand hit") {
    L1Dcache.profileDemandHit();
  }

  action(po_observeHit, "\ph", desc="Inform the prefetcher about the hit") {
      peek(mandatoryQueue_in, RubyRequest) {
          if (cache_entry.isPrefetch) {
              prefetcher.observePfHit(in_msg.LineAddress);
              cache_entry.isPrefetch := false;
          }
      }
  }

  action(po_observeMiss, "\po", desc="Inform the prefetcher about the miss") {
      peek(mandatoryQueue_in, RubyRequest) {
          if (enable_prefetch) {
              prefetcher.observeMiss(in_msg.LineAddress, in_msg.Type);
          }
      }
  }

  action(ppm_observePfMiss, "\ppm",
         desc="Inform the prefetcher about the partial miss") {
      peek(mandatoryQueue_in, RubyRequest) {
          prefetcher.observePfMiss(in_msg.LineAddress);
      }
  }

  action(pq_popPrefetchQueue, "\pq", desc="Pop the prefetch request queue") {
      optionalQueue_in.dequeue(clockEdge());
  }

  action(mp_markPrefetched, "mp", desc="Set the isPrefetch flag") {
      assert(is_valid(cache_entry));
      cache_entry.isPrefetch := true;
  }


  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  // Transitions for Load/Store/Replacement/WriteBack from transient states
  transition({IS, IM, IS_I, M_I, SM, SM_sd, SM_acks, SM_pb, SINK_WB_ACK}, {Load, Ifetch, Store, L1_Replacement}) {
    z_stallAndWaitMandatoryQueue;
  }

  // Transitions from Idle
  transition({NP,I}, {L1_Replacement}) {
    ff_deallocateL1CacheBlock;
  }

  transition({NP,I}, Load, IS) {
    oo_allocateL1DCacheBlock;
    i_allocateTBE;
    a_issueGETS;
    uu_profileDataMiss;
    po_observeMiss;
    k_popMandatoryQueue;
  }

  transition({NP,I}, Ifetch, IS) {
    pp_allocateL1ICacheBlock;
    i_allocateTBE;
    ai_issueGETINSTR;
    uu_profileInstMiss;
    po_observeMiss;
    k_popMandatoryQueue;
  }

  

  transition({NP,I}, Store, IM) {
    oo_allocateL1DCacheBlock;
    i_allocateTBE;
    b_issueGETX;
    uu_profileDataMiss;
    po_observeMiss;
    k_popMandatoryQueue;
  }

  

  transition({NP, I}, Inv) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  // Transitions from Shared
  transition({S,M}, Load) {
    h_load_hit;
    uu_profileDataHit;
    po_observeHit;
    k_popMandatoryQueue;
  }

  transition({S,M}, Ifetch) {
    h_ifetch_hit;
    uu_profileInstHit;
    po_observeHit;
    k_popMandatoryQueue;
  }

  transition(S, Store, SM) {
    i_allocateTBE;
    c_issueUPGRADE;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition(S, {L1_Replacement}, SINK_WB_ACK) {
    forward_eviction_to_cpu;
    i_allocateTBE;
    g_issuePUTS;
    ff_deallocateL1CacheBlock;
  }

  transition(S, Inv, I) {
    forward_eviction_to_cpu;
    fi_sendInvAck;
    l_popRequestQueue;
  }
  transition(S, InvData, I) {
    forward_eviction_to_cpu;
    fi_sendInvAckData;
    l_popRequestQueue;
  }
  transition(IS, InvData) {
    z_stallAndWaitRequestQueue;
  }
  transition(SM, InvData, IM) {
    forward_eviction_to_cpu;
    fi_sendInvAckData;
    l_popRequestQueue;
  }

  transition(S, InvGETX, I) {
    forward_eviction_to_cpu;
    // fi_sendInvAck;
    dsa_sendDataSToRequestor_with1Ack;
    l_popRequestQueue;
  }
  transition(SM, InvGETX, IM) {
    forward_eviction_to_cpu;
    dsa_sendDataSToRequestor_with1Ack;
    // fi_sendInvAck;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, InvGETX) {
    // fi_sendInvAck;
    dsat_sendDataSToRequestor_with1Ack_fromTBE;
    l_popRequestQueue;
  }
  transition(IS, InvGETX) {
    z_stallAndWaitRequestQueue;
  }

  transition(S, Recover) {
    ri_sendRecoverData;
    l_popRequestQueue;
  }
  transition(SM, Recover) {
    ri_sendRecoverData;
    l_popRequestQueue;
  }

  transition(S, RecoverSUB) {
    ri_sendRecoverData;
    j_sendUnblock;
    l_popRequestQueue;
  }
  transition(SM, RecoverSUB) {
    ri_sendRecoverData;
    j_sendUnblock;
    l_popRequestQueue;
  }
  transition(IS, Recover) {
    z_stallAndWaitRequestQueue;
  }
  
  transition(IS, ReconstructX) {
    z_stallAndWaitRequestQueue;
  }
  transition(S, ReconstructX) {
    rcix_sendReconstructDataX;
    rillc_sendRecoverData_toL2;
    l_popRequestQueue;
  }
  transition(SM, ReconstructX) {
    rcix_sendReconstructDataX;
    rillc_sendRecoverData_toL2;
    l_popRequestQueue;
  }
  transition(S, ReconstructS) {
    rcis_sendReconstructDataS;
    j_sendUnblock;
    l_popRequestQueue;
  }
  transition(SM, ReconstructS) {
    rcis_sendReconstructDataS;
    j_sendUnblock;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, ReconstructS) {
    rcist_sendReconstructDataS_fromTBE;
    j_sendUnblock;
    l_popRequestQueue;
  }
  transition(IS, ReconstructS) {
    z_stallAndWaitRequestQueue;
  }

  transition(S, {Fwd_GETS, Fwd_GET_INSTR}) {
    ds_sendDataSToRequestor;
    j_sendUnblock;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, {Fwd_GETS, Fwd_GET_INSTR}) {
    dst_sendDataSToRequestor_fromTBE;
    j_sendUnblock;
    l_popRequestQueue;
  }
  transition(IS, {Fwd_GETS, Fwd_GET_INSTR}) {
    z_stallAndWaitRequestQueue;
  }
  transition(SM, {Fwd_GETS, Fwd_GET_INSTR}) {
    ds_sendDataSToRequestor;
    j_sendUnblock;
    l_popRequestQueue;
  }

  // Transitions from Exclusive

  transition({M}, Store, M) {
    hh_store_hit;
    uu_profileDataHit;
    po_observeHit;
    k_popMandatoryQueue;
  }

  // transition(E, {L1_Replacement, PF_L1_Replacement}, M_I) {
  //   // silent E replacement??
  //   forward_eviction_to_cpu;
  //   i_allocateTBE;
  //   g_issuePUTX;   // send data, but hold in case forwarded request
  //   ff_deallocateL1CacheBlock;
  // }

  // transition(E, Inv, I) {
  //   // don't send data
  //   forward_eviction_to_cpu;
  //   fi_sendInvAck;
  //   l_popRequestQueue;
  // }

  // transition(E, Fwd_GETX, I) {
  //   forward_eviction_to_cpu;
  //   d_sendDataToRequestor;
  //   l_popRequestQueue;
  // }

  // transition(E, {Fwd_GETS, Fwd_GET_INSTR}, S) {
  //   d_sendDataToRequestor;
  //   d2_sendDataToL2;
  //   l_popRequestQueue;
  // }

  // Transitions from Modified

  transition(M, {L1_Replacement}, M_I) {
    forward_eviction_to_cpu;
    i_allocateTBE;
    g_issuePUTX;   // send data, but hold in case forwarded request
    ff_deallocateL1CacheBlock;
  }
  
  transition(M_I, WB_Ack, I) {
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(M, Inv, I) {
    forward_eviction_to_cpu;
    f_sendDataToL2;
    l_popRequestQueue;
  }

  transition(M_I, Inv, SINK_WB_ACK) {
    ft_sendDataToL2_fromTBE;
    l_popRequestQueue;
  }

  transition(M, Fwd_GETX, I) {
    forward_eviction_to_cpu;
    d_sendDataToRequestor;
    l_popRequestQueue;
  }

  transition(M, {Fwd_GETS, Fwd_GET_INSTR}, S) {
    d_sendDataToRequestor;
    d2_sendDataToL2;
    l_popRequestQueue;
  }

  transition(M_I, Fwd_GETX, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    l_popRequestQueue;
  }

  transition(M_I, {Fwd_GETS, Fwd_GET_INSTR}, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    d2t_sendDataToL2_fromTBE;
    l_popRequestQueue;
  }

  //Transitions from IS
  transition({IS, IS_I}, Inv, IS_I) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  // transition({IS}, Inv) {
  //   z_stallAndWaitRequestQueue;
  // }

  transition(IS, Data_all_Acks, S) {
    u_writeDataToL1Cache;
    hx_load_hit_dynamic;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS, DataPB_all_Acks, S) {
    u_writeDataToL1Cache_PB;
    hx_load_hit_l2resp_pb; //PB
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataPB_all_Acks, I) {
    u_writeDataToL1Cache_PB;
    hx_load_hit_l2resp_pb; //PB
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS_I, Data_all_Acks, I) {
    u_writeDataToL1Cache;
    hx_load_hit_dynamic;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS, DataS_fromL1E, S) {
    u_writeDataToL1Cache;
    j_sendUnblock;
    hx_load_hit_l2resp; //direct
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS, DataS_fromL1S, S) {
    u_writeDataToL1Cache;
    hx_load_hit_l2resp_fwda; //FWD-A
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataS_fromL1S, I) {
    u_writeDataToL1Cache;
    hx_load_hit_l2resp_fwda; //FWD-A
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS, DataReconstructS, S) {
    u_writeDataToL1Cache;
    // j_sendUnblock;
    hx_load_hit_l2resp_fwdb; //FWD-B
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataReconstructS, I) {
    u_writeDataToL1Cache;
    // j_sendUnblock;
    hx_load_hit_l2resp_fwdb; //FWD-B
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }


  transition(IS_I, DataS_fromL1E, I) {
    u_writeDataToL1Cache;
    j_sendUnblock;
    hx_load_hit_l2resp; //direct
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  // directory is blocked when sending exclusive data
  // transition(IS_I, Data_Exclusive, E) {
  //   u_writeDataToL1Cache;
  //   hx_load_hit;
  //   jj_sendExclusiveUnblock;
  //   s_deallocateTBE;
  //   o_popIncomingResponseQueue;
  //   kd_wakeUpDependents;
  // }

  // transition(IS, Data_Exclusive, E) {
  //   u_writeDataToL1Cache;
  //   hx_load_hit;
  //   jj_sendExclusiveUnblock;
  //   s_deallocateTBE;
  //   o_popIncomingResponseQueue;
  //   kd_wakeUpDependents;
  // }

  // transition(PF_IS, Data_Exclusive, E) {
  //   u_writeDataToL1Cache;
  //   jj_sendExclusiveUnblock;
  //   s_deallocateTBE;
  //   mp_markPrefetched;
  //   o_popIncomingResponseQueue;
  //   kd_wakeUpDependents;
  // }

  // Transitions from IM
  transition(IM, Inv, IM) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition(IM, Data, SM) {
    u_writeDataToL1Cache;
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }
  transition(IM, DataReconstructX, SM) {
    u_writeDataToL1Cache;
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }
  transition(IM, DataS_fromL1S, SM_sd) {
    u_writeDataToL1Cache;
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }
  transition(IM, DataPB, SM_pb) {
    u_writeDataToL1Cache_PB;
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }
  

  transition(IM, Data_all_Acks, M) {
    u_writeDataToL1Cache;
    hhx_store_hit_dynamic; // direct
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IM, DataReconstructX_all_acks, M) {
    u_writeDataToL1Cache;
    hhx_store_hit_l2resp_fwdb; //FWD-B
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IM, DataPB_all_Acks, M) {
    u_writeDataToL1Cache_PB;
    jjd_sendExclusiveUnblockData;
    hhx_store_hit_l2resp_pb; //PB
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IM, DataS_fromL1S_all_acks, M) {
    u_writeDataToL1Cache;
    jjd_sendExclusiveUnblockData;
    hhx_store_hit_l2resp_fwda; //FWD-A
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  // transitions from SM
  transition({SM}, Inv, IM) {
    forward_eviction_to_cpu;
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition({SM, IM, SM_pb, SM_sd, SM_acks}, Ack) {
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }

  transition(SM, Ack_all, M) {
    jj_sendExclusiveUnblock;
    hhx_store_hit_dynamic; // direct
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(SM_pb, Ack_all, M) {
    jjd_sendExclusiveUnblockData;
    hhx_store_hit_l2resp_pb; //PB
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(SM_sd, Ack_all, M) {
    jjd_sendExclusiveUnblockData;
    hhx_store_hit_l2resp_fwda; //fwd-A
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(SM, AckS, SM_acks) {
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }
  transition(SM, AckS_all, M) {
    jjd_sendExclusiveUnblockData;
    hhx_store_hit_l2resp_fwda; //fwd-A?
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(SM_acks, Ack_all, M) {
    jjd_sendExclusiveUnblockData;
    hhx_store_hit_l2resp_fwda; //fwd-A?
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(SINK_WB_ACK, Inv){
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition(SINK_WB_ACK, InvData) {
    fi_sendInvAckData_fromTBE;
    l_popRequestQueue;
  }

  transition(SINK_WB_ACK, WB_Ack, I){
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(SINK_WB_ACK, WB_Nack){ 
    g_issuePUTSData_fromTBE;
    o_popIncomingResponseQueue;
  }
  transition(SINK_WB_ACK, Recover) {
    rit_sendRecoverData_fromTBE;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, ReconstructX) {
    rcixt_sendReconstructDataX_fromTBE;
    rillct_sendRecoverData_toL2_fromTBE;
    l_popRequestQueue;
  }
}
