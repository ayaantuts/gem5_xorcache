  action(rcix_sendReconstructDataX, "rcix", desc="send reconstruct data to requestor") {
    peek(requestL1Network_in, RequestMsg) {
      DataBlock newData := dataProcL1.preprocess(cache_entry.DataBlk, in_msg.DataBlk_phy);
      enqueue(responseL1Network_out, ResponseMsg, bypass_latency) {
        out_msg.addr := in_msg.piggybacked_addr;
        out_msg.Type := CoherenceResponseType:RECONSTRUCTDATAX;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := in_msg.AckCount_communicate;
        out_msg.DataBlk := newData;
        out_msg.Dirty := false;
        DPRINTF(RubySlicc, "sending RECONSTRUCTX DATA to %s, data=%s\n",out_msg.Destination, out_msg.DataBlk);
      }
    }
  }
