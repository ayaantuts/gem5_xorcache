    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }

// %%%%%%%%%%%%%%%%%%%%%% internal %%%%%%%%%%%%%%%%%%%%%%
  // SS_SS_UB1
  transition(SS_SS_UB1, {L1_GETS_pb, L1_GET_INSTR_pb}) {
    ds1pb2_sendSharedDataToRequestor_piggyback2; 

    nn_addSharer;

    set_tagMRU;
    set_dataMRU;
    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  transition(SS_SS_UB1, {L1_GETS2_pb, L1_GET_INSTR2_pb}) {
    ds2pb1_sendSharedData2ToRequestor_piggyback1; 
    
    nns_addSecondarySharer;

    set_tagMRU;
    set1_dataMRU;
    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  
  transition(SS_SS_UB1, L1_PUTS_not_last) {
