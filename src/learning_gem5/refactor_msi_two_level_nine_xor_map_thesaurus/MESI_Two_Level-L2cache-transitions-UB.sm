// %%%%%%%%%%%%%%%%%% continue in UB %%%%%%%%%%%%%%%%%%
  // UB1
  transition(SS_SS_UB1, {L1_GETS_fwd, L1_GET_INSTR_fwd}) {
    ipu_incrementPendingUBs;
    bb1_recordBlockedSharer;
    bf1_forwardRequestToSharer;

    nn_addSharer;

    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SS_L2ONLY_UB1, {L1_GETS_fwd, L1_GET_INSTR_fwd}) {
    ipu_incrementPendingUBs;
    bb1_recordBlockedSharer;
    bf1_forwardRequestToSharer;

    nn_addSharer;

    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  // UB2
  transition(SS_SS_UB2, {L1_GETS2_fwd, L1_GET_INSTR2_fwd}) {
    ipu_incrementPendingUBs;
    bb2_recordBlockedSharer;
    bf2_forwardRequestToSharer;

    nns_addSecondarySharer;

    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SS_SS_UB2, {L1_GETS_recon, L1_GET_INSTR_recon}) {
    set_secondary_as_tbe;
    ipu_incrementPendingUBs;
    bb2_recordBlockedSharer;
    srs2_sendReconstructSToSharer2;
    nn_addSharer;
    
    aadir_allocateDir;

    set_tagMRU;
    set_dataMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  
  transition(L2ONLY_SS_UB2, {L1_GETS2_fwd, L1_GET_INSTR2_fwd}) {
    ipu_incrementPendingUBs;
    bb2_recordBlockedSharer;
    bf2_forwardRequestToSharer;

    nns_addSecondarySharer;

    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(L2ONLY_SS_UB2, {L1_GETS_recon, L1_GET_INSTR_recon}, SS_SS_UB2) {
    set_secondary_as_tbe;
    ipu_incrementPendingUBs;
    bb2_recordBlockedSharer;
    srs2_sendReconstructSToSharer2;
    nn_addSharer;
    ddtns_deallocateTagNS;

    l2set2_ssssub2;
    l2set1_ssssub2;
    
    aadir_allocateDir;

    set_tagMRU;
    set_dataMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }


  // UB12
  transition(SS_SS_UB12, {L1_GETS2_fwd, L1_GET_INSTR2_fwd}) {
    set_secondary_as_tbe;
