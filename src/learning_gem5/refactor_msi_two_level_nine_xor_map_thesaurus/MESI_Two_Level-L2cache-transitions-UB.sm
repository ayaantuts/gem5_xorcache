  transition(SS_SS_UB12, {L1_UPGRADE2, L1_GETX2_pb, L1_GETX2_fwd,
    L1_UPGRADE, L1_GETX_pb, L1_GETX_fwd}) {
    zz_stallAndWaitL1RequestQueue;
  }

  // PUTS


  // PUTX
  transition({SS_SS_UB1, SS_L2ONLY_UB1}, L1_PUTX_not_last) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition(SS_SS_UB2, L1_PUTX_not_last2) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({SS_SS_UB2}, L1_PUTX_not_last) {
    l_removeSharer;
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
