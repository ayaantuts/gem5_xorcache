    dddir_deallocateDir;
    aatns_allocateTagNS;
    ll_clearSharers;
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  
  // SS_L2ONLY_UB1
  transition(SS_L2ONLY_UB1, {L1_GETS2_pb, L1_GET_INSTR2_pb}, SS_SS_UB1) {
    ds2pb1_sendSharedData2ToRequestor_piggyback1; 

    aadir2_allocateDir;
    nns_addSecondarySharer;
    ddtns2_deallocateTagNS;

    l2set1_ssssub1;
    l2set2_ssssub1;

    set_tagMRU;
    set1_dataMRU;
    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  transition(SS_L2ONLY_UB1, {L1_GET_INSTR2_recon, L1_GETS2_recon}, SS_SS_UB1) {
    set_primary_as_tbe;
    ipu_incrementPendingUBs;
    bb1_recordBlockedSharer;
    srs1_sendReconstructSToSharer;
    nns_addSecondarySharer;
    ddtns2_deallocateTagNS;

    l2set1_ssssub1;
    l2set2_ssssub1;

    aadir_allocateDir;

    set_tagMRU;
    set_dataMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }

  transition(SS_L2ONLY_UB1, L1_PUTS_not_last) {
    l_removeSharer;
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  
  // L2ONLY_SS_UB2
