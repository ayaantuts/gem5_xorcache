// %%%%%%%%%%%%%%%%%%%%%% outof XOR %%%%%%%%%%%%%%%%%%%%%% 
// %%%%%%%%%%%%%%%%%%%%%% stalling %%%%%%%%%%%%%%%%%%%%%%
  // puts blocked
  transition({SS_SS_UB1, SS_L2ONLY_UB1, L2ONLY_SS_UB1, SS_SS_UB12}, L1_PUTS_blocked) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({SS_SS_UB2, SS_L2ONLY_UB2, L2ONLY_SS_UB2, SS_SS_UB12}, L1_PUTS_blocked2) {
    zz_stallAndWaitL1RequestQueue;
  }
  // repl
  transition({SS_SS_UB1, SS_L2ONLY_UB1, L2ONLY_SS_UB1, 
    SS_SS_UB2, SS_L2ONLY_UB2, L2ONLY_SS_UB2, 
    SS_SS_UB12}, 
    {L2_Replacement, L2_Replacement_clean, 
    L2_Replacement2, L2_Replacement_clean2, 
    L2_Replacement_data_dirty_dirty, L2_Replacement_data_clean_clean,
    L2_Replacement_data_clean_dirty, L2_Replacement_data_dirty_clean}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({SS_SS_UB1, SS_L2ONLY_UB1, L2ONLY_SS_UB1, 
    SS_SS_UB2, SS_L2ONLY_UB2, L2ONLY_SS_UB2, 
    SS_SS_UB12}, 
    {MEM_Inv, MEM_Inv2}) {
    zn_recycleResponseNetwork;
  }

  // get-UB1
  transition(SS_SS_UB1, {L1_UPGRADE, L1_GETX_pb, L1_GETX_fwd,
    L1_UPGRADE2, L1_GETX2_pb, L1_GETX2_fwd}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition(SS_L2ONLY_UB1, {L1_GETX_fwd, L1_UPGRADE, 
    L1_GETX2_pb, L1_GETX2_recon}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition(L2ONLY_SS_UB1, {L1_UPGRADE, L1_GETX_recon, L1_GETX_pb
    L1_UPGRADE2, L1_GETX2_fwd}) {
    zz_stallAndWaitL1RequestQueue;
  }
  // get-UB2
  transition(SS_SS_UB2, {L1_UPGRADE2, L1_GETX2_pb, L1_GETX2_fwd,
    L1_UPGRADE, L1_GETX_pb, L1_GETX_fwd}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition(L2ONLY_SS_UB2, {L1_GETX_recon, L1_GETX_pb,
    L1_UPGRADE2, L1_GETX2_fwd}) {
