    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(SS_SS_UB1, L1_PUTS_last, L2ONLY_SS_UB1) {
    l2set2_l2onlyssub1;
    dddir_deallocateDir;
    aatns_allocateTagNS;
    ll_clearSharers;
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(SS_SS_UB1, L1_PUTS_last2, SS_L2ONLY_UB1) {
    l2set1_ssl2onlyub1;
    dddir_deallocateDir;
    aatns_allocateTagNS;
    lls_clearSecondarySharers;
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  
  // SS_SS_UB2
  transition(SS_SS_UB2, {L1_GETS2_pb, L1_GET_INSTR2_pb}) {
