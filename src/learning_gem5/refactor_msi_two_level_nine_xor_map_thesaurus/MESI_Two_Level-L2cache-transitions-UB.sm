    uur_profileDirRead;
  }


// %%%%%%%%%%%%%%%%%% cross in UB %%%%%%%%%%%%%%%%%%
  transition(SS_SS_UB1, {L1_GETS2_fwd, L1_GET_INSTR2_fwd}, SS_SS_UB12) {
    i2_allocateTBE;
    set_secondary_as_tbe;
    ipu_incrementPendingUBs;
    bb2_recordBlockedSharer;
    bf2_forwardRequestToSharer;

    l2set1_ssssub12;

    nns_addSecondarySharer;

    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SS_SS_UB2, {L1_GETS_fwd, L1_GET_INSTR_fwd}, SS_SS_UB12) {
    i_allocateTBE;
    ipu_incrementPendingUBs;
    bb1_recordBlockedSharer;
    bf1_forwardRequestToSharer;

    l2set2_ssssub12;

    nn_addSharer;

    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }

// %%%%%%%%%%%%%%%%%% back to duo-stable %%%%%%%%%%%%%%%%%%
  // UB1
  transition(SS_SS_UB1, Unblock_not_all) {
    br_removeBlockedSharer;
    dpu_decrementPendingUBs;
    k_popUnblockQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(SS_SS_UB1, Unblock, SS_SS) {
    s_deallocateTBE;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  
  transition(SS_L2ONLY_UB1, Unblock_not_all) {
    br_removeBlockedSharer;
    dpu_decrementPendingUBs;
    k_popUnblockQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(SS_L2ONLY_UB1, Unblock, SS_L2ONLY) {
    s_deallocateTBE;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }

  // UB2
