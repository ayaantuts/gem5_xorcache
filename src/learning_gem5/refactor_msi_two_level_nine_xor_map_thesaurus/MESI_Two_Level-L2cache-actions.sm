  action(l2set1_mi, "l2s11", desc="set primary cache entry state to M_I") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    setState(TBEs[primary_addr], getCacheEntry(primary_addr), primary_addr, State:M_I);
    DPRINTF(RubySlicc, "set L2 primary_addr: 0x%llx to M_I\n", primary_addr);
  }
  action(l2set1_ss, "l2s12", desc="set primary cache entry state to SS") {
