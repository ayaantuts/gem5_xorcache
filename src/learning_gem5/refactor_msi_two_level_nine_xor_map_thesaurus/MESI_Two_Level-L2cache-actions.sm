//////////////////////// allocate/deallocate ST & STS //////////////////////////
  action(ddststs1_deallocateSTSTS, "ddststs1", desc="Deallocate singular tag and singular tag shared") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    singularTag.deallocate(primary_addr);
    DPRINTF(RubySlicc, "Deallocated singular tag for address 0x%llx\n", primary_addr);
    singularTagShared.deallocate(primary_addr);
    DPRINTF(RubySlicc, "Deallocated singular tag shared for address 0x%llx\n", primary_addr);
    APPEND_TRANSITION_COMMENT(" st-- sts--(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
  action(ddst1_deallocateST, "ddst1", desc="Deallocate singular tag") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubySlicc, "Deallocating singular tag for address 0x%llx\n", primary_addr);
    singularTag.deallocate(primary_addr);
    APPEND_TRANSITION_COMMENT(" st--(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
  action(ddsts1_deallocateSTS, "ddsts1", desc="Deallocate singular tag shared") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubySlicc, "Deallocating singular tag shared for address 0x%llx\n", primary_addr);
    singularTagShared.deallocate(primary_addr);
    APPEND_TRANSITION_COMMENT(" sts--(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }

  action(ddststs_deallocateSTSTS, "ddststs", desc="Deallocate singular tag and singular tag shared") {
    singularTag.deallocate(address);
    DPRINTF(RubySlicc, "Deallocated singular tag for address 0x%llx\n", address);
    singularTagShared.deallocate(address);
    DPRINTF(RubySlicc, "Deallocated singular tag shared for address 0x%llx\n", address);
    APPEND_TRANSITION_COMMENT(" st-- sts--");
  }

  action(aast1_allocateSingularTag_primary, "aast1", desc="allocate singular tag primary") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    singularTag.allocate(primary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" st++(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
  action(aast2_allocateSingularTag_secondary, "aast2", desc="allocate singular tag secondary") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    singularTag.allocate(secondary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" st++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }

  action(aaststs1_allocateSingularTagBoth_primary, "aaststs1", desc="allocate singular tag both secondary") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    singularTag.allocate(primary_addr, new Entry);
    singularTagShared.allocate(primary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" st++ sts++(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
  action(aaststs2_allocateSingularTagBoth_secondary, "aaststs2", desc="allocate singular tag both secondary") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    singularTag.allocate(secondary_addr, new Entry);
    singularTagShared.allocate(secondary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" st++ sts++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }

  action(aastp_allocateSingularTag_paired, "aastp", desc="allocate singular tag paired") {
    Addr paired_addr := tbe.paired;
    singularTag.allocate(paired_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" st++(");
    APPEND_TRANSITION_COMMENT(paired_addr);
    APPEND_TRANSITION_COMMENT(")");
    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:SS) {
      singularTagShared.allocate(paired_addr, new Entry);
      APPEND_TRANSITION_COMMENT(" sts++(");
      APPEND_TRANSITION_COMMENT(paired_addr);
      APPEND_TRANSITION_COMMENT(")");
    }
  }


