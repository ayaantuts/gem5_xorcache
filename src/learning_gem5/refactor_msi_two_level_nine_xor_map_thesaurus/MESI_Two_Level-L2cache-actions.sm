  action(dmtNS_insert_fromCache1, "dmtNS_ac1", desc="insert into nonshared using data in cache") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    dmtNShared.insert(primary_addr, getCacheEntry(primary_addr).DataBlk);
    
    APPEND_TRANSITION_COMMENT(" dmtNS++(");
