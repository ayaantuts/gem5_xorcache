//////////////////////// metadata //////////////////////////
  action(nns_addSecondarySharer, "\ns", desc="Add L1 sharer2 to list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      addSecondarySharer(address, in_msg.Requestor, cache_entry);
      APPEND_TRANSITION_COMMENT(" Sharers2: ");
      APPEND_TRANSITION_COMMENT( cache_entry.Sharers2 );
    }
  }
  action(nnus_addSecondarySharerFromUnblock, "\nus", desc="Add L1 sharer to list") {
    peek(L1unblockNetwork_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      addSecondarySharer(address, in_msg.Sender, cache_entry);
      APPEND_TRANSITION_COMMENT( cache_entry.Sharers2 );
    }
  }
  action(lls_clearSecondarySharers, "\ls", desc="Rm all L1 sharers2 from list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      cache_entry.Sharers2.clear();
      DPRINTF(RubySlicc, "sharers2 cleared for address: %#x\n", in_msg.addr);
      DPRINTF(RubySlicc, "sharers are %s\n", cache_entry.Sharers);
      DPRINTF(RubySlicc, "cache_entry.DataBlk:%s\n", cache_entry.DataBlk);
    }
  }
  action(l2_removeSecondarySharer, "l2", desc="Rm one sharer from list") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      removeSecondarySharer(address, in_msg.Requestor, cache_entry);
      APPEND_TRANSITION_COMMENT( cache_entry.Sharers2 );
    }
  }

  action(ipu_incrementPendingUBs, "ipu", desc="increment IUB counter") {
    assert(is_valid(tbe));
    tbe.pendingUBs := tbe.pendingUBs + 1;
    APPEND_TRANSITION_COMMENT(" pUB: ");
    APPEND_TRANSITION_COMMENT(tbe.pendingUBs);
  }
  action(dpu_decrementPendingUBs, "dpu", desc="decrement IUB counter") {
    assert(is_valid(tbe));
    tbe.pendingUBs := tbe.pendingUBs - 1;
    APPEND_TRANSITION_COMMENT(" pUB: ");
    APPEND_TRANSITION_COMMENT(tbe.pendingUBs);
  }

  action(bb1_recordBlockedSharer, "bb1", desc="Record blocked sharer") {
    assert(is_valid(tbe));
    tbe.blockedSharer.add(cache_entry.Sharers.newestElement());
    APPEND_TRANSITION_COMMENT(" blockedSharer: ");
    APPEND_TRANSITION_COMMENT(tbe.blockedSharer);
  }
  action(bb2_recordBlockedSharer, "bb2", desc="Record blocked sharer") {
    assert(is_valid(tbe));
    tbe.blockedSharer.add(cache_entry.Sharers2.newestElement());
    APPEND_TRANSITION_COMMENT(" blockedSharer: ");
    APPEND_TRANSITION_COMMENT(tbe.blockedSharer);
  }
  
  action(br_removeBlockedSharer, "br", desc="Remove blocked sharer") {
    peek(L1unblockNetwork_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.blockedSharer.remove(in_msg.Sender);
      APPEND_TRANSITION_COMMENT(" blockedSharer: ");
      APPEND_TRANSITION_COMMENT(tbe.blockedSharer);
    }
  }

