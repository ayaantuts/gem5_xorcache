//////////////////////// use in Recover (fwd-myself) case //////////////////////////
  action(bf1_forwardRequestToSharer, "fwd1", desc="Forward request to the sharer") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }
  action(bf2_forwardRequestToSharer, "fwd2", desc="Forward request to the sharer") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := in_msg.Type;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers2.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }


//////////////////////// use in Reconstruct (fwd-other) case //////////////////////////
  action(srs1_sendReconstructSToSharer, "srs1", desc="send ReconstructS to sharer along with physical data (logical data 2)") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, getMaxofTwo(dir.getDataLatency(), L2cache.getDataLatency())) {
        assert(is_valid(cache_entry));
        out_msg.addr := primary_addr;
        out_msg.piggybacked_addr := secondary_addr;
        out_msg.Type := CoherenceRequestType:RECONSTRUCTS;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control_Data;
        out_msg.DataBlk := cache_entry.DataBlk2;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;
        DPRINTF(RubySlicc, "send RECONSTRUCTS to %s\n", out_msg.Destination);
        DPRINTF(RubySlicc, "cache_entry.DataBlk2=%s, cache_entry.DataBlk_phy=%s\n", cache_entry.DataBlk2, cache_entry.DataBlk_phy);
      }
    }
  }
  action(srs2_sendReconstructSToSharer2, "srs2", desc="send ReconstructS to sharer2 along with physical data (logical data1)") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, getMaxofTwo(dir.getDataLatency(), L2cache.getDataLatency())) {
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.piggybacked_addr := primary_addr;
        out_msg.Type := CoherenceRequestType:RECONSTRUCTS;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers2.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control_Data;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;
        DPRINTF(RubySlicc, "send RECONSTRUCTS to %s\n",out_msg.Destination);
        DPRINTF(RubySlicc, "cache_entry.DataBlk=%s, cache_entry.DataBlk_phy=%s\n", cache_entry.DataBlk, cache_entry.DataBlk_phy);
      }
    }
  }

//////////////////////// use in Reconstruct (fwd-other) case on GETX //////////////////////////

  action(srx1_sendReconstructXToSharer, "srx1", desc="send Reconstruct to sharer") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, getMaxofTwo(dir.getDataLatency(), L2cache.getDataLatency())) {
        assert(is_valid(cache_entry));
        out_msg.addr := primary_addr;
        out_msg.piggybacked_addr := secondary_addr;
        out_msg.Type := CoherenceRequestType:RECONSTRUCTX;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control_Data;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;

        out_msg.AckCount_communicate := 0 - cache_entry.Sharers2.count();
        if (cache_entry.Sharers2.isElement(in_msg.Requestor)) {
          out_msg.AckCount_communicate := out_msg.AckCount_communicate + 1;
        }
        DPRINTF(RubySlicc, "send RECONSTRUCTX to %s, AckCount_communicate=%d, DataBlk_phy=%s\n", 
          out_msg.Destination, out_msg.AckCount_communicate, cache_entry.DataBlk_phy);
      }
    }
  }
  action(srx2_sendReconstructXToSharer2, "srx2", desc="send Reconstruct to sharer2") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, getMaxofTwo(dir.getDataLatency(), L2cache.getDataLatency())) {
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.piggybacked_addr := primary_addr;
        out_msg.Type := CoherenceRequestType:RECONSTRUCTX;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers2.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control_Data;
        out_msg.DataBlk := cache_entry.DataBlk2;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;

        out_msg.AckCount_communicate := 0 - cache_entry.Sharers.count();
        if (cache_entry.Sharers.isElement(in_msg.Requestor)) {
          out_msg.AckCount_communicate := out_msg.AckCount_communicate + 1;
        }
        DPRINTF(RubySlicc, "send RECONSTRUCTX to %s, AckCount_communicate=%d\n", 
          out_msg.Destination, out_msg.AckCount_communicate);
        DPRINTF(RubySlicc, "sharers2 are %s%d\n",cache_entry.Sharers2); 
      }
    }
  }


//////////////////////// use in Recover (fwd-myself) case ON GETX //////////////////////////
  action(fwr1_sendFwdReqInvToSharers, "fwr1", desc="invalidate sharers for request, requestor is sharer") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := primary_addr;
        out_msg.Type := CoherenceRequestType:GETX_INV;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;

        out_msg.AckCount_communicate := 0 - cache_entry.Sharers.count();
        if (cache_entry.Sharers.isElement(in_msg.Requestor)) {
          out_msg.AckCount_communicate := out_msg.AckCount_communicate + 1;
        }
        
        DPRINTF(RubySlicc, "send GETX_INV to %s, ackct=%d\n", out_msg.Destination, out_msg.AckCount_communicate);
      }
    }
  }
  action(fwmn1_sendFwdInvToSharersMinusNewest, "fwmn1", desc="invalidate sharers for request") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := primary_addr;
        out_msg.Type := CoherenceRequestType:INV;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination := cache_entry.Sharers;
        out_msg.Destination.remove(in_msg.Requestor);
        out_msg.Destination.remove(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;
        DPRINTF(RubySlicc, "send INV to %s\n", out_msg.Destination);
      }
    }
  }


  action(fwr2_sendFwdReqInvToSharers, "fwr2", desc="invalidate sharers for request, requestor is sharer") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.Type := CoherenceRequestType:GETX_INV;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers2.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;

        out_msg.AckCount_communicate := 0 - cache_entry.Sharers2.count();
        if (cache_entry.Sharers2.isElement(in_msg.Requestor)) {
          out_msg.AckCount_communicate := out_msg.AckCount_communicate + 1;
        }
        
        DPRINTF(RubySlicc, "send GETX_INV to %s, ackct=%d\n", out_msg.Destination, out_msg.AckCount_communicate);
      }
    }
  }
  action(fwmn2_sendFwdInvToSharersMinusNewest, "fwmn2", desc="invalidate sharers for request") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.Type := CoherenceRequestType:INV;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination := cache_entry.Sharers2;
        out_msg.Destination.remove(in_msg.Requestor);
        out_msg.Destination.remove(cache_entry.Sharers2.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;
        DPRINTF(RubySlicc, "send INV to %s\n", out_msg.Destination);
      }
    }
  }
  
  
  action(fwm2_sendFwdInvToSharersMinusRequestor, "fwm2", desc="invalidate sharers for request, requestor is sharer") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.Type := CoherenceRequestType:INV;
        out_msg.Requestor := in_msg.Requestor;
        out_msg.Destination := cache_entry.Sharers2;
        out_msg.Destination.remove(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }




//////////////////////// use on recover on replacement //////////////////////////
  action(fsn1_sendInvSpecialToSharers_newest, "fsn1", desc="send special inv to the newest sharer2") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubySlicc, "primary_addr: 0x%llx\n", primary_addr);
    enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := primary_addr;
      out_msg.Type := CoherenceRequestType:INVDATA;
      out_msg.Requestor := machineID;
      out_msg.Destination.add(cache_entry.Sharers.newestElement());
      DPRINTF(RubySlicc, "send INVDATA to %s\n", out_msg.Destination);
      DPRINTF(RubySlicc, "sharers are %s\n", cache_entry.Sharers);
      out_msg.MessageSize := MessageSizeType:Request_Control;
    }
  }
