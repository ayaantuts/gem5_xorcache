  action(dmt_insert_fromCache_paried, "dmt_acp", desc="insert into dmt using data in cache, paired blocks") {
    Addr paired_addr := tbe.paired;
    assert(is_valid(getCacheEntry(paired_addr)));
    dmt.insert(paired_addr, getCacheEntry(paired_addr).DataBlk);

    APPEND_TRANSITION_COMMENT(" dmt++(");
    APPEND_TRANSITION_COMMENT(paired_addr);
    APPEND_TRANSITION_COMMENT(")");

    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:SS) {
      dmtShared.insert(paired_addr, getCacheEntry(paired_addr).DataBlk);
      APPEND_TRANSITION_COMMENT(" dmtS++(");
      APPEND_TRANSITION_COMMENT(paired_addr);
      APPEND_TRANSITION_COMMENT(")");
    } 
    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:L2ONLY) {
      dmtNShared.insert(paired_addr, getCacheEntry(paired_addr).DataBlk);
      APPEND_TRANSITION_COMMENT(" dmtNS++(");
      APPEND_TRANSITION_COMMENT(paired_addr);
      APPEND_TRANSITION_COMMENT(")");
    } 
  }

