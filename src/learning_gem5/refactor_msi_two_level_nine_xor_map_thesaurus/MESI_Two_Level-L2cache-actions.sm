    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    dmtNShared.insert_map(secondary_addr, dmtShared.remove_return(secondary_addr));
    
    APPEND_TRANSITION_COMMENT(" dmtS--(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
    APPEND_TRANSITION_COMMENT(" dmtNS++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }

  action(update_data1, "ud1", desc="update data 1") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);

    APPEND_TRANSITION_COMMENT(" origi:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(primary_addr));

    int comp_data_size_in_byte := dataProc.compress_intra(getCacheEntry(primary_addr).DataBlk);
    data.updateDataSize(primary_addr, comp_data_size_in_byte);
    DPRINTF(RubySlicc, "update data size for addr 0x%llx to be \n", primary_addr, comp_data_size_in_byte);
      
    APPEND_TRANSITION_COMMENT(" new:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(primary_addr));
  }
  action(update_data2, "ud2", desc="update data 2") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);

    APPEND_TRANSITION_COMMENT(" origi2:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(secondary_addr));

    int comp_data_size_in_byte := dataProc.compress_intra(getCacheEntry(secondary_addr).DataBlk2);
    data.updateDataSize(secondary_addr, comp_data_size_in_byte);
    DPRINTF(RubySlicc, "update data size for addr 0x%llx to be \n", secondary_addr, comp_data_size_in_byte);
      
    APPEND_TRANSITION_COMMENT(" new2:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(secondary_addr));
  }
  action(change_data_addr_from_primary_to_secondary, "cda12", "change data addr from 1 to 2") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    data.changeAddr(primary_addr, secondary_addr);
  }

//////////////////////// allocate/deallocate l2 //////////////////////////
  action(l2a2_allocateL2, "l2a2", desc="allocate new L2 entry using secandary addr") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(L2cache.isTagPresent(secondary_addr) == false);
    L2cache.allocate(secondary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" l2++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");

    getCacheEntry(secondary_addr).Dirty := cache_entry.Dirty2;
    getCacheEntry(secondary_addr).Sharers := cache_entry.Sharers2;
    getCacheEntry(secondary_addr).DataBlk := cache_entry.DataBlk2;
    getCacheEntry(secondary_addr).DataBlk_phy := cache_entry.DataBlk2;
    getCacheEntry(secondary_addr).Exclusive := cache_entry.Exclusive;
    DPRINTF(RubySlicc, "allocated L2 secondary_addr: 0x%llx (dirty %s, sharers %s, data %s, dataPhy %s, E %s)\n", 
      secondary_addr, getCacheEntry(secondary_addr).Dirty, getCacheEntry(secondary_addr).Sharers,
      getCacheEntry(secondary_addr).DataBlk, getCacheEntry(secondary_addr).DataBlk_phy, 
      getCacheEntry(secondary_addr).Exclusive);
  }
  action(l2a2_allocateL2_preservingPhy, "l2a2Phy", desc="allocate new L2 entry using secandary addr, preserving the old Phy") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(L2cache.isTagPresent(secondary_addr) == false);
    L2cache.allocate(secondary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" l2++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");

    getCacheEntry(secondary_addr).Dirty := cache_entry.Dirty2;
    getCacheEntry(secondary_addr).Sharers := cache_entry.Sharers2;
    getCacheEntry(secondary_addr).DataBlk := cache_entry.DataBlk2;
    getCacheEntry(secondary_addr).DataBlk_phy := cache_entry.DataBlk_phy;
    getCacheEntry(secondary_addr).Exclusive := cache_entry.Exclusive;
    DPRINTF(RubySlicc, "allocated L2 secondary_addr: 0x%llx (dirty %s, sharers %s, data %s, dataPhy %s, E %s)\n", 
      secondary_addr, getCacheEntry(secondary_addr).Dirty, getCacheEntry(secondary_addr).Sharers,
      getCacheEntry(secondary_addr).DataBlk, getCacheEntry(secondary_addr).DataBlk_phy, 
      getCacheEntry(secondary_addr).Exclusive);
  }

  action(ddl21_deallocateL2CacheBlock, "ddl21", desc="Deallocate l2 cache primary") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubySlicc, "primary_addr: 0x%llx\n", primary_addr);
    L2cache.deallocate(primary_addr);
    APPEND_TRANSITION_COMMENT(" l2--(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");
