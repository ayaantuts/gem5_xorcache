//////////////////////// writing logical data //////////////////////////
  action(ml1_writeLogicalDataToCache, "ml1", desc="Write logical data from response queue to cache, set dirty") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk := in_msg.DataBlk;
      if (in_msg.Dirty) {
        cache_entry.Dirty := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk: %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "cache_entry.Dirty: %s\n", cache_entry.Dirty);
  }
  action(ml2_writeLogicalDataToCache, "ml2", desc="Write logical data from response queue to cache, set dirty2") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk2 := in_msg.DataBlk;
      if (in_msg.Dirty) {
        cache_entry.Dirty2 := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk2: %s\n", cache_entry.DataBlk2);
    DPRINTF(RubySlicc, "cache_entry.Dirty2: %s\n", cache_entry.Dirty2);
  }
  
  action(mlr1_writeLogicalDataToCacheFromRequest, "mlr1", desc="Write logical data from request queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
        cache_entry.DataBlk := in_msg.DataBlk;
        cache_entry.Dirty := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk: %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "cache_entry.Dirty: %s\n", cache_entry.Dirty);
  }
  action(mlr2_writeLogicalDataToCacheFromRequest, "mlr2", desc="Write logical data2 from request queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
        cache_entry.DataBlk2 := in_msg.DataBlk;
        cache_entry.Dirty2 := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk2: %s\n", cache_entry.DataBlk2);
    DPRINTF(RubySlicc, "cache_entry.Dirty2: %s\n", cache_entry.Dirty2);
  }



//////////////////////// sending logical data //////////////////////////
  action(el1_sendLogicalDataToGetSRequestors, "el1", desc="Send logical data from cache to all GetS IDs") {
    assert(is_valid(tbe));
    assert(tbe.L1_GetS_IDs.count() > 0);
    enqueue(responseL2Network_out, ResponseMsg, bypass_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.Sender := machineID;
      out_msg.Destination := tbe.L1_GetS_IDs;  // internal nodes
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      out_msg.l2_hit_miss_path := L2HitMissPath:MISS;
      DPRINTF(RubySlicc, "send data to requestors %s\n", out_msg.Destination);
    }
  }
  action(el2_sendLogicalDataToGetSRequestors, "el2", desc="Send logical data 2 from cache to all GetS IDs") {
    assert(is_valid(tbe));
    assert(tbe.L1_GetS_IDs.count() > 0);
    enqueue(responseL2Network_out, ResponseMsg, bypass_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.Sender := machineID;
      out_msg.Destination := tbe.L1_GetS_IDs;  // internal nodes
      out_msg.DataBlk := cache_entry.DataBlk2;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      out_msg.l2_hit_miss_path := L2HitMissPath:MISS;
      DPRINTF(RubySlicc, "send data to requestors %s\n", out_msg.Destination);
    }
  }

  action(dls1_sendSharedDataToRequestor, "dls1", desc="Send logical data from cache to reqeustor") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := 0;
        out_msg.l2_hit_miss_path := L2HitMissPath:DIRECT;
      }
    }
  }
  action(dls2_sendSharedDataToRequestor, "dls2", desc="Send logical data 2 from cache to reqeustor") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk2;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := 0;
        out_msg.l2_hit_miss_path := L2HitMissPath:DIRECT;
      }
    }
  }

  action(ds2pb1_sendSharedData2ToRequestor_piggyback1, "ds2pb1", desc="Send phy (logical data2) from cache to reqeustor") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := primary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk2;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := 0;
        out_msg.l2_hit_miss_path := L2HitMissPath:PB;
        DPRINTF(RubySlicc, "this addr=0x%llx, piggyback addr=0x%llx\n", address, primary_addr);
        DPRINTF(RubySlicc, "cache_entry.DataBlk2=%s, cache_entry.DataBlk_phy=%s\n", cache_entry.DataBlk2, cache_entry.DataBlk_phy);
      }
    }
  }
  action(ds1pb2_sendSharedDataToRequestor_piggyback2, "ds1pb2", desc="Send phy(logical data1) from cache to reqeustor") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := secondary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := 0;
        out_msg.l2_hit_miss_path := L2HitMissPath:PB;
        DPRINTF(RubySlicc, "this addr=0x%llx, piggyback addr=0x%llx\n", address, secondary_addr);
        DPRINTF(RubySlicc, "cache_entry.DataBlk=%s, cache_entry.DataBlk_phy=%s\n", cache_entry.DataBlk, cache_entry.DataBlk_phy);
      }
    }
  }

  action(d1pb2_sendDataToRequestor_piggyback2, "d1pb2", desc="Send data from cache to reqeustor") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := secondary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.l2_hit_miss_path := L2HitMissPath:PB;

        out_msg.AckCount := 0 - cache_entry.Sharers.count();
        if (cache_entry.Sharers.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
        DPRINTF(RubySlicc, "this addr=0x%llx, piggyback addr=0x%llx\n", address, secondary_addr);
      }
    }
  }
  action(d2pb1_sendData2ToRequestor_piggyback1, "d2pb1", desc="Send data from cache to reqeustor") {
    // assert(L2cache.hasSecondaryAddr(address) == true);
    // Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := primary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk2;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.l2_hit_miss_path := L2HitMissPath:PB;

        out_msg.AckCount := 0 - cache_entry.Sharers2.count();
        if (cache_entry.Sharers2.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
        DPRINTF(RubySlicc, "this addr=0x%llx, piggyback addr=0x%llx\n", address, primary_addr);
      }
    }
  }

  action(c1_exclusiveReplacement, "c1", desc="Send data to memory") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := primary_addr;
      out_msg.Type := CoherenceResponseType:MEMORY_DATA;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(primary_addr, MachineType:Directory));
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      DPRINTF(RubySlicc, "c1_exclusiveReplacement sending %#x, DataBlk=%s\n", primary_addr, cache_entry.DataBlk);
    }
  }
  action(c2_exclusiveReplacement, "c2", desc="Send data to memory") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := secondary_addr;
      out_msg.Type := CoherenceResponseType:MEMORY_DATA;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(secondary_addr, MachineType:Directory));
      out_msg.DataBlk := cache_entry.DataBlk2;
      out_msg.Dirty := cache_entry.Dirty2;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      DPRINTF(RubySlicc, "c2_exclusiveReplacement sending %#x, DataBlk2=%s\n", secondary_addr, cache_entry.DataBlk2);
    }
  }

  action(c2_exclusiveCleanReplacement, "cc2", desc="Send ack to memory for clean replacement") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    enqueue(responseL2Network_out, ResponseMsg, bypass_latency) {
      out_msg.addr := secondary_addr;
      out_msg.Type := CoherenceResponseType:ACK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToMachine(secondary_addr, MachineType:Directory));
      out_msg.MessageSize := MessageSizeType:Response_Control;
    }
  }

  action(d2_sendDataToRequestor, "d2", desc="Send data from cache to reqeustor") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk2;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.l2_hit_miss_path := L2HitMissPath:DIRECT;

        out_msg.AckCount := 0 - cache_entry.Sharers2.count();
        if (cache_entry.Sharers2.isElement(in_msg.Requestor)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
      }
    }
  }



//////////////////////// writing physical data //////////////////////////
  // done
  action(mp_writePhyDataToCache_compress_update, "mpcu", desc="write physical data from response queue to cache") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk_phy := in_msg.DataBlk;
      DPRINTF(RubySlicc, "1. cache_entry.DataBlk_phy: %s\n", cache_entry.DataBlk_phy);

      int comp_data_size_in_byte := dataProc.compress_intra(in_msg.DataBlk);
      DPRINTF(RubySlicc, "2.compressed size %d\n", comp_data_size_in_byte);

      Addr primary_addr := L2cache.getPrimaryAddr(address);

      APPEND_TRANSITION_COMMENT(" origi:");
      APPEND_TRANSITION_COMMENT(data.getDataSize(primary_addr));

      data.updateDataSize(primary_addr, comp_data_size_in_byte);
      DPRINTF(RubySlicc, "3.update data size for addr 0x%llx\n", primary_addr);
      
      APPEND_TRANSITION_COMMENT(" new:");
      APPEND_TRANSITION_COMMENT(data.getDataSize(primary_addr));
    }
  }
  // done
  action(mp_writePhyDataToCache, "mp", desc="write physical data from response queue to cache") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk_phy := in_msg.DataBlk;
      DPRINTF(RubySlicc, "1. cache_entry.DataBlk_phy: %s\n", cache_entry.DataBlk_phy);
    }
  }
  // done
  action(mpr_writePhyDataToCache_fromRequest, "mpr", desc="write physical data from request queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk_phy := in_msg.DataBlk;
      DPRINTF(RubySlicc, "1. cache_entry.DataBlk_phy: %s\n", cache_entry.DataBlk_phy);
    }
  }

  // done
  action(mpx_writePhyDataToCache_XOR_noUpdate, "mpnu", desc="process and write physical data from response queue to cache") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      DPRINTF(RubySlicc, "1.cache_entry.DataBlk_phy before xor: %s\n", cache_entry.DataBlk_phy);
      DPRINTF(RubySlicc, "2.xorer: %s\n", in_msg.DataBlk);
      DataBlock newData := dataProc.preprocess(cache_entry.DataBlk_phy, in_msg.DataBlk);
      cache_entry.DataBlk_phy := newData;
      DPRINTF(RubySlicc, "3.cache_entry.DataBlk_phy after xor: %s\n", cache_entry.DataBlk_phy);
    }
  }
  action(mpx_writePhyDataToCache_XOR_compress_update, "mpx", desc="process and write physical data from response queue to cache") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      DPRINTF(RubySlicc, "1.cache_entry.DataBlk_phy before xor: %s\n", cache_entry.DataBlk_phy);
      DPRINTF(RubySlicc, "2.xorer: %s\n", in_msg.DataBlk);
