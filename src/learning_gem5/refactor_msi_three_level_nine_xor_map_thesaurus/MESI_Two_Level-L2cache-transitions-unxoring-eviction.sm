  }
  transition(SS_L2ONLY, L2_Replacement_clean2, M_I) { 
    entropyXOR_rm_xor_data;
    //recover data in secondary block, send recover to primary block
    // secondary
    i2_allocateTBE;
    set_secondary_as_tbe; // will implicitly transition to M_I
    c_exclusiveCleanReplacement;

    ddt2_deallocateTag;
    ddtns2_deallocateTagNS;

    entropy_rm_xor_data;

    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


