    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    // primary block data needs to be recovered => L2ONLY_s
    // secondary block gone => I_I_s
    fsn2_sendInvSpecialToSharers_newest;
    fr2_sendInvToSharers_rest;

    l2set1_l2onlys;
    expand_data1; //overprovision

    usc;
    xor_unpair;
    
    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  
  transition(L2ONLY_SS, {L2_Replacement, MEM_Inv}, L2ONLY_SS_r1) { 
    // nothing changes entropy
    i2_allocateTBE;
    set_secondary_as_tbe;

    ddt1_deallocateTag;
    ddtns1_deallocateTagNS;

