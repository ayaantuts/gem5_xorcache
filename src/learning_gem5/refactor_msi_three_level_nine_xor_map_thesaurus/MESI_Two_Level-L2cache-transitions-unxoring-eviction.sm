    set_primary_as_tbe; // will implicitly transition to M_I
    c_exclusiveCleanReplacement;

    ddt1_deallocateTag;
    ddtns1_deallocateTagNS;

    expand_data1; //overprovision
    change_data_addr_from_primary_to_secondary;

    entropy_rm_xor_data;

    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    // secondary
    drf2_sendRecoverToSharer2UsingFwdNetwork;

    // split l2cache into two (primary is deallocated due to repl)
    l2a2_allocateL2_preservingPhy; // removed xored block from entropy calculation
    l2set2_sss;
    xor_unpair;
    ddl2_deallocateL2CacheBlock;
    
    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
