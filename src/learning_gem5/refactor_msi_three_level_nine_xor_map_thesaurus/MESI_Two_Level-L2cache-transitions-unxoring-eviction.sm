    uur_profileDataRead;
  }
  
  transition(SS_L2ONLY, {L2_Replacement2, MEM_Inv2}, SS_L2ONLY_r2) { 
    //recover data in secondary block, send recover to primary block to the newest sharer
    i1_allocateTBE;
    set_primary_as_tbe;

    ddt2_deallocateTag;
    ddtns2_deallocateTagNS;

    expand_data1; //overprovision
    

    // primary
    drf1_sendRecoverToSharerUsingFwdNetwork;
    
