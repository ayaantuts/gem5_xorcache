    uur_profileDirRead;
  }
  transition(SS_L2ONLY_r2, Recover_Data, SS) { //primary should have enough space
    entropyXOR_rm_xor_data;
    // data for primary block now comes back
    s_deallocateTBE;
    aaststs1_allocateSingularTagBoth_primary;
    dmt_insert_fromCache1;
    dmtS_insert_fromCache1;

    // secondary block recover and send to mem
    ml1_writeLogicalDataToCache;

    entropy_rm_xor_data;
    mp_writePhyDataToCache_compress_update2;

    update_data1;
    entropy_reg_primary_data;
    
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    i2_allocateTBE;
    c2_exclusiveReplacement;// send to memory

    l2set2_mi;

    ooo_run_xor1;

    // deallocate secondary block
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }

  // l2only_ss
