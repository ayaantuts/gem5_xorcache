//  ==== GETX ====

  /////////////////////////////////// SS_SS ///////////////////////////////////
  transition(SS_SS, L1_GETX_self, SS_SS_unxorwbdata1) {
    // primary SS->MT
    // secondary SS
    // secondary data is staying

    // primary gets GETX (event is on 1)
    i_allocateTBE;
    xx_recordGetXL1ID;

    // primary is the one should send out UNXORWB (state SS is on 1)
    sendUnxorwbreq_1self;

    // secondary is staying (event is on 1)
    expand_data1; // overprovision
    change_data_addr_from_primary_to_secondary;

    // primary SS (tag, data, dir) is accessed (event is on 1)
    set_dirMRU;

    uu_profileHit; // TOFIX: is this hit?
    jj_popL1RequestQueue;
    uur_profileDirRead;
    uur_profileDirRead;
  }
  transition(SS_SS_unxorwbdata1, UNXORWB_Data, SS_OR_MT_MB) {
    // primary SS->MT
    // secondary SS
    // secondary data is staying

    // entropy calculation: remove xor data since we are unxoring
    entropyXOR_rm_xor_data;
    entropy_rm_xor_data;

    // write data (primary data comes back and is not staying)
    mpresp_processWriteDataToCache_fromresp;  // primary dirty dont care

    // secondary is staying
    update_data2;

    // entropy calculation: secondary is staying
    entropy_reg_secondary_data;

    // entropy calculation: remove both secondary and primary data since we are unxoring
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    // deallocate SS tag and data (state 1: primary is upgrading)
    ddt_deallocateTag;

    // primary send data (state 1: primary is upgrading)
    // send raw data (primary comes back and no need to xor)
    eea1_sendIncomingDataToGetXRequestor_withackct;

    // primary send inv (primary is in SS) (state 1: primary is upgrading)
    fwmresp_sendFwdInvToSharersMinusRequestor_fromresp;

    // primary SS(tag, data dir) accessed (event is on 1 since SS is on 1)
    set_tagMRU;
    set_dataMRU;
    set_dirMRU;

    // unxoring, secondary (SS) is staying
    aaststs2_allocateSingularTagBoth_secondary;
    dmt_insert_fromCache2;
    l2a2_allocateL2;

    l2set2_ss;
    set_primary_as_cache_entry;
    ooo_run_xor2;
    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDMTRead;
  }
  transition(SS_SS, L1_UPGRADE_self, SS_SS_unxorwbdata1_ug) {
    // primary SS->MT
    // secondary SS
    // secondary data is staying

    // primary gets GETX (event is on 1)
    i_allocateTBE;
    xx_recordGetXL1ID;

    // primary is the one should send out UNXORWB (state SS is on 1)
    sendUnxorwbreq_1self;

    // secondary is staying (event is on 1)
    expand_data1; // overprovision
    change_data_addr_from_primary_to_secondary;

    // primary SS (tag, data, dir) is accessed (event is on 1)
    set_dirMRU;

    uu_profileMissCoh;
    jj_popL1RequestQueue;
    uur_profileDirRead;
    uur_profileDirRead;
  }
  transition(SS_SS_unxorwbdata1_ug, UNXORWB_Data, SS_OR_MT_MB) {
    // primary SS->MT
    // secondary SS
    // secondary data is staying

    // entropy calculation: remove xor data since we are unxoring
    entropyXOR_rm_xor_data;
    entropy_rm_xor_data;

    // write data (primary data comes back and is not staying)
    mpresp_processWriteDataToCache_fromresp;  // primary dirty dont care

    // secondary is staying
    update_data2;

    // entropy calculation: secondary is staying
    entropy_reg_secondary_data;

    // entropy calculation: remove both secondary and primary data since we are unxoring
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    // deallocate SS tag and data (state 1: primary is upgrading)
    ddt_deallocateTag;

    // primary send ack only as this is upgrade (state 1: primary is upgrading)
    tx1_sendInvAckToGetXRequestor;

    // primary send inv (primary is in SS) (state 1: primary is upgrading)
    fwmresp_sendFwdInvToSharersMinusRequestor_fromresp;

    // primary SS(tag, data dir) accessed (event is on 1 since SS is on 1)
    set_tagMRU;
    set_dataMRU;
    set_dirMRU;

    // unxoring, secondary (SS) is staying
    aaststs2_allocateSingularTagBoth_secondary;
    dmt_insert_fromCache2;
    l2a2_allocateL2;

    l2set2_ss;
    set_primary_as_cache_entry;
    ooo_run_xor2;
    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDMTRead;
  }

  transition(SS_SS, L1_GETX2_self, SS_SS_unxorwbdata2) {
    // primary SS
    // secondary SS->MT
    // primary data is staying

    // secondary gets GETX (event is on 2)
    i2_allocateTBE;
    set_secondary_as_tbe;
    xx2_recordGetXL1ID;

    // SS->MT is on secondary, dont need to allocate dir
    // aadir_allocateDir;

    // secondary is the one should send out UNXORWB (state SS is on 2)
    sendUnxorwbreq_2self;

    // primary is staying (event is on 2)
    expand_data1; // overprovision

    // secondary SS (tag, data) is accessed (event is on 2)
    set_tagMRU;

    uu_profileHit; // TOFIX: is this hit?
    jj_popL1RequestQueue;
    uur_profileDirRead;
    uur_profileDirRead;
  }
  transition(SS_SS_unxorwbdata2, UNXORWB_Data2, SS_OR_MT_MB) {
    // primary SS
    // secondary SS->MT
    // primary data is staying 

    // entropy calculation: remove xor data since we are unxoring
    entropyXOR_rm_xor_data;
    entropy_rm_xor_data;

    // write data (secondary data comes back and is not staying)
    mpresp_processWriteDataToCache_fromresp; // secondary dirty dont care

    // primary is staying
    update_data1;

    // entropy calculation: primary is staying
    entropy_reg_primary_data;

    // entropy calculation: remove both secondary and primary data since we are unxoring
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    // deallocate secondary(SS) tag and data (state 2: secondary is upgrading)
    ddt2_deallocateTag;

    // secondary send data (state 2: secondary is upgrading)
    // send raw data (secondary comes back and no need to xor)
    eea2_sendIncomingDataToGetXRequestor_withackct;

    // secondary is in SS, so send inv (state 2: secondary is upgrading)
    fwmresp2_sendFwdInvToSharersMinusRequestor_fromresp;

    // secondary SS(tag, data dir) accessed (event is on 2 since SS is on 2)
    set_tagMRU;
    set_dataMRU;
    set_dirMRU;

    // unxoring, primary (SS) is staying
    aaststs1_allocateSingularTagBoth_primary;
    dmt_insert_fromCache1;

    l2a2_allocateL2;

    // 2 naturally transits, 1 needs to be set (event is on 2 since SS is on 2)
    l2set1_ss; 
    set_secondary_as_cache_entry;

    // unxoring, primary (SS) is staying
    ooo_run_xor1;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDMTRead;
  }
  transition(SS_SS, L1_UPGRADE2_self, SS_SS_unxorwbdata2_ug) {
