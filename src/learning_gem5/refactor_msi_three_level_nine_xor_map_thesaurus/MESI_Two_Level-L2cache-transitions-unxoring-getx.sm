  transition(SS_L2ONLY_unxorwbdata2, UNXORWB_Data, SS) {
    // primary SS
    // secondary L2ONLY->MT
    // primary data is staying
    
    // entropy calculation: remove xor data since we are unxoring
    entropyXOR_rm_xor_data;
    entropy_rm_xor_data;

    // secondary send data (state 2: secondary is upgrading)
    // send processed data (primary comes back and need xor to get secondary)
    eeap2_sendProcessedDataToGetXRequestor_withackct;

    // write data (primary data comes back and is staying)
    mresp_writeDataToCache_fromresp;

    // primary is staying
    update_data1;

    // entropy calculation: primary is staying
    entropy_reg_primary_data;

    // entropy calculation: remove both secondary and primary data since we are unxoring
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    // deallocate L2ONLY tag and data (state 2: secondary is upgrading)
    ddt2_deallocateTag;
    ddtns2_deallocateTagNS;

    

    // fwmresp2_sendFwdInvToSharersMinusRequestor_fromresp;

    // primary SS(tag, data dir) accessed (event is on 1 since SS is on 1)
    set_tagMRU;
    set_dataMRU;
    set_dirMRU;


    // unxoring, primary (SS) is staying
    aaststs1_allocateSingularTagBoth_primary;
    dmt_insert_fromCache1;
    l2a2_allocateL2;
    l2set2_mb;
    set_primary_as_cache_entry;
    ooo_run_xor1;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDMTRead;
  }
  

  // GET stalls
  transition({
    L2ONLY_MTSB,MTSB_SS,SS_MTSB,MTSB_MTSB,MTSB_L2ONLY,
    SI_L2ONLY_dd, SI_L2ONLY_dc, SI_SI_dd, SI_MI_dd, SI_MI_dc, SI_II_dc,
    II_L2ONLY_cd, II_SI_cd, L2ONLY_SI_dd, L2ONLY_II_dc, II_MI_cd,
    L2ONLY_SS_s, SS_L2ONLY_s, SSMB_SS_s, SS_SSMB_s, L2ONLY_SSMB_s, SSMB_L2ONLY_s,
    SS_L2ONLY_r2, SI_SS_r1, SS_SI_r2,SI_L2ONLY_r1,L2ONLY_SI_r2,L2ONLY_SS_r1,
    SS_SS_UB1, SS_SS_UB2, 
    L2ONLY_SS_UB1, L2ONLY_SS_UB2, SS_L2ONLY_UB1, SS_L2ONLY_UB2,
    MTSB_SS_UB2}, 
    {L1_GETX2_self, L1_GETX_other, L1_GETX_self, L1_GETX2_other,
      L1_GETX_stall, L1_GETX2_stall,
      L1_UPGRADE_self, L1_UPGRADE2_self}) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({SS_SS_unxorwbdata1, SS_SS_unxorwbdata2, SS_SS_unxorwbdata1_ug, SS_SS_unxorwbdata2_ug,
    L2ONLY_SS_unxorwbdata1, L2ONLY_SS_unxorwbdata2, L2ONLY_SS_unxorwbdata2_ug,
    SS_L2ONLY_unxorwbdata1, SS_L2ONLY_unxorwbdata2, SS_L2ONLY_unxorwbdata1_ug}, 
    {L1_GETX_self, L1_GETX2_self, L1_GETX_other, L1_GETX2_other,
      L1_UPGRADE_self, L1_UPGRADE2_self,
      L1_GETS_recon, L1_GET_INSTR_recon, L1_GETS2_recon, L1_GET_INSTR2_recon,
      L1_GETS_fwd, L1_GET_INSTR_fwd, L1_GETS2_fwd, L1_GET_INSTR2_fwd,
      L1_GETS_pb, L1_GET_INSTR_pb, L1_GETS2_pb, L1_GET_INSTR2_pb,
      L1_GETS_lifted, L1_GET_INSTR_lifted
    }) {
    zz_stallAndWaitL1RequestQueue;
  }

  // PUT stalls
  transition({SS_SS_unxorwbdata1, SS_SS_unxorwbdata2, SS_SS_unxorwbdata1_ug, SS_SS_unxorwbdata2_ug,
    L2ONLY_SS_unxorwbdata1, L2ONLY_SS_unxorwbdata2, L2ONLY_SS_unxorwbdata2_ug,
    SS_L2ONLY_unxorwbdata1, SS_L2ONLY_unxorwbdata2, SS_L2ONLY_unxorwbdata1_ug}, 
    {L1_PUTS_last2, L1_PUTS_last,
      L1_PUTS_not_last2, L1_PUTS_not_last,
      L1_PUTS_old, L1_PUTS_old2,
      L1_PUTX_not_last, L1_PUTX_not_last2,
      L1_PUTX, L1_PUTX2,
      L1_PUTX_old
    }) {
    zz_stallAndWaitL1RequestQueue;
  }

  // replacement stalls
  transition({SS_SS_unxorwbdata1, SS_SS_unxorwbdata2, SS_SS_unxorwbdata1_ug, SS_SS_unxorwbdata2_ug,
    L2ONLY_SS_unxorwbdata1, L2ONLY_SS_unxorwbdata2, L2ONLY_SS_unxorwbdata2_ug,
    SS_L2ONLY_unxorwbdata1, SS_L2ONLY_unxorwbdata2, SS_L2ONLY_unxorwbdata1_ug}, 
    {L2_Replacement_clean, L2_Replacement_clean2, L2_Replacement, L2_Replacement2,
    L2_Replacement_data_dirty_dirty, L2_Replacement_data_clean_dirty, 
    L2_Replacement_data_clean_clean, L2_Replacement_data_dirty_clean}) {
    zz_stallAndWaitL1RequestQueue;
  }

  // other stalls
  transition({SS_SS_unxorwbdata1, SS_SS_unxorwbdata2, SS_SS_unxorwbdata1_ug, SS_SS_unxorwbdata2_ug,
    L2ONLY_SS_unxorwbdata1, L2ONLY_SS_unxorwbdata2, L2ONLY_SS_unxorwbdata2_ug,
    SS_L2ONLY_unxorwbdata1, SS_L2ONLY_unxorwbdata2, SS_L2ONLY_unxorwbdata1_ug}, Skip_XOR) 
  {
    cj_clearStallCount;
    jf_popTriggerQueue_fail;
  }