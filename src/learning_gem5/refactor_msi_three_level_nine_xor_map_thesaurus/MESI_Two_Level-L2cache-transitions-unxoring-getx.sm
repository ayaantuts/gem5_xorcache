  /////////////////////////////////// L2ONLY_SS ///////////////////////////////////
  transition(L2ONLY_SS, L1_GETX_other, L2ONLY_SS_unxorwbdata1) {
    // primary L2ONLY->MT
    // secondary SS
    // secondary data is staying

    // primary gets GETX (event is on 1)
    i_allocateTBE;
    xx_recordGetXL1ID;
    
    // L2ONLY->MT is on primary, should allocate dir
    aadir_allocateDir;

    // secondary is the one should send out UNXORWB (state SS is on 2)
    sendUnxorwbreq_2other;

    // secondary is staying (event is on 1)
    expand_data1; // overprovision
    change_data_addr_from_primary_to_secondary;

    // primary L2ONLY (tag, data) is accessed (event is on 1)
    set_tagMRU;

    uu_profileHit; // TOFIX: is this hit?
    jj_popL1RequestQueue;
    uur_profileDirRead;
    uur_profileDirRead;
  }
  transition(L2ONLY_SS_unxorwbdata1, UNXORWB_Data2, SS) {
    // primary L2ONLY->MT
    // secondary SS
    // secondary data is staying 

    // entropy calculation: remove xor data since we are unxoring
    entropyXOR_rm_xor_data;
    entropy_rm_xor_data;

    // primary send data (state 1: primary is upgrading)
    // send processed data (secondary comes back and need xor to get primary)
    eeap1_sendProcessedDataToGetXRequestor_withackct;

    // write data (secondary data comes back and is staying)
    mresp_writeDataToCache_fromresp;

    // secondary is staying
    update_data2;

    // entropy calculation: secondary is staying
    entropy_reg_secondary_data;

    // entropy calculation: remove both secondary and primary data since we are unxoring
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    // deallocate primary(L2ONLY) tag and data (state 1: primary is upgrading)
    ddt1_deallocateTag;
    ddtns1_deallocateTagNS;

    // fwmresp_sendFwdInvToSharersMinusRequestor_fromresp;

    // secondary SS(tag, data dir) accessed (event is on 2 since SS is on 2)
    set_tagMRU;
    set_dataMRU;
    set_dirMRU;

    // unxoring, secondary (SS) is staying
    aaststs2_allocateSingularTagBoth_secondary;
    dmt_insert_fromCache2;
    l2a2_allocateL2;

    // 2 naturally transits, 1 needs to be set (event is on 2 since SS is on 2)
    l2set1_mb; 
    set_secondary_as_cache_entry;

    // unxoring, secondary (SS) is staying
    ooo_run_xor2;
    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDMTRead;
  }
  
  transition(L2ONLY_SS, L1_GETX2_self, L2ONLY_SS_unxorwbdata2) {
    // primary L2ONLY
