//////////////////////// helper //////////////////////////
  action(check_phy, "ck_phy", desc="check physical address") {
    assert(cache_entry.DataBlk_phy == cache_entry.DataBlk);
  }
  action(l2_setPairedStateBack, "l2psb", desc="set paired block state back") {
    Addr paired_addr := tbe.paired;
    // DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe\n", paired_addr);
    assert(is_valid(getCacheEntry(paired_addr)));

    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:L2ONLY_s) {
      setCacheEntryState(getCacheEntry(paired_addr),paired_addr, State:L2ONLY);
      dataNS.allocate(paired_addr, new Entry, 1);

      APPEND_TRANSITION_COMMENT(" dataNS++(");
      APPEND_TRANSITION_COMMENT(paired_addr);
      APPEND_TRANSITION_COMMENT(")");

      DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe set to L2ONLY\n", paired_addr);
    } else if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:SS_s) {
      setCacheEntryState(getCacheEntry(paired_addr),paired_addr, State:SS);
      DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe set to SS\n", paired_addr);
    } else {
      assert(false);
    }
  }

  action(f2_sendInvToSharers, "f2", desc="invalidate sharers for L2 replacement") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := secondary_addr;
      out_msg.Type := CoherenceRequestType:INV;
      out_msg.Requestor := machineID;
      out_msg.Destination := cache_entry.Sharers2;
      out_msg.MessageSize := MessageSizeType:Request_Control;
    }
  }


  action(ts2_sendInvAckToUpgrader, "ts2", desc="Send ACK to upgrader") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, bypass_latency) {
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Control;
        // upgrader doesn't get ack from itself, hence the + 1
        out_msg.AckCount := 0 - cache_entry.Sharers2.count() + 1;
      }
    }
  }

  action(xor_unpair, "up", desc="unpair") {
    L2cache.unpair(address);
  }

  action(buf_secondary, "b2", desc="buffer secondary addr in tbe") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    DPRINTF(RubySlicc, "secondary_addr: 0x%llx buffered\n", secondary_addr);
    tbe.paired := secondary_addr;
  }
  action(buf_primary, "b1", desc="buffer primary addr in tbe") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubySlicc, "primary_addr: 0x%llx buffered\n", primary_addr);
    tbe.paired := primary_addr;
  }

  action(set_primary_as_cache_entry, "s1", desc="set primary as cache entry") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    set_cache_entry(L2cache.lookup(primary_addr));
    DPRINTF(RubySlicc, "set cache as 0x%llx\n", primary_addr);
  }

  action(set_secondary_as_cache_entry, "s2", desc="set secondary as cache entry") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    set_cache_entry(L2cache.lookup(secondary_addr));
  }

  action(set_primary_as_tbe, "stbe1", desc="set primary as cache entry") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    set_tbe(TBEs[primary_addr]);
  }

  action(set_secondary_as_tbe, "stbe2", desc="set secondary as cache entry") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    set_tbe(TBEs[secondary_addr]);
  }

  action(kd2_wakeUpDependents, "kd2", desc="wake-up dependents") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    wakeUpAllBuffers(secondary_addr);
  }
  action(kd1_wakeUpDependents, "kd1", desc="wake-up dependents") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    wakeUpAllBuffers(primary_addr);
  }
  action(kdp_wakeUpDependents, "kdp", desc="wake-up dependents") {
    Addr paired_addr := tbe.paired;
    wakeUpAllBuffers(paired_addr);
  }

  action(ass, "ass", desc="assert(false);") {
    assert(false);
  }

  action(usc, "usc", desc="unset cache entry.") {
    unset_cache_entry();
  }