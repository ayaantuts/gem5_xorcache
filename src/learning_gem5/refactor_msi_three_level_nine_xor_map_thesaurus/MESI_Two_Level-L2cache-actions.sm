  action(mpxr_writePhyDataToCache_XOR_fromRequest, "mpxr", desc="process and write physical data from request queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      DPRINTF(RubySlicc, "1.cache_entry.DataBlk_phy before xor: %s\n", cache_entry.DataBlk_phy);

      DPRINTF(RubySlicc, "2.xorer: %s\n", in_msg.DataBlk);
      DataBlock newData := dataProc.preprocess(cache_entry.DataBlk_phy, in_msg.DataBlk);
      cache_entry.DataBlk_phy := newData;
      DPRINTF(RubySlicc, "3.cache_entry.DataBlk_phy after xor: %s\n", cache_entry.DataBlk_phy);
    }
  }
  
  // done
  action(mpxp_processWritePhyDataToPairedCache, "mpxp", desc="process and write physical data from response queue to paired cache block") {
    Addr paired_addr := tbe.paired;
    assert(is_valid(getCacheEntry(paired_addr)));
    peek(responseL2Network_in, ResponseMsg) {
      DPRINTF(RubySlicc, "1.getCacheEntry(paired_addr).DataBlk_phy before xor: %s\n", getCacheEntry(paired_addr).DataBlk_phy);

      DPRINTF(RubySlicc, "2.xorer: %s\n", in_msg.DataBlk);
      DataBlock newData := dataProc.preprocess(getCacheEntry(paired_addr).DataBlk_phy, in_msg.DataBlk);
      
      getCacheEntry(paired_addr).DataBlk_phy := newData;
      DPRINTF(RubySlicc, "3.getCacheEntry(paired_addr).DataBlk_phy after xor: %s\n", getCacheEntry(paired_addr).DataBlk_phy);
      DPRINTF(RubySlicc, "paired_addr: 0x%llx from tbe, its DataBlk_phy: %s\n", paired_addr, getCacheEntry(paired_addr).DataBlk_phy);
    }
  }

