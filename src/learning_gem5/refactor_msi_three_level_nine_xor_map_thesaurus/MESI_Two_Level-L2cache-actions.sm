  action(mpr_writePhyDataToCache_fromRequest, "mpr", desc="write physical data from request queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));

      cache_entry.DataBlk_phy := in_msg.DataBlk;
      DPRINTF(RubySlicc, "1. cache_entry.DataBlk_phy: %s\n", cache_entry.DataBlk_phy);
    }
  }

