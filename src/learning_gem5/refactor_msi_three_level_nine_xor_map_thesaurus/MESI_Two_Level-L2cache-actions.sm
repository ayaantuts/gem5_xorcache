  action(entropyRaw_rm_data, "Rrm", desc="remove data from entropy calculation") {
      DPRINTF(RubyDataEntropyRaw, "RAW: Removal %llx: %s\n", address, cache_entry.DataBlk);
      entropyProfilerRaw.removeData(cache_entry.DataBlk);
