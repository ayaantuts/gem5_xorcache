  /////////// entropy related /////////

  action(dmt_insert_fromCache2, "dmt_ac2", desc="insert using data in cache") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    if (dmt.willReplacementHappen(address, getCacheEntry(secondary_addr).DataBlk2)) {
      Addr addr_to_remove := dmt.insertion_probe(address, getCacheEntry(secondary_addr).DataBlk2);
      dmt.remove(addr_to_remove);
      dmtShared.remove(addr_to_remove);
      dmtNShared.remove(addr_to_remove);
    }
    dmt.insert(secondary_addr, getCacheEntry(secondary_addr).DataBlk2);
    
    APPEND_TRANSITION_COMMENT(" dmt++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
  action(dmtS_insert_fromCache2, "dmtS_ac2", desc="insert into shared using data in cache") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    if (dmtShared.willReplacementHappen(address, getCacheEntry(secondary_addr).DataBlk2)) {
      Addr addr_to_remove := dmtShared.insertion_probe(address, getCacheEntry(secondary_addr).DataBlk2);
      dmt.remove(addr_to_remove);
      dmtShared.remove(addr_to_remove);
      dmtNShared.remove(addr_to_remove);
    }
    dmtShared.insert(secondary_addr, getCacheEntry(secondary_addr).DataBlk2);
    
    APPEND_TRANSITION_COMMENT(" dmtS++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
