  action(ds2pb1_sendSharedData2ToRequestor_piggyback1, "ds2pb1", desc="Send phy (logical data2) from cache to reqeustor") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      Cycles lat := dir.getDataLatency()+L2cache.getDataLatency()+dataProc.decompress();
      if (data.getDataSize(primary_addr) < block_size_in_bytes) {
        // the base cache must hit
        Addr thesaurus_lsh := dataProc.compute_thesaurus_lsh_fingerprint(cache_entry.DataBlk_phy, thesaurus_fingerprint_bits, block_size_in_bytes);
        assert(centroidMemory.isTagPresent(thesaurus_lsh));
        bool centroid_cache_hit := centroidCache.isTagPresent(thesaurus_lsh);
        centroidCache.profileRead();
        if (!centroid_cache_hit) {
          lat := lat + centroid_memory_fetch_latency;

          // approximation: insert the centroid right now; technically, it should wait until memory fetch completes
          if (centroidCache.cacheAvail(thesaurus_lsh)) { // cache miss but has space => insert it
              centroidCache.allocate(thesaurus_lsh, new Entry);
              DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x\n", thesaurus_lsh);
          } else {
              Addr victim_lsh := centroidCache.cacheProbe(thesaurus_lsh);
              assert(victim_lsh != thesaurus_lsh);
              centroidCache.deallocate(victim_lsh); // evict the victim and insert it
              centroidCache.allocate(thesaurus_lsh, new Entry);
              DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x, evicted %#x\n", thesaurus_lsh, victim_lsh);
          }
          centroidCache.profileDemandMiss();
        } else {
          centroidCache.setMRU(thesaurus_lsh);
          centroidCache.profileDemandHit();
          assert(centroidMemory.isTagPresent(thesaurus_lsh));
        }
      }
      
      enqueue(responseL2Network_out, ResponseMsg, lat) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := primary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk2;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;
        out_msg.MessageSize := MessageSizeType:Response_Data_DualAddr;
        out_msg.AckCount := 0;
        out_msg.l2_hit_miss_path := L2HitMissPath:PB;
        DPRINTF(RubySlicc, "this addr=0x%llx, piggyback addr=0x%llx\n", address, primary_addr);
        DPRINTF(RubySlicc, "cache_entry.DataBlk2=%s, cache_entry.DataBlk_phy=%s\n", cache_entry.DataBlk2, cache_entry.DataBlk_phy);
      }
    }
  }
  action(ds1pb2_sendSharedDataToRequestor_piggyback2, "ds1pb2", desc="Send phy(logical data1) from cache to reqeustor") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      Cycles lat := dir.getDataLatency()+L2cache.getDataLatency()+dataProc.decompress();
      if (data.getDataSize(in_msg.addr) < block_size_in_bytes) {
        // the base cache must hit
        Addr thesaurus_lsh := dataProc.compute_thesaurus_lsh_fingerprint(cache_entry.DataBlk_phy, thesaurus_fingerprint_bits, block_size_in_bytes);
        assert(centroidMemory.isTagPresent(thesaurus_lsh));
        bool centroid_cache_hit := centroidCache.isTagPresent(thesaurus_lsh);
        centroidCache.profileRead();
        if (!centroid_cache_hit) {
          lat := lat + centroid_memory_fetch_latency;

          // approximation: insert the centroid right now; technically, it should wait until memory fetch completes
          if (centroidCache.cacheAvail(thesaurus_lsh)) { // cache miss but has space => insert it
              centroidCache.allocate(thesaurus_lsh, new Entry);
              DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x\n", thesaurus_lsh);
          } else {
              Addr victim_lsh := centroidCache.cacheProbe(thesaurus_lsh);
              assert(victim_lsh != thesaurus_lsh);
              centroidCache.deallocate(victim_lsh); // evict the victim and insert it
              centroidCache.allocate(thesaurus_lsh, new Entry);
              DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x, evicted %#x\n", thesaurus_lsh, victim_lsh);
          }
          centroidCache.profileDemandMiss();
        } else {
          centroidCache.setMRU(thesaurus_lsh);
          centroidCache.profileDemandHit();
          assert(centroidMemory.isTagPresent(thesaurus_lsh));
        }
      }
      enqueue(responseL2Network_out, ResponseMsg, lat) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAPB;
        out_msg.piggybacked_addr := secondary_addr;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.DataBlk_phy := cache_entry.DataBlk_phy;
        out_msg.MessageSize := MessageSizeType:Response_Data_DualAddr;
        out_msg.AckCount := 0;
        out_msg.l2_hit_miss_path := L2HitMissPath:PB;
        DPRINTF(RubySlicc, "this addr=0x%llx, piggyback addr=0x%llx\n", address, secondary_addr);
        DPRINTF(RubySlicc, "cache_entry.DataBlk=%s, cache_entry.DataBlk_phy=%s\n", cache_entry.DataBlk, cache_entry.DataBlk_phy);
      }
    }
  }

