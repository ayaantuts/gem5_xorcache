//////////////////////// writing logical data //////////////////////////
  action(ml1_writeLogicalDataToCache, "ml1", desc="Write logical data from response queue to cache, set dirty") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk := in_msg.DataBlk;
      if (in_msg.Dirty) {
        cache_entry.Dirty := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk: %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "cache_entry.Dirty: %s\n", cache_entry.Dirty);
  }
  action(ml2_writeLogicalDataToCache, "ml2", desc="Write logical data from response queue to cache, set dirty2") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk2 := in_msg.DataBlk;
      if (in_msg.Dirty) {
        cache_entry.Dirty2 := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk2: %s\n", cache_entry.DataBlk2);
    DPRINTF(RubySlicc, "cache_entry.Dirty2: %s\n", cache_entry.Dirty2);
  }
  
  action(mlr1_writeLogicalDataToCacheFromRequest, "mlr1", desc="Write logical data from request queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
        cache_entry.DataBlk := in_msg.DataBlk;
        cache_entry.Dirty := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk: %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "cache_entry.Dirty: %s\n", cache_entry.Dirty);
  }
  action(mlr2_writeLogicalDataToCacheFromRequest, "mlr2", desc="Write logical data2 from request queue to cache") {
    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
        cache_entry.DataBlk2 := in_msg.DataBlk;
        cache_entry.Dirty2 := in_msg.Dirty;
      }
    }
    DPRINTF(RubySlicc, "cache_entry.DataBlk2: %s\n", cache_entry.DataBlk2);
    DPRINTF(RubySlicc, "cache_entry.Dirty2: %s\n", cache_entry.Dirty2);
  }

  action(populate_secondary_logical_data, "pop2", desc="assign secondary block logical data as unified second block data") {
    assert(is_valid(cache_entry));
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    cache_entry.DataBlk2 := getCacheEntry(secondary_addr).DataBlk;
    cache_entry.Dirty2 := getCacheEntry(secondary_addr).Dirty;
    cache_entry.Sharers2 := getCacheEntry(secondary_addr).Sharers;
    DPRINTF(RubySlicc, "cache_entry.DataBlk2: %s\n", cache_entry.DataBlk2);
    DPRINTF(RubySlicc, "cache_entry.Dirty2: %s\n", cache_entry.Dirty2);
    DPRINTF(RubySlicc, "cache_entry.Sharers2: %s\n", cache_entry.Sharers2);
  }


//////////////////////// sending logical data //////////////////////////
  action(el1_sendLogicalDataToGetSRequestors, "el1", desc="Send logical data from cache to all GetS IDs") {
    assert(is_valid(tbe));
    assert(tbe.L1_GetS_IDs.count() > 0);
    enqueue(responseL2Network_out, ResponseMsg, bypass_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.Sender := machineID;
      out_msg.Destination := tbe.L1_GetS_IDs;  // internal nodes
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      out_msg.l2_hit_miss_path := L2HitMissPath:MISS;
      DPRINTF(RubySlicc, "send data to requestors %s\n", out_msg.Destination);
    }
  }
  action(el2_sendLogicalDataToGetSRequestors, "el2", desc="Send logical data 2 from cache to all GetS IDs") {
    assert(is_valid(tbe));
    assert(tbe.L1_GetS_IDs.count() > 0);
    enqueue(responseL2Network_out, ResponseMsg, bypass_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.Sender := machineID;
      out_msg.Destination := tbe.L1_GetS_IDs;  // internal nodes
      out_msg.DataBlk := cache_entry.DataBlk2;
      out_msg.MessageSize := MessageSizeType:Response_Data;
      out_msg.l2_hit_miss_path := L2HitMissPath:MISS;
      DPRINTF(RubySlicc, "send data to requestors %s\n", out_msg.Destination);
    }
  }

