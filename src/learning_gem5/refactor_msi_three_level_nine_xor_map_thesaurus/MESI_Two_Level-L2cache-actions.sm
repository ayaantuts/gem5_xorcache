  action(update_data1, "ud1", desc="update data 1") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);

    APPEND_TRANSITION_COMMENT(" origi:");
    int orig_size := data.getDataSize(primary_addr);
    APPEND_TRANSITION_COMMENT(orig_size);

    ////////////////// compute thesaurus lsh value
    Addr thesaurus_lsh := dataProc.compute_thesaurus_lsh_fingerprint(getCacheEntry(primary_addr).DataBlk, thesaurus_fingerprint_bits, block_size_in_bytes);
    bool centroid_cache_hit := centroidCache.isTagPresent(thesaurus_lsh);
    bool centroid_memory_hit := centroidMemory.isTagPresent(thesaurus_lsh);
    centroidCache.profileRead();
    if (!centroid_memory_hit) { // memory has not seen this lsh yet, add it 
        DPRINTF(RubyThesaurus, "centroid memory insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        assert(centroidMemory.cacheAvail(thesaurus_lsh));
        centroidMemory.allocate(thesaurus_lsh, new Entry);
        static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk := getCacheEntry(primary_addr).DataBlk;
        centroidMemory.profileRead();
    } else {
        centroidMemory.incrementCounter(thesaurus_lsh); // one more line added to the cluster
    }
    if (!centroid_cache_hit) { // no penalty on cache miss because we have the centroid right now so no need to look elsewhere
        if (centroidCache.cacheAvail(thesaurus_lsh)) { // cache miss but has space => insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        } else {
            Addr victim_lsh := centroidCache.cacheProbe(thesaurus_lsh);
            assert(victim_lsh != thesaurus_lsh);
            centroidCache.deallocate(victim_lsh); // evict the victim and insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x, evicted %#x\n", thesaurus_lsh, victim_lsh);
        }
    } else {
        centroidCache.setMRU(thesaurus_lsh);
    }
    DataBlock centroid_data_blk := static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk;
    //////////////////////////////////////////////////////

    int comp_data_size_in_byte := dataProc.compress(getCacheEntry(primary_addr).DataBlk, centroid_data_blk);
    
    DPRINTF(RubyDataUpdate, "primary 0x%llx %d -> %d\n", primary_addr, orig_size, comp_data_size_in_byte);
    data.updateDataSize(primary_addr, comp_data_size_in_byte);
      
    APPEND_TRANSITION_COMMENT(" new:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(primary_addr));
  }
  action(expand_data1, "expd1", desc="expand data 1") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);

    APPEND_TRANSITION_COMMENT(" origi:");
    int orig_size := data.getDataSize(primary_addr);
    APPEND_TRANSITION_COMMENT(orig_size);
    
    DPRINTF(RubyDataUpdate, "[expand] primary 0x%llx %d -> %d\n", primary_addr, orig_size, block_size_in_bytes);
    data.updateDataSize(primary_addr, block_size_in_bytes);
      
    APPEND_TRANSITION_COMMENT(" new:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(primary_addr));
  }

  action(update_data2, "ud2", desc="update data 2") {
    // reg_secondary_data
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);

    APPEND_TRANSITION_COMMENT(" origi2:");
    int orig2_size := data.getDataSize(secondary_addr);
    APPEND_TRANSITION_COMMENT(orig2_size);

    ////////////////// compute thesaurus lsh value
    Addr thesaurus_lsh := dataProc.compute_thesaurus_lsh_fingerprint(getCacheEntry(secondary_addr).DataBlk2, thesaurus_fingerprint_bits, block_size_in_bytes);
    bool centroid_cache_hit := centroidCache.isTagPresent(thesaurus_lsh);
    bool centroid_memory_hit := centroidMemory.isTagPresent(thesaurus_lsh);
    centroidCache.profileRead();
    if (!centroid_memory_hit) { // memory has not seen this lsh yet, add it 
        DPRINTF(RubyThesaurus, "centroid memory insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        assert(centroidMemory.cacheAvail(thesaurus_lsh));
        centroidMemory.allocate(thesaurus_lsh, new Entry);
        static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk := getCacheEntry(secondary_addr).DataBlk2;
        centroidMemory.profileRead();
    } else {
        centroidMemory.incrementCounter(thesaurus_lsh); // one more line added to the cluster
    }
    if (!centroid_cache_hit) { // no penalty on cache miss because we have the centroid right now so no need to look elsewhere
        if (centroidCache.cacheAvail(thesaurus_lsh)) { // cache miss but has space => insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        } else {
            Addr victim_lsh := centroidCache.cacheProbe(thesaurus_lsh);
            assert(victim_lsh != thesaurus_lsh);
            centroidCache.deallocate(victim_lsh); // evict the victim and insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x, evicted %#x\n", thesaurus_lsh, victim_lsh);
        }
    } else {
        centroidCache.setMRU(thesaurus_lsh);
    }
    DataBlock centroid_data_blk := static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk;
    //////////////////////////////////////////////////////

    int comp_data_size_in_byte := dataProc.compress(getCacheEntry(secondary_addr).DataBlk2, centroid_data_blk);
    
    DPRINTF(RubyDataUpdate, "secondary 0x%llx %d -> %d\n", secondary_addr, orig2_size, comp_data_size_in_byte);
    data.updateDataSize(secondary_addr, comp_data_size_in_byte);
    DPRINTF(RubySlicc, "update data size for addr 0x%llx from %d to %d\n", secondary_addr, orig2_size, comp_data_size_in_byte);
      
    APPEND_TRANSITION_COMMENT(" new2:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(secondary_addr));
  }
  action(expand_data2, "expd2", desc="expand data 2") {
    // reg_secondary_data
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);

    APPEND_TRANSITION_COMMENT(" origi2:");
    int orig2_size := data.getDataSize(secondary_addr);
    APPEND_TRANSITION_COMMENT(orig2_size);

    
    DPRINTF(RubyDataUpdate, "[expand] secondary 0x%llx %d -> %d\n", secondary_addr, orig2_size, block_size_in_bytes);
    data.updateDataSize(secondary_addr, block_size_in_bytes);
    DPRINTF(RubySlicc, "update data size for addr 0x%llx from %d to %d\n", secondary_addr, orig2_size, block_size_in_bytes);
      
    APPEND_TRANSITION_COMMENT(" new2:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(secondary_addr));
  }
  action(update_data_paired, "udp", desc="update data paired") {
    Addr paired_addr := tbe.paired;
    assert(is_valid(getCacheEntry(paired_addr)));

    APPEND_TRANSITION_COMMENT(" origi paired:");
    int orig_p_size := data.getDataSize(paired_addr);
    APPEND_TRANSITION_COMMENT(orig_p_size);

    ////////////////// compute thesaurus lsh value
    Addr thesaurus_lsh := dataProc.compute_thesaurus_lsh_fingerprint(getCacheEntry(paired_addr).DataBlk, thesaurus_fingerprint_bits, block_size_in_bytes);
    bool centroid_cache_hit := centroidCache.isTagPresent(thesaurus_lsh);
    bool centroid_memory_hit := centroidMemory.isTagPresent(thesaurus_lsh);
    centroidCache.profileRead();
    if (!centroid_memory_hit) { // memory has not seen this lsh yet, add it 
        DPRINTF(RubyThesaurus, "centroid memory insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        assert(centroidMemory.cacheAvail(thesaurus_lsh));
        centroidMemory.allocate(thesaurus_lsh, new Entry);
        static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk := getCacheEntry(paired_addr).DataBlk;
        centroidMemory.profileRead();
    } else {
        centroidMemory.incrementCounter(thesaurus_lsh); // one more line added to the cluster
    }
    if (!centroid_cache_hit) { // no penalty on cache miss because we have the centroid right now so no need to look elsewhere
        if (centroidCache.cacheAvail(thesaurus_lsh)) { // cache miss but has space => insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        } else {
            Addr victim_lsh := centroidCache.cacheProbe(thesaurus_lsh);
            assert(victim_lsh != thesaurus_lsh);
            centroidCache.deallocate(victim_lsh); // evict the victim and insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x, evicted %#x\n", thesaurus_lsh, victim_lsh);
        }
    } else {
        centroidCache.setMRU(thesaurus_lsh);
    }
    DataBlock centroid_data_blk := static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk;
    //////////////////////////////////////////////////////

    int comp_data_size_in_byte := dataProc.compress(getCacheEntry(paired_addr).DataBlk, centroid_data_blk);
    
    DPRINTF(RubyDataUpdate, "paired 0x%llx %d -> %d\n", paired_addr, orig_p_size, comp_data_size_in_byte);
    data.updateDataSize(paired_addr, comp_data_size_in_byte);
    DPRINTF(RubySlicc, "update data size for addr 0x%llx from %d to %d\n", paired_addr, orig_p_size, comp_data_size_in_byte);
      
    APPEND_TRANSITION_COMMENT(" new paired:");
    APPEND_TRANSITION_COMMENT(data.getDataSize(paired_addr));
  }
  action(aad2_allocateData_size_accordingly, "aad2sa", desc="allocate data secondary") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);

    ////////////////// compute thesaurus lsh value
    Addr thesaurus_lsh := dataProc.compute_thesaurus_lsh_fingerprint(getCacheEntry(secondary_addr).DataBlk2, thesaurus_fingerprint_bits, block_size_in_bytes);
    bool centroid_cache_hit := centroidCache.isTagPresent(thesaurus_lsh);
    bool centroid_memory_hit := centroidMemory.isTagPresent(thesaurus_lsh);
    centroidCache.profileRead();
    if (!centroid_memory_hit) { // memory has not seen this lsh yet, add it 
        DPRINTF(RubyThesaurus, "centroid memory insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        assert(centroidMemory.cacheAvail(thesaurus_lsh));
        centroidMemory.allocate(thesaurus_lsh, new Entry);
        static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk := getCacheEntry(secondary_addr).DataBlk2;
        centroidMemory.profileRead();
    } else {
        centroidMemory.incrementCounter(thesaurus_lsh); // one more line added to the cluster
    }
    if (!centroid_cache_hit) { // no penalty on cache miss because we have the centroid right now so no need to look elsewhere
        if (centroidCache.cacheAvail(thesaurus_lsh)) { // cache miss but has space => insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x\n", thesaurus_lsh);
        } else {
            Addr victim_lsh := centroidCache.cacheProbe(thesaurus_lsh);
            assert(victim_lsh != thesaurus_lsh);
            centroidCache.deallocate(victim_lsh); // evict the victim and insert it
            centroidCache.allocate(thesaurus_lsh, new Entry);
            DPRINTF(RubyThesaurus, "centroid cache insert thesaurus_lsh=%#x, evicted %#x\n", thesaurus_lsh, victim_lsh);
        }
    } else {
        centroidCache.setMRU(thesaurus_lsh);
    }
    DataBlock centroid_data_blk := static_cast(Entry, "pointer", centroidMemory[thesaurus_lsh]).DataBlk;
    //////////////////////////////////////////////////////

    int compressed_size := dataProc.compress(getCacheEntry(secondary_addr).DataBlk2, centroid_data_blk);

    DPRINTF(RubySlicc, "secondary_addr: 0x%llx allocate data, size=%d\n", secondary_addr, compressed_size);
    data.allocate(secondary_addr, new Entry, compressed_size);
    APPEND_TRANSITION_COMMENT(" data++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
  action(change_data_addr_from_primary_to_secondary, "cda12", "change data addr from 1 to 2") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    Addr primary_addr := L2cache.getPrimaryAddr(address);

    data.changeAddr(primary_addr, secondary_addr);
  }

//////////////////////// allocate/deallocate l2 //////////////////////////
  action(l2a2_allocateL2, "l2a2", desc="allocate new L2 entry using secandary addr") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(L2cache.isTagPresent(secondary_addr) == false);
    L2cache.allocate(secondary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" l2++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");

    getCacheEntry(secondary_addr).Dirty := cache_entry.Dirty2;
    getCacheEntry(secondary_addr).Sharers := cache_entry.Sharers2;
    getCacheEntry(secondary_addr).DataBlk := cache_entry.DataBlk2;
    getCacheEntry(secondary_addr).DataBlk_phy := cache_entry.DataBlk2;
    getCacheEntry(secondary_addr).Exclusive := cache_entry.Exclusive;
    DPRINTF(RubySlicc, "allocated L2 secondary_addr: 0x%llx (dirty %s, sharers %s, data %s, dataPhy %s, E %s)\n", 
      secondary_addr, getCacheEntry(secondary_addr).Dirty, getCacheEntry(secondary_addr).Sharers,
      getCacheEntry(secondary_addr).DataBlk, getCacheEntry(secondary_addr).DataBlk_phy, 
      getCacheEntry(secondary_addr).Exclusive);
  }
  action(l2a2_allocateL2_preservingPhy, "l2a2Phy", desc="allocate new L2 entry using secandary addr, preserving the old Phy") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(L2cache.isTagPresent(secondary_addr) == false);
    L2cache.allocate(secondary_addr, new Entry);
    APPEND_TRANSITION_COMMENT(" l2++(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");

    getCacheEntry(secondary_addr).Dirty := cache_entry.Dirty2;
    getCacheEntry(secondary_addr).Sharers := cache_entry.Sharers2;
    getCacheEntry(secondary_addr).DataBlk := cache_entry.DataBlk2;
    getCacheEntry(secondary_addr).DataBlk_phy := cache_entry.DataBlk_phy;
    getCacheEntry(secondary_addr).Exclusive := cache_entry.Exclusive;
    DPRINTF(RubySlicc, "allocated L2 secondary_addr: 0x%llx (dirty %s, sharers %s, data %s, dataPhy %s, E %s)\n", 
      secondary_addr, getCacheEntry(secondary_addr).Dirty, getCacheEntry(secondary_addr).Sharers,
      getCacheEntry(secondary_addr).DataBlk, getCacheEntry(secondary_addr).DataBlk_phy, 
      getCacheEntry(secondary_addr).Exclusive);
  }

  action(ddl21_deallocateL2CacheBlock, "ddl21", desc="Deallocate l2 cache primary") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubySlicc, "primary_addr: 0x%llx\n", primary_addr);
    L2cache.deallocate(primary_addr);
    APPEND_TRANSITION_COMMENT(" l2--(");
    APPEND_TRANSITION_COMMENT(primary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
  action(ddl22_deallocateL2CacheBlock, "ddl22", desc="Deallocate l2 cache secondary") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    DPRINTF(RubySlicc, "secondary_addr: 0x%llx\n", secondary_addr);
    L2cache.deallocate(secondary_addr);
    APPEND_TRANSITION_COMMENT(" l2--");
  }


//////////////////////// allocate/deallocate tbe //////////////////////////
  action(i2_allocateTBE, "i2", desc="Allocate TBE secondary for request") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(is_valid(getCacheEntry(secondary_addr)));

    check_allocate(TBEs);
    TBEs.allocate(secondary_addr);
    TBEs[secondary_addr].L1_GetS_IDs.clear();
    TBEs[secondary_addr].DataBlk := getCacheEntry(secondary_addr).DataBlk2;
    TBEs[secondary_addr].DataBlk_phy := getCacheEntry(secondary_addr).DataBlk2;
    TBEs[secondary_addr].Dirty := getCacheEntry(secondary_addr).Dirty2;
    TBEs[secondary_addr].pendingAcks := getCacheEntry(secondary_addr).Sharers2.count();
    DPRINTF(RubySlicc, "allocated tbe: 0x%llx, DataBlk=%s\n", secondary_addr, TBEs[secondary_addr].DataBlk);
  }
  action(i1_allocateTBE, "i1", desc="Allocate TBE for request for primary") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    check_allocate(TBEs);
    assert(is_valid(getCacheEntry(primary_addr)));
    TBEs.allocate(primary_addr);
    TBEs[primary_addr].L1_GetS_IDs.clear();
    TBEs[primary_addr].DataBlk := cache_entry.DataBlk;
    TBEs[primary_addr].DataBlk_phy := cache_entry.DataBlk;
    TBEs[primary_addr].Dirty := cache_entry.Dirty;
    TBEs[primary_addr].pendingAcks := cache_entry.Sharers.count();
  }

