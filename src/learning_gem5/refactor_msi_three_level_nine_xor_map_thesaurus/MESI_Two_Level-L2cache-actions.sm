  /////////// entropy related /////////
  action(entropy_reg_primary_data, "rd1", desc="register primary data toward entropy calculation") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubyDataEntropy, "Insertion %llx(primary):%s\n", primary_addr, getCacheEntry(primary_addr).DataBlk);
    entropyProfiler.registerData(getCacheEntry(primary_addr).DataBlk);
  }
  action(entropy_reg_secondary_data, "rd2", desc="register secondary data toward entropy calculation") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    DPRINTF(RubyDataEntropy, "Insertion %llx(secondary):%s\n", secondary_addr, getCacheEntry(secondary_addr).DataBlk2);
    entropyProfiler.registerData(getCacheEntry(secondary_addr).DataBlk2);
  }
  action(entropy_reg_xor_data,  "regXOR", desc="register xored data toward entropy calculation") {
    Addr primary_addr := address;
    Addr secondary_addr := address;
    if (L2cache.isSecondaryAddr(address)) {
      primary_addr := L2cache.getPrimaryAddr(address);
    } else {
      assert(L2cache.hasSecondaryAddr(address) == true);
      secondary_addr := L2cache.getSecondaryAddr(address);
    }

    DPRINTF(RubyDataEntropy, "Insertion %llx oplus %llx:%s\n", primary_addr, secondary_addr, getCacheEntry(primary_addr).DataBlk_phy);
    entropyProfiler.registerData(getCacheEntry(primary_addr).DataBlk_phy);
  }
  action(entropy_rm_xor_data,  "rmXOR", desc="remove xored data from entropy calculation") {
    Addr primary_addr := address;
    Addr secondary_addr := address;
    if (L2cache.isSecondaryAddr(address)) {
      primary_addr := L2cache.getPrimaryAddr(address);
    } else {
      assert(L2cache.hasSecondaryAddr(address) == true);
      secondary_addr := L2cache.getSecondaryAddr(address);
    }

    DPRINTF(RubyDataEntropy, "Removal %llx oplus %llx:%s\n", primary_addr, secondary_addr, getCacheEntry(primary_addr).DataBlk_phy);
    entropyProfiler.removeData(getCacheEntry(primary_addr).DataBlk_phy);
  }
  action(entropy_rm_primary_data, "rm1", desc="rm primary data from entropy calculation") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);
    DPRINTF(RubyDataEntropy, "Removal %llx(primary):%s\n", primary_addr, getCacheEntry(primary_addr).DataBlk);
    entropyProfiler.removeData(getCacheEntry(primary_addr).DataBlk);
  }
  action(entropy_rm_secondary_data, "rm2", desc="rm secondary data from entropy calculation") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    DPRINTF(RubyDataEntropy, "Removal %llx(secondary):%s\n", secondary_addr, getCacheEntry(secondary_addr).DataBlk);
    entropyProfiler.removeData(getCacheEntry(secondary_addr).DataBlk);
  }
  action(entropy_reg_paired_data, "regPaired", desc="regisiter paired data toward entropy calculation") {
    Addr paired_addr := tbe.paired;
    DPRINTF(RubyDataEntropy, "Insertion %llx(paired):%s\n", paired_addr,getCacheEntry(paired_addr).DataBlk_phy);
    entropyProfiler.registerData(getCacheEntry(paired_addr).DataBlk_phy);
  }

