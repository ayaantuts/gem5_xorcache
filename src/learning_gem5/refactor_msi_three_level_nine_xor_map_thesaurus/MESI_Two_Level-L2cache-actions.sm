  action(dmt_insert_fromCache_paried, "dmt_acp", desc="insert into dmt using data in cache, paired blocks") {
    Addr paired_addr := tbe.paired;
    assert(is_valid(getCacheEntry(paired_addr)));
    if (dmt.willReplacementHappen(address, getCacheEntry(paired_addr).DataBlk)) {
      Addr addr_to_remove := dmt.insertion_probe(address, getCacheEntry(paired_addr).DataBlk);
      dmt.remove(addr_to_remove);
      dmtShared.remove(addr_to_remove);
      dmtNShared.remove(addr_to_remove);
    }
    dmt.insert(paired_addr, getCacheEntry(paired_addr).DataBlk);

    APPEND_TRANSITION_COMMENT(" dmt++(");
    APPEND_TRANSITION_COMMENT(paired_addr);
    APPEND_TRANSITION_COMMENT(")");

    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:SS) {
      if (dmtShared.willReplacementHappen(address, getCacheEntry(paired_addr).DataBlk)) {
        Addr addr_to_remove := dmtShared.insertion_probe(address, getCacheEntry(paired_addr).DataBlk);
        dmt.remove(addr_to_remove);
        dmtShared.remove(addr_to_remove);
        dmtNShared.remove(addr_to_remove);
      }
      dmtShared.insert(paired_addr, getCacheEntry(paired_addr).DataBlk);
      APPEND_TRANSITION_COMMENT(" dmtS++(");
      APPEND_TRANSITION_COMMENT(paired_addr);
      APPEND_TRANSITION_COMMENT(")");
    } 
    if (getState(TBEs[paired_addr], getCacheEntry(paired_addr), paired_addr)  == State:L2ONLY) {
      if (dmtNShared.willReplacementHappen(address, getCacheEntry(paired_addr).DataBlk)) {
        Addr addr_to_remove := dmtNShared.insertion_probe(address, getCacheEntry(paired_addr).DataBlk);
        dmt.remove(addr_to_remove);
        dmtShared.remove(addr_to_remove);
        dmtNShared.remove(addr_to_remove);
      }
      dmtNShared.insert(paired_addr, getCacheEntry(paired_addr).DataBlk);
      APPEND_TRANSITION_COMMENT(" dmtNS++(");
      APPEND_TRANSITION_COMMENT(paired_addr);
      APPEND_TRANSITION_COMMENT(")");
    } 
  }

  action(dmt_rm2, "dmt_rm2", desc="remove") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    dmt.remove(secondary_addr);
    
    APPEND_TRANSITION_COMMENT(" dmt--(");
    APPEND_TRANSITION_COMMENT(secondary_addr);
    APPEND_TRANSITION_COMMENT(")");
  }
