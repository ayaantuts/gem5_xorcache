// transitions from IS/IM

transition(ISS, Mem_Data, MT_MB) {
  m_writeDataToCache;
  xor_unlock;
  ex_sendExclusiveDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}
transition(ISS_existing, Mem_Data, MT_MB_pair) {
  m_writeDataToCache_xor;
  remove_req_to_existing;
  ex_sendExclusiveDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}

transition(IS, Mem_Data, SS) {
  m_writeDataToCache;
  xor_unlock;
  e_sendDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
  kd_wakeUpAll;
}
transition(IS_existing, Mem_Data, SS_pair) {
  m_writeDataToCache_xor;
  remove_req_to_existing;
  e_sendDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
  kd_wakeUpAll;
}

transition(IM, Mem_Data, MT_MB) {
  m_writeDataToCache;
  xor_unlock; // i finish write now and can begin accepting xor
  ee_sendDataToGetXRequestor;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}

transition(IM_existing, Mem_Data, MT_MB_pair) {
  m_writeDataToCache_xor;
  remove_req_to_existing;
  ee_sendDataToGetXRequestor;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}

