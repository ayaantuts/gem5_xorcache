// FROM SS

// FROM S
transition(S, {L1_GETS, L1_GET_INSTR}, SS) {
  a2_checkXORCompressedAccess;
  ds_sendSharedDataToRequestor;
  a1_profileXORCompressedAccess;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  jj_popL1RequestQueue;
}
transition(S_pair, {L1_GETS, L1_GET_INSTR}, SS_pair) {
  ds_sendSharedDataToRequestor;
//   ds_sendSharedDataToRequestor_special_ihavenosharer;
  a1_profileXORCompressedAccess;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  jj_popL1RequestQueue;
}

transition(S, L1_GETX, SS_MB) {
  a2_checkXORCompressedAccess;
  ds_sendSharedDataToRequestor;
  a1_profileXORCompressedAccess;
  check_nosharer;
  set_setMRU;
  uu_profileHit;
  jj_popL1RequestQueue;
}
transition(S_pair, L1_GETX, SS_MB_pair) {
  ds_sendSharedDataToRequestor;
  // ds_sendSharedDataToRequestor_special_ihavenosharer;
  a1_profileXORCompressedAccess;
  check_nosharer;
  set_setMRU;
  uu_profileHit;
  jj_popL1RequestQueue;
}
transition(S_br, L1_GETX, SS_MB_br) {
  ds_sendSharedDataToRequestor;
  a1_profileXORCompressedAccess;
  check_nosharer;
  set_setMRU;
  uu_profileHit;
  // a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}

transition(S, Unblock, SS) {
  nnu_addSharerFromUnblock;
  k_popUnblockQueue;
  kd_wakeUpAll;
}
transition(S, Unblock_noAddSharer) {
  // nnu_addSharerFromUnblock;
  check_nosharer_from_unblock;
  k_popUnblockQueue;
  kd_wakeUpAll;
}

transition(S, L2_Replacement_clean, M_I) {
  uu_profileReplacementTagArray;
  i_allocateTBE;
  c_exclusiveCleanReplacement;
  xor_unlock_conditional;
  rr_deallocateL2CacheBlock;
}
transition(S_pair, L2_Replacement_clean, M_I) {
  uu_profileReplacementTagArray;
  s1_schedulePartnerEviction_tag;
  xor_lock_parner;
  i_allocateTBE;
  c_exclusiveCleanReplacement;
  xor_unlock_conditional;
  rr_deallocateL2CacheBlock;
}

transition({S}, {L2_Replacement_clean_l1}, M_I) {
