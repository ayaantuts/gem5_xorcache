  xor_unlock;
  remove_existing_to_req_link;
}

// unstall put
transition(SS_pair_putStall, {Unstall_Put}, SS_pair) {
  nnu_addSharerFromUnblock;
  k_popUnblockQueue;
  kd_wakeUpAll;
}
transition(SS_pair_putStall, {L2_Replacement_xor_tag,L2_Replacement_clean_xor_tag}) {
  zt_stallAndWaitTriggerQueue;
}
transition(SS_pair_putStall, {L1_GETX, L1_GETS, L1_GET_INSTR, L1_UPGRADE, 
L2_Replacement_clean_xor_notRecoverable_M_GET,L2_Replacement_xor_notRecoverable_M_GET,
L2_Replacement_clean_xor_notRecoverable_M_PUTX,L2_Replacement_xor_notRecoverable_M_PUTX,
}) {
  zz_stallAndWaitL1RequestQueue;
}
