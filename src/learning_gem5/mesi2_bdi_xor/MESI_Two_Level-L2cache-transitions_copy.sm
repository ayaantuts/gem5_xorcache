  c1_profileFillNoXOR;
  c3_profileFillNoXOR_noGoodCandidate;
  qq_allocateL2CacheBlock;
  xor_link_new;
  xor_lock;
  ll_clearSharers;
  nn_addSharer;
  i_allocateTBE;
  ss_recordGetSL1ID;
  a_issueFetchToMemory;
  uu_profileMiss;
  a1_profileXORCompressedAccess;
  a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}
