
//*****************************************************
// TRANSITIONS
//*****************************************************


//===============================================

// FROM SS
transition(SS, L1_PUTS) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}

transition(SS, L1_PUTS_last, S) {
  t_sendWBAck;
  kk_removeRequestSharer;
  check_nosharer;
  jj_popL1RequestQueue;
}

transition(SS, L1_PUTS_old, SS) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}

//from I_I
transition(I_I, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}

//from S_I
transition(S_I, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}

//from M_I
transition(M_I, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}

// FROM SS_MB
transition(SS_MB, {L1_PUTS,L1_PUTS_last}) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}

// FROM MT_SB
// transition({MT_SB,MT_SB_NA,MT_IIB, MT_IIB_NA, MT_IB}, {L1_PUTS_last}) {
transition({MT_SB,MT_IIB, MT_IB}, {L1_PUTS_last}) {
  zz_stallAndWaitL1RequestQueue;
}

// FROM MT
transition(MT, L1_PUTS_old) {
  // sharer has been set to the owner when transitioning into MT, 
  // so old sharer is cleared.
  t_sendWBAck;
  // kk_removeRequestSharer;
  jj_popL1RequestQueue;
}

// FROM MT_IB
transition(MT_IB, L1_PUTS) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}

// FROM NP
transition({NP, MCT_I, MT_I, MT_MB, IM, IM_existing, IS}, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}
// FROM MT_IIB
// transition(MT_IIB, L1_PUTS_old, MT_IIB_NA) {
//   t_sendWBAck;
//   jj_popL1RequestQueue;
// }
transition(MT_IIB, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}
// FROM MT_SB
// transition(MT_SB, L1_PUTS_old, MT_SB_NA) {
//   t_sendWBAck;
//   jj_popL1RequestQueue;
// }
transition(MT_SB, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}
// transition(MT_SB_br, L1_PUTS_old, MT_SB_NA_br) {
//   t_sendWBAck;
//   jj_popL1RequestQueue;
// }
transition(MT_SB_br, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}
transition(MT_SB_br, L1_PUTX_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}

// FROM S
transition(S, {L1_GETS, L1_GET_INSTR}, SS) {
  ds_sendSharedDataToRequestor;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  jj_popL1RequestQueue;
}

transition(S, L1_GETX, SS_MB) {
  ds_sendSharedDataToRequestor;
  check_nosharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  // a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}
transition(S_br, L1_GETX, SS_MB_br) {
  ds_sendSharedDataToRequestor;
  check_nosharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  // a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}

transition(S, Unblock, SS) {
  nnu_addSharerFromUnblock;
  k_popUnblockQueue;
  kd_wakeUpDependents;
}

transition(S, L2_Replacement_clean, M_I) {
  uu_profileReplacementTagArray;
  i_allocateTBE;
  c_exclusiveCleanReplacement;
  rr_deallocateL2CacheBlock;
}

transition({S}, {L2_Replacement_clean_l1}, M_I) {
  uu_profileReplacementDataArray;
  i_allocateTBE;
  c_exclusiveCleanReplacement;
  rr_deallocateL2CacheBlock;
}
transition({S_sync}, {L2_Replacement_clean_l1}, M_I) {
  uu_profileReplacementDataArray;
  xor_unlock;
  e1_rmToEvict;
  i_allocateTBE;
  c_exclusiveCleanReplacement;
  rr_deallocateL2CacheBlock;
}
transition({S_sync}, {L2_Replacement_clean}, M_I) {
  uu_profileReplacementTagArray;
  xor_unlock;
  e1_rmToEvict;
  i_allocateTBE;
  c_exclusiveCleanReplacement;
  rr_deallocateL2CacheBlock;
}

transition(S, {go_to_sync}, S_sync) {
  xor_lock;
}
transition(S, {L2_Replacement}, M_I) {
  uu_profileReplacementTagArray;
  i_allocateTBE;
  c_exclusiveReplacement;
  rr_deallocateL2CacheBlock;
}
transition(S_sync, {L2_Replacement}, M_I) {
  uu_profileReplacementTagArray;
  xor_unlock;
  e1_rmToEvict;
  i_allocateTBE;
  c_exclusiveReplacement;
  rr_deallocateL2CacheBlock;
}
transition(S, {L2_Replacement_xor_data}, M_I) {
  uu_profileReplacementXOR;
  d4_xorType;
  i_allocateTBE;
  c_exclusiveReplacement;
  rr_deallocateL2CacheBlock;
}
