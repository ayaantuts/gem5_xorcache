// BASE STATE - I

// Transitions from I (Idle)
// transition({IS, ISS, IM, IM_existing, IS_existing, ISS_existing,M, M_I, I_I, S_I, MT_IB, MT_SB, MT_SB_NA}, L1_PUTX) {
transition({IS, ISS, IM, IM_existing, IS_existing, ISS_existing,M, M_I, I_I, S_I, MT_IB, MT_SB}, L1_PUTX) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}
transition({MT_IB}, L1_PUTX_not_last) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}
transition(SS, L1_PUTX_not_last) {
  t_sendWBAck;
  kk_removeRequestSharer;
  check_sharer_exist;
  jj_popL1RequestQueue;
}
transition(SS, L1_PUTX, S) {
  t_sendWBAck;
  kk_removeRequestSharer;
  check_nosharer;
  jj_popL1RequestQueue;
}

// transition({NP, SS, M, MT, M_I, I_I, S_I, IS, ISS, IM,IM_existing IS_existing, ISS_existing, MT_IB, MT_SB, MT_SB_NA}, L1_PUTX_old) {
transition({NP, SS, M, MT, M_I, I_I, S_I, IS, ISS, IM,IM_existing IS_existing, ISS_existing, MT_IB, MT_SB}, L1_PUTX_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}

// transition({IM, IM_existing IS, ISS, IS_existing, ISS_existing, SS_MB, MT_MB, MT_IIB, MT_IIB_NA, MT_IB, MT_SB, MT_SB_NA}, 
transition({IM, IM_existing IS, ISS, IS_existing, ISS_existing, SS_MB, MT_MB, MT_IIB, MT_IB, MT_SB}, 
  {L2_Replacement, L2_Replacement_clean}) {
  zz_stallAndWaitL1RequestQueue;
}
// transition({IM, IM_existing, IS, ISS, IS_existing, ISS_existing, SS_MB, MT_MB, MT_IIB, MT_IIB_NA, MT_IB, MT_SB, MT_SB_NA}, 
transition({IM, IM_existing, IS, ISS, IS_existing, ISS_existing, SS_MB, MT_MB, MT_IIB, MT_IB, MT_SB}, 
  {go_to_sync}) {
  zr_recycleL1RequestQueue;
}
transition({MT_MB,SS_MB}, 
  {L2_Replacement_clean_xor_data,L2_Replacement_xor_data,L2_Replacement_clean_xor_tag,L2_Replacement_xor_tag,
  L2_Replacement_clean_xor_notRecoverable_M_PUTX,L2_Replacement_xor_notRecoverable_M_PUTX,
  L2_Replacement_clean_xor_notRecoverable_M_GET,L2_Replacement_xor_notRecoverable_M_GET,
  L2_Replacement_clean_xor_noSharer, L2_Replacement_xor_noSharer}) {
  zz_stallAndWaitL1RequestQueue;
}

transition({IM_existing,IS_existing,ISS_existing}, 
  {L2_Replacement_clean_xor_noSharer}) {
  zz_stallAndWaitL1RequestQueue;
}

// transition({IM, IM_existing, IS, ISS, IS_existing, ISS_existing, SS_MB, MT_MB, MT_IIB, MT_IIB_NA, MT_IB, MT_SB, MT_SB_NA}, 
transition({IM, IM_existing, IS, ISS, IS_existing, ISS_existing, SS_MB, MT_MB, MT_IIB, MT_IB, MT_SB}, 
  {L2_Replacement_l1, L2_Replacement_clean_l1}) {
  zz_stallAndWaitL1RequestQueue;
}

// transition({IM, IS, ISS, IS_existing, ISS_existing, IM_existing, SS_MB, MT_MB, MT_IIB, MT_IIB_NA, MT_IB, MT_SB, MT_SB_NA}, MEM_Inv) {
transition({IM, IS, ISS, IS_existing, ISS_existing, IM_existing, SS_MB, MT_MB, MT_IIB, MT_IB, MT_SB}, MEM_Inv) {
  zn_recycleResponseNetwork;
}

transition({I_I, S_I, M_I, MT_I, MCT_I, NP}, MEM_Inv) {
  o_popIncomingResponseQueue;
}


// transition({SS_MB, MT_MB, MT_IIB, MT_IIB_NA, MT_IB, MT_SB, MT_SB_NA}, 
transition({SS_MB, MT_MB, MT_IIB, MT_IB, MT_SB}, 
  {L1_GETS, L1_GET_INSTR, L1_GETX, L1_UPGRADE}) {
  zz_stallAndWaitL1RequestQueue;
}

transition(NP, L1_GETS_writecache,  ISS) {
  c1_profileFillNoXOR;
  qq_allocateL2CacheBlock;
  xor_link_new;
  xor_lock;
  ll_clearSharers;
  nn_addSharer;
  i_allocateTBE;
  ss_recordGetSL1ID;
  a_issueFetchToMemory;
  uu_profileMiss;
  a1_profileXORCompressedAccess;
  a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}
