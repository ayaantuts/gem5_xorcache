//   i_allocateTBE;
//   f_sendInvToSharers;
//   rr_deallocateL2CacheBlock;
// }
transition(SS_sync, L2_Replacement_clean_xor_notRecoverable_M_PUTX, I_I) {
  uu_profileReplacementXOR;
  xor_unlock;
  d5_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}
transition(SS_sync, L2_Replacement_clean_xor_notRecoverable_M_GET, I_I) {
  uu_profileReplacementXOR;
  xor_unlock;
  d6_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}
// transition(SS_sync, L2_Replacement_clean_xor_noSharer, I_I) {
//   uu_profileReplacementXOR;
//   xor_unlock;
//   d7_xorType;
//   i_allocateTBE;
//   f_sendInvToSharers;
//   rr_deallocateL2CacheBlock;
// }
transition({SS}, L2_Replacement_clean_xor_tag, I_I) {
  uu_profileReplacementXOR;
  d3_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}
transition({SS_sync}, L2_Replacement_clean_xor_tag, I_I) {
  uu_profileReplacementXOR;
  xor_unlock;
  d3_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}
transition({SS}, L2_Replacement_clean_xor_data, I_I) {
  uu_profileReplacementXOR;
  d4_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}
transition({SS_sync}, L2_Replacement_clean_xor_data, I_I) {
  uu_profileReplacementXOR;
  xor_unlock;
  d4_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}

// ==== put/get ====
transition(SS_br, L1_PUTS_last) {
  zz_stallAndWaitL1RequestQueue;
}
transition({MT_SB_br}, {L1_PUTX,L1_PUTS_last}) {
  zz_stallAndWaitL1RequestQueue;
}

transition(M_br, {L1_GETX,L1_GETS}) {
  zz_stallAndWaitL1RequestQueue;
}
transition(M_br, L1_GET_INSTR, SS_br) {
  d_sendDataToRequestor;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  // a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}

transition({MT_MB_br}, {L1_PUTX_old, L1_PUTX}) {
  zz_stallAndWaitL1RequestQueue;
}
transition({MT_MB_br}, {L1_GETS,L1_GET_INSTR, L1_GETX, L1_UPGRADE}) {
  zz_stallAndWaitL1RequestQueue;
}
transition({MT_MB_br}, L1_PUTS_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}
transition(MT_br, {L1_GETS,L1_GET_INSTR}) {
  zz_stallAndWaitL1RequestQueue;
}
transition(SS_MB_br, {L1_GETX, L1_GET_INSTR, L1_GETS}) {
  zz_stallAndWaitL1RequestQueue;
}
transition(SS_MB_br, {L1_PUTS}) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}
transition({SS_MB_br}, {L1_PUTX,L1_PUTX_old,L1_PUTX_not_last}) {
  zz_stallAndWaitL1RequestQueue;
}
transition(SS_MB_br, {L1_PUTS_last}) {
  zz_stallAndWaitL1RequestQueue;
}
transition({SS_MB_br}, {L1_UPGRADE}) {
  zz_stallAndWaitL1RequestQueue;
}

transition(SS_br, {L1_GETS, L1_GET_INSTR}) {
  ds_sendSharedDataToRequestor;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  jj_popL1RequestQueue;
}
transition(S_br, {L1_GETS, L1_GET_INSTR},SS_br) {
  ds_sendSharedDataToRequestor;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  jj_popL1RequestQueue;
}
transition(SS_br, L1_UPGRADE) {
  zz_stallAndWaitL1RequestQueue;
}
transition(SS_br, L1_PUTS) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}
transition({SS_br}, L1_PUTX, S_br) {
  t_sendWBAck;
  kk_removeRequestSharer;
  check_nosharer;
  jj_popL1RequestQueue;
}
transition({SS_br}, L1_PUTX_not_last) {
  t_sendWBAck;
  kk_removeRequestSharer;
  check_sharer_exist;
  jj_popL1RequestQueue;
}

transition(MT_SB_br, Unblock, SS_br) {
  nnu_addSharerFromUnblock;
  k_popUnblockQueue;
  // kd_wakeUpDependents;
}
// transition({MT_SB_br,MT_SB_NA_br}, {L1_GETS, L1_GET_INSTR, L1_GETX, L1_UPGRADE}) {
transition({MT_SB_br}, {L1_GETS, L1_GET_INSTR, L1_GETX, L1_UPGRADE}) {
  zz_stallAndWaitL1RequestQueue;
}
transition({MT_br}, {L1_PUTX}) {
  zz_stallAndWaitL1RequestQueue;
}
transition({MT_br}, L1_PUTX_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}
transition(MT_br, L1_PUTS_old) {
  // sharer has been set to the owner when transitioning into MT, 
  // so old sharer is cleared.
  t_sendWBAck;
  // kk_removeRequestSharer;
  jj_popL1RequestQueue;
}

transition({SS_br}, L1_PUTX_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}

