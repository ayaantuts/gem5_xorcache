// ==== l2 replacement ====
transition({SS_br,MT_SB_br,S_br,M_br,MT_MB_br,MT_br,SS_MB_br}, {L2_Replacement_clean,L2_Replacement,L2_Replacement_clean_l1,L2_Replacement_l1}) {
  zz_stallAndWaitL1RequestQueue;
}
transition({SS_br,MT_SB_br,S_br,M_br,MT_MB_br,MT_br,SS_MB_br}, {MEM_Inv}) {
  zn_recycleResponseNetwork;
}

transition(SS, L2_Replacement_clean_xor_notRecoverable_M_PUTX, I_I) {
  uu_profileReplacementXOR;
  d5_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}
transition(SS, L2_Replacement_clean_xor_notRecoverable_M_GET, I_I) {
  uu_profileReplacementXOR;
  d6_xorType;
  i_allocateTBE;
  f_sendInvToSharers;
  rr_deallocateL2CacheBlock;
}
// transition(SS, L2_Replacement_clean_xor_noSharer, I_I) {
//   uu_profileReplacementXOR;
