transition(MT, L1_PUTX_writecache, M) {
  ll_clearSharers;
  mr_writeDataToCacheFromRequest;
  t_sendWBAck;
  jj_popL1RequestQueue;
}

transition({SS_MB,MT_MB}, Exclusive_Unblock, MT) {
  // update actual directory
  mmu_markExclusiveFromUnblock;
  k_popUnblockQueue;
  kd_wakeUpDependents;
}
transition({SS_MB_br}, Exclusive_Unblock, MT_br) {
  // update actual directory
  mmu_markExclusiveFromUnblock;
  k_popUnblockQueue;
  // kd_wakeUpDependents;
}

transition(MT_MB_br, Exclusive_Unblock, MT_br) {
  // update actual directory
  mmu_markExclusiveFromUnblock;
  k_popUnblockQueue;
  // kd_wakeUpDependents; // not in stable state yet
}

// transition({MT_IIB, MT_IIB_NA}, {L1_PUTX, L1_PUTX_old}){
transition({MT_IIB}, {L1_PUTX, L1_PUTX_old}){
  zz_stallAndWaitL1RequestQueue;
}

transition({MT_IIB}, Unblock, MT_IB) {
  nnu_addSharerFromUnblock;
  k_popUnblockQueue;
}
// transition({MT_IIB_NA}, Unblock, MT_IB) {
//   // nnu_addSharerFromUnblock;
//   k_popUnblockQueue;
// }

transition({MT_IIB}, {WB_Data, WB_Data_clean}, MT_SB) {
  mul_writeDataToCacheUpdateLink;
  xor_unlock; // wb is done, now accepting xor
  o_popIncomingResponseQueue;
}
// transition({MT_IIB_NA}, {WB_Data, WB_Data_clean}, MT_SB_NA) {
//   mul_writeDataToCacheUpdateLink;
//   xor_unlock; // wb is done, now accepting xor
//   o_popIncomingResponseQueue;
// }


transition(MT_IB, {WB_Data, WB_Data_clean}, SS) {
  mul_writeDataToCacheUpdateLink;
  xor_unlock; // wb is done, now accepting xor
  o_popIncomingResponseQueue;
  kd_wakeUpDependents;
}

transition(MT_SB, Unblock, SS) {
  nnu_addSharerFromUnblock;
  k_popUnblockQueue;
  kd_wakeUpDependents;
}
