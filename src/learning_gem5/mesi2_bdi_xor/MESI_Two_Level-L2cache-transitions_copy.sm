/////////////// SYNC states ///////////
transition(MT_sync, {L1_GETX, L1_GETS, L1_GET_INSTR}) {
  zz_stallAndWaitL1RequestQueue;
}
transition({MT_sync}, L1_PUTX) {
  zz_stallAndWaitL1RequestQueue;
}
transition({MT_sync}, {L1_PUTX_old, L1_PUTS_old}) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}


transition(SS_sync, {L1_GETS, L1_GET_INSTR}) {
  ds_sendSharedDataToRequestor;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  jj_popL1RequestQueue;
}
transition(SS_sync, L1_PUTS_last, S_sync) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}
transition(SS_sync, {L1_GETX,L1_UPGRADE}) {
  zz_stallAndWaitL1RequestQueue;
}
transition(SS_sync, L1_PUTS) {
  t_sendWBAck;
  kk_removeRequestSharer;
  jj_popL1RequestQueue;
}
transition(SS_sync, L1_PUTX_not_last) {
  t_sendWBAck;
  kk_removeRequestSharer;
  check_sharer_exist;
  jj_popL1RequestQueue;
}
transition(SS_sync, L1_PUTX, S_sync) {
  t_sendWBAck;
  kk_removeRequestSharer;
  check_nosharer;
  jj_popL1RequestQueue;
}
transition(SS_sync, L1_PUTX_old) {
  t_sendWBAck;
  jj_popL1RequestQueue;
}


transition(S_sync, {L1_GETS,L1_GET_INSTR,L1_GETX}) {
  zz_stallAndWaitL1RequestQueue;
}


transition(M_sync, {L1_GETX, L1_GETS, L1_GET_INSTR}) {
  zz_stallAndWaitL1RequestQueue;
}



//// transition into blockhit
transition(MT, {go_to_blockhit}, MT_blockhit) {
  xor_lock;
}

//// transition out of blockhit
transition(MT_blockhit, go_out_of_blockhit, MT) {
  f1_rmBlockedHit;
  xor_unlock;
  kd_wakeUpDependents;
}

//// blockhit states
transition(MT_blockhit, {L2_Replacement_clean,L2_Replacement,L1_GETX,L1_GETS,L1_GET_INSTR,L1_UPGRADE}) {
  zz_stallAndWaitL1RequestQueue;
}

//// l2 repl recover
transition(MT, {L2_Replacement_clean_tag_recover}, MT_I) {
  uu_profileReplacementTagArray;
  // xor_unlock;
  i_allocateTBE;
  f_sendInvToSharers_special;
  rr_deallocateL2CacheBlock;
}
transition(MT_MB, {L2_Replacement_clean_tag_recover}) {
  zz_stallAndWaitL1RequestQueue;
}
