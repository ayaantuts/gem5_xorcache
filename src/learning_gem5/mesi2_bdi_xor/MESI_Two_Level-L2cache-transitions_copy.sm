// transitions from IS/IM

transition(ISS, Mem_Data, MT_MB) {
  m_writeDataToCache;
  xor_unlock;
  ex_sendExclusiveDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}
transition(ISS_existing, Mem_Data, MT_MB) {
  m_writeDataToCache_xor;
  remove_req_to_existing;
  ex_sendExclusiveDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}

transition(IS, Mem_Data, SS) {
  m_writeDataToCache;
  xor_unlock;
  e_sendDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
  kd_wakeUpDependents;
}
transition(IS_existing, Mem_Data, SS) {
  m_writeDataToCache_xor;
  remove_req_to_existing;
  e_sendDataToGetSRequestors;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
  kd_wakeUpDependents;
}

transition(IM, Mem_Data, MT_MB) {
  m_writeDataToCache;
  xor_unlock; // i finish write now and can begin accepting xor
  ee_sendDataToGetXRequestor;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}

transition(IM_existing, Mem_Data, MT_MB) {
  m_writeDataToCache_xor;
  remove_req_to_existing;
  ee_sendDataToGetXRequestor;
  s_deallocateTBE;
  o_popIncomingResponseQueue;
}

transition({IS, ISS}, {L1_GETS, L1_GET_INSTR}, IS) {
  nn_addSharer;
  ss_recordGetSL1ID;
  uu_profileMiss;
  a1_profileXORCompressedAccess;
  a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}
transition({IS_existing, ISS_existing}, {L1_GETS, L1_GET_INSTR}, IS_existing) {
  nn_addSharer;
  ss_recordGetSL1ID;
  uu_profileMiss;
  a1_profileXORCompressedAccess;
  jj_popL1RequestQueue;
}

transition({IS, ISS}, L1_GETX) {
  zz_stallAndWaitL1RequestQueue;
}
transition({IS_existing, ISS_existing}, L1_GETX) {
  zz_stallAndWaitL1RequestQueue;
}


transition({IM,IM_existing}, {L1_GETX, L1_GETS, L1_GET_INSTR}) {
  zz_stallAndWaitL1RequestQueue;
}

// transitions from SS
transition(SS, {L1_GETS, L1_GET_INSTR}) {
  ds_sendSharedDataToRequestor;
  nn_addSharer;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  jj_popL1RequestQueue;
}


transition(SS, L1_GETX, SS_MB) {
  d_sendDataToRequestor;
  // fw_sendFwdInvToSharers;
  fwm_sendFwdInvToSharersMinusRequestor;
  set_setMRU;
  uu_profileHit;
  a1_profileXORCompressedAccess;
  // a2_checkXORCompressedAccess;
  jj_popL1RequestQueue;
}

transition(SS_br, L1_GETX) {
  zz_stallAndWaitL1RequestQueue;
}

transition(SS, L1_UPGRADE, SS_MB) {
  fwm_sendFwdInvToSharersMinusRequestor;
