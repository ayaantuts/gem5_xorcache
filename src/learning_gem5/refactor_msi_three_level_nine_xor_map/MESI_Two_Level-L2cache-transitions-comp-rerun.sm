  // %%%%%%%%%%%%%%%%%%%%%% cannot xor, try again %%%%%%%%%%%%%%%%%%%%%%
  transition({SS}, Stall_XOR) {
    dmt_insert_fromCache1;
    dmtS_insert_fromCache1;
    ij_increaseStallCount;
    znj_recycleTriggerQueue;
  }
  transition(L2ONLY, Stall_XOR) {
    dmt_insert_fromCache1;
    dmtNS_insert_fromCache1;
    ij_increaseStallCount;
    znj_recycleTriggerQueue;
  }

  // %%%%%%%%%%%%%%%%%%%%%% skip xor, timed out %%%%%%%%%%%%%%%%%%%%%%
  transition(SS, Skip_XOR) {
    dmt_insert_fromCache1;
    dmtS_insert_fromCache1;
    cj_clearStallCount;
    jf_popTriggerQueue_fail;
  }
  transition(L2ONLY, Skip_XOR) {
    dmt_insert_fromCache1;
    dmtNS_insert_fromCache1;
    cj_clearStallCount;
    jf_popTriggerQueue_fail;
  }
  transition({
    SS_OR_MT_MB, MT,
    SS_SS, SS_L2ONLY, L2ONLY_SS, 
    SS_MTSB, MTSB_SS, L2ONLY_MTSB, MTSB_L2ONLY, MTSB_MTSB,
    SS_SSMB_s,L2ONLY_SSMB_s,SSMB_L2ONLY_s,SS_L2ONLY_s,SSMB_SS_s,L2ONLY_SS_s,L2ONLY_s,
    SS_L2ONLY_r2,SS_SI_r2,L2ONLY_SS_r1,SI_L2ONLY_r1,SI_SS_r1,L2ONLY_SI_r2,
    L2ONLY_SS_UB2, MTSB_SS_UB2, SS_L2ONLY_UB1, SS_SS_UB2,SS_SS_UB1,L2ONLY_SS_UB1,SS_L2ONLY_UB2,
    M_I, I_I, S_I,
    SS_s, I_I_s, I_I_sm, S_I_s,
    II_L2ONLY_cd,L2ONLY_II_dc,SI_II_dc,SI_L2ONLY_dd,
    SS_UB
    }, Skip_XOR) 
  {
    cj_clearStallCount;
    jf_popTriggerQueue_fail;
  }