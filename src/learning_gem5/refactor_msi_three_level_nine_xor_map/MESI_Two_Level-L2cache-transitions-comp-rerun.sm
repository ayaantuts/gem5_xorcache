
  // using secondary addr, primary (candidate) block
  transition(SS, Goto_SS_SS, SS_SS) { 
    check_phy;
    ddd_deallocateData;

    ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;
    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;

    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;

    cj_clearStallCount;

    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(SS, Goto_SS_MTSB, SS_MTSB) { 
    check_phy;
    ddd_deallocateData;

    ddststs1_deallocateSTSTS;
    // ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;
    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(SS, Goto_SS_L2ONLY, SS_L2ONLY) {
    check_phy;
    ddd_deallocateData;
    dddns_deallocateDataNS;

    ddststs1_deallocateSTSTS;
    ddst2_deallocateST;

    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtNS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  
  transition(L2ONLY, Goto_L2ONLY_SS, L2ONLY_SS) { 
    check_phy;
    ddd_deallocateData;

    ddst1_deallocateST;
    ddststs_deallocateSTSTS;

    dmt_rm1;
    dmtNS_rm1;
    dmt_rm2;
    dmtS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    dddns1_deallocateDataNS; // primary is no longer nonshared due to xor
    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(L2ONLY, Goto_L2ONLY_MTSB, L2ONLY_MTSB) { 
    check_phy;
    ddd_deallocateData;

    ddst1_deallocateST;
    // ddststs_deallocateSTSTS;
    
    dmt_rm1;
    dmtNS_rm1;
    dmt_rm2;
    dmtS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    dddns1_deallocateDataNS; // primary is no longer nonshared due to xor
    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  
