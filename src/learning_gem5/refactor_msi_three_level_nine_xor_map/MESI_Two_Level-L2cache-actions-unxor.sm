  action(mpresp_processWriteDataToCache_fromresp, "mpresp", desc="process and write data from response queue to cache") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      DPRINTF(RubySlicc, "1.cache_entry.DataBlk_phy before xor: %s\n", cache_entry.DataBlk_phy);
      DPRINTF(RubySlicc, "2.xorer: %s\n", in_msg.DataBlk);
      DataBlock newData := dataProc.preprocess(cache_entry.DataBlk_phy, in_msg.DataBlk);
      cache_entry.DataBlk_phy := newData;
      DPRINTF(RubySlicc, "3.cache_entry.DataBlk_phy after xor: %s\n", cache_entry.DataBlk_phy);
    }
  }
  action(mresp_writeDataToCache_fromresp, "mresp", desc=" write data from response queue to cache") {
    peek(responseL2Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      // assert (in_msg.Dirty == false);
      cache_entry.DataBlk_phy := in_msg.DataBlk;
      DPRINTF(RubySlicc, "dirty: %d, cache_entry.DataBlk_phy: %s\n", cache_entry.Dirty, cache_entry.DataBlk_phy);
    }
  }

  
  action(eea1_sendIncomingDataToGetXRequestor_withackct, "eea1", desc="Send data from cache to GetX ID with ack count") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);

    peek(responseL2Network_in, ResponseMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()+dataProc.decompress()) {
        assert(is_valid(TBEs[primary_addr]));
        assert(is_valid(cache_entry));
        out_msg.addr := primary_addr;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(TBEs[primary_addr].L1_GetX_ID);
        DPRINTF(RubySlicc, "%s\n", out_msg.Destination);
        out_msg.DataBlk := in_msg.DataBlk;
        DPRINTF(RubySlicc, "Address: %#x, Destination: %s, DataBlock: %s\n",
                out_msg.addr, out_msg.Destination, out_msg.DataBlk);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.l2_hit_miss_path := L2HitMissPath:DIRECTUNXOR;

        out_msg.AckCount := 0 - cache_entry.Sharers.count();
        if (cache_entry.Sharers.isElement(TBEs[primary_addr].L1_GetX_ID)) {
          out_msg.AckCount := out_msg.AckCount + 1;
        }
      }
    }
  }
  action(eea2_sendIncomingDataToGetXRequestor_withackct, "eea2", desc="Send data from cache to GetX ID with ack count") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);

    peek(responseL2Network_in, ResponseMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()+dataProc.decompress()) {
        assert(is_valid(TBEs[secondary_addr]));
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(TBEs[secondary_addr].L1_GetX_ID);
        DPRINTF(RubySlicc, "%s\n", out_msg.Destination);
        out_msg.DataBlk := in_msg.DataBlk;
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.l2_hit_miss_path := L2HitMissPath:DIRECTUNXOR;

        out_msg.AckCount := 0 - cache_entry.Sharers2.count();
        if (cache_entry.Sharers2.isElement(TBEs[secondary_addr].L1_GetX_ID)) {
          out_msg.AckCount := out_msg.AckCount + 1;
          DPRINTF(RubySlicc, "one less ack needed\n");
        }
        DPRINTF(RubySlicc, "ackneeded:%d, Address: %#x, Destination: %s, DataBlock: %s\n",
                out_msg.AckCount, out_msg.addr, out_msg.Destination, out_msg.DataBlk);
      }
    }
  }

