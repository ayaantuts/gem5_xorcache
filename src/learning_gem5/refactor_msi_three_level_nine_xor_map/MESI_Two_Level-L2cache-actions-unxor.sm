  action(tx1_sendInvAckToGetXRequestor, "tx1", desc="Send ack ct from cache to GetX ID with ack count") {
    Addr primary_addr := L2cache.getPrimaryAddr(address);

    peek(responseL2Network_in, ResponseMsg) {
      enqueue(responseL2Network_out, ResponseMsg, L2cache.getDataLatency()+dataProc.decompress()) {
        assert(is_valid(TBEs[primary_addr]));
        assert(is_valid(cache_entry));
        out_msg.addr := primary_addr;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(TBEs[primary_addr].L1_GetX_ID);
        out_msg.MessageSize := MessageSizeType:Response_Control;

        out_msg.AckCount := 0 - cache_entry.Sharers.count() + 1;

        out_msg.l2_hit_miss_path := L2HitMissPath:L1COHERENCEUNXOR;

        DPRINTF(RubySlicc, "ackneeded:%d, Address: %#x, Destination: %s\n",
                out_msg.AckCount, out_msg.addr, out_msg.Destination);
      }
    }
  }
  action(tx2_sendInvAckToGetXRequestor, "tx2", desc="Send data from cache to GetX ID with ack count") {
