  action(sendUnxorwbreq_1self, "unxorwbreqSelf1", desc="send unxorwbreq due to myself's triggering action") {
    peek(L1RequestL2Network_in, RequestMsg) {
      enqueue(responseL2Network_out, ResponseMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:UNXORWB;
        out_msg.Sender := in_msg.Requestor;
        out_msg.Destination.add(cache_entry.Sharers.newestElement());
        out_msg.MessageSize := MessageSizeType:Request_Control;
        DPRINTF(RubySlicc, "sendUnxorwbreq_1self: send UNXORWB to %s\n", out_msg.Destination);
      }
    }
  }
