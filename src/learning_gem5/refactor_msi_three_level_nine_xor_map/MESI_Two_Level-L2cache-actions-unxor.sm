        out_msg.l2_hit_miss_path := L2HitMissPath:L1COHERENCEUNXOR;
        
        DPRINTF(RubySlicc, "ackneeded:%d, Address: %#x, Destination: %s\n",
                out_msg.AckCount, out_msg.addr, out_msg.Destination);
      }
    }
  }


  action(fwmresp_sendFwdInvToSharersMinusRequestor_fromresp, "fwmresp", desc="invalidate sharers for request, requestor is sharer") {
    peek(responseL2Network_in, ResponseMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:INV;
        out_msg.Requestor := tbe.L1_GetX_ID;
        out_msg.Destination := cache_entry.Sharers;
        out_msg.Destination.remove(tbe.L1_GetX_ID);
        out_msg.MessageSize := MessageSizeType:Request_Control;
      }
    }
  }
  action(fwmresp2_sendFwdInvToSharersMinusRequestor_fromresp, "fwmresp2", desc="invalidate sharers for request, requestor is sharer") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);

    peek(responseL2Network_in, ResponseMsg) {
      enqueue(L1RequestL2Network_out, RequestMsg, dir.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := secondary_addr;
        out_msg.Type := CoherenceRequestType:INV;
        out_msg.Requestor := TBEs[secondary_addr].L1_GetX_ID;
        out_msg.Destination := cache_entry.Sharers2;
        out_msg.Destination.remove(TBEs[secondary_addr].L1_GetX_ID);
        out_msg.MessageSize := MessageSizeType:Request_Control;
        DPRINTF(RubySlicc, "send out inv, Address: %#x, Destination: %s\n",
              out_msg.addr, out_msg.Destination);
      }
    }
  }

  action(xx2_recordGetXL1ID, "\x2", desc="Record L1 GetX for store response") {
    assert(L2cache.hasSecondaryAddr(address) == true);
    Addr secondary_addr := L2cache.getSecondaryAddr(address);
    assert(is_valid(getCacheEntry(secondary_addr)));

    peek(L1RequestL2Network_in, RequestMsg) {
      assert(is_valid(TBEs[secondary_addr]));
      TBEs[secondary_addr].L1_GetX_ID := in_msg.Requestor;
    }
  }