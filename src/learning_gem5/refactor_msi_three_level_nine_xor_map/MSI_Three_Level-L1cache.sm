          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := MessageSizeType:Response_Data;
       }
   }
   action(h_stale_data_to_l0_peek, "hsp", desc="If not prefetch, send data to the L0 cache.") {
      peek(responseNetwork_in, ResponseMsg) {
        enqueue(bufferToL0_out, CoherenceMsg, bypass_latency) {
            assert(is_valid(cache_entry));
            out_msg.addr := address;
            out_msg.Class := CoherenceClass:STALE_DATA;
            out_msg.Sender := machineID;
            out_msg.Dest := createMachineID(MachineType:L0Cache, version);
            out_msg.DataBlk := cache_entry.DataBlk;
            out_msg.Dirty := cache_entry.Dirty;
            out_msg.MessageSize := MessageSizeType:Response_Data;
            out_msg.l2_hit_miss_path := in_msg.l2_hit_miss_path;
        }
      }
   }
   action(h_stale_data_to_l0_l2pb, "hsl2pb", desc="l2pb") {
      enqueue(bufferToL0_out, CoherenceMsg, bypass_latency) {
          assert(is_valid(cache_entry));
          out_msg.addr := address;
          out_msg.Class := CoherenceClass:STALE_DATA;
          out_msg.Sender := machineID;
          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.l2_hit_miss_path := L2HitMissPath:PB;
       }
   }
   action(h_stale_data_to_l0_l2fwda, "hsl2fwda", desc="l2fwda") {
      enqueue(bufferToL0_out, CoherenceMsg, bypass_latency) {
          assert(is_valid(cache_entry));
          out_msg.addr := address;
          out_msg.Class := CoherenceClass:STALE_DATA;
          out_msg.Sender := machineID;
          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.l2_hit_miss_path := L2HitMissPath:FWDA;
       }
   }
   action(h_stale_data_to_l0_l2fwdb, "hsl2fwdb", desc="l2fwdb") {
      enqueue(bufferToL0_out, CoherenceMsg, bypass_latency) {
          assert(is_valid(cache_entry));
          out_msg.addr := address;
          out_msg.Class := CoherenceClass:STALE_DATA;
          out_msg.Sender := machineID;
          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.l2_hit_miss_path := L2HitMissPath:FWDB;
       }
   }
   action(h_stale_data_to_l0_l1fwde, "hsl2fwde", desc="l2fwde") {
      enqueue(bufferToL0_out, CoherenceMsg, bypass_latency) {
          assert(is_valid(cache_entry));
          out_msg.addr := address;
          out_msg.Class := CoherenceClass:STALE_DATA;
          out_msg.Sender := machineID;
          out_msg.Dest := createMachineID(MachineType:L0Cache, version);
          out_msg.DataBlk := cache_entry.DataBlk;
          out_msg.Dirty := cache_entry.Dirty;
          out_msg.MessageSize := MessageSizeType:Response_Data;
          out_msg.l2_hit_miss_path := L2HitMissPath:FWDE;
       }
   }
  
  
  // profile hit miss
  action(uu_profileMiss, "\um", desc="Profile the demand miss") {
    cache.profileDemandMiss();
  }

  action(uu_profileHit, "\uh", desc="Profile the demand hit") {
    cache.profileDemandHit();
  }

  action(u_writeDataFromL0Response, "uresl0", desc="Write data to cache") {
    peek(messageBufferFromL0_in, CoherenceMsg) {
      assert(is_valid(cache_entry));
      if (in_msg.Dirty) {
          cache_entry.DataBlk := in_msg.DataBlk;
          cache_entry.Dirty := in_msg.Dirty;
      }
    }
  }
  
  include "MESI_Two_Level-L1cache-actions.sm";
  include "MESI_Two_Level-L1cache-actions-unxor.sm";


  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  // Transitions for Load/Store/Replacement/WriteBack from transient states
  transition({I, NP}, L1_Replacement) {
    ff_deallocateCacheBlock;
  }

  transition({IS, IM, IS_I, M_I, SM, SINK_WB_ACK, S_IL0, M_IL0, MM_IL0}, 
        {Load, Store, L1_Replacement}) {
    z0_stallAndWaitL0Queue;
  }

  // Transitions from Idle
  transition({NP,I}, Load, IS) {
    oo_allocateCacheBlock;
    i_allocateTBE;
    a_issueGETS;
    uu_profileMiss;
    k_popL0RequestQueue;
  }

  transition({NP,I}, Store, IM) {
    oo_allocateCacheBlock;
    i_allocateTBE;
    b_issueGETX;
    uu_profileMiss;
    k_popL0RequestQueue;
  }

  transition({NP, I}, Inv) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  // Transitions from Shared
  transition({S,SS}, Load, S) {
    h_data_to_l0_l1direct;
    uu_profileHit;
    k_popL0RequestQueue;
  }

  transition({S,SS}, Store, SM) {
    i_allocateTBE;
    c_issueUPGRADE;
    uu_profileMiss; //COHRENCE MISS
    set_l2_hit_miss_path_coh;
    k_popL0RequestQueue;
  }

  transition(SS, {L1_Replacement}, SINK_WB_ACK) {
    i_allocateTBE;
    g_issuePUTS;
    ff_deallocateCacheBlock;
  }

  transition(S, L0_Invalidate_Own, S_IL0) {
    forward_eviction_to_L0_own;
  }

  transition(S, L0_Invalidate_Else, S_IL0) {
    forward_eviction_to_L0_else;
  }

  transition(SS, Inv, I) {
    fi_sendInvAck;
    ff_deallocateCacheBlock;
    l_popRequestQueue;
  }


  // Transitions from Modified
  transition(MM, Store, M) {
    hh_xdata_to_l0_l1direct;
    uu_profileHit;
    k_popL0RequestQueue;
  }

  transition(MM, L1_Replacement, M_I) {
    i_allocateTBE;
    g_issuePUTX;   // send data, but hold in case forwarded request
    ff_deallocateCacheBlock;
  }

  transition(M, WriteBack, MM) {
    u_writeDataFromL0Request;
    k_popL0RequestQueue;
  }
  
  transition(M_I, WB_Ack, I) {
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }

  transition(MM, Inv, I) {
    f_sendDataToL2;
    ff_deallocateCacheBlock;
    l_popRequestQueue;
  }

  transition(M_I, Inv, SINK_WB_ACK) {
    ft_sendDataToL2_fromTBE;
    l_popRequestQueue;
  }

  transition(MM, Fwd_GETX, I) {
    d_sendDataToRequestor;
    ff_deallocateCacheBlock;
    l_popRequestQueue;
  }

  transition(MM, Fwd_GETS, SS) {
    d_sendDataToRequestor;
    d2_sendDataToL2;
    l_popRequestQueue;
  }

  transition(M, L0_Invalidate_Own, M_IL0) {
    forward_eviction_to_L0_own;
  }

  transition(M, L0_Invalidate_Else, M_IL0) {
    forward_eviction_to_L0_else;
  }

  transition(M_I, Fwd_GETX, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    l_popRequestQueue;
  }

  transition(M_I, Fwd_GETS, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    d2t_sendDataToL2_fromTBE;
    l_popRequestQueue;
  }

  // Transitions from IS
  transition({IS,IS_I}, Inv, IS_I) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition(IS, Data_all_Acks, S) {
    u_writeDataToL1Cache;
    h_data_to_l0_peek;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS, Data_all_Acks_lifted, S) {
    u_writeDataToL1Cache;
    h_data_to_l0_peek;
    je_sendUnblock_extra;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS_I, Data_all_Acks, I) {
    u_writeDataToL1Cache;
    h_stale_data_to_l0_peek;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, Data_all_Acks_lifted, I) {
    u_writeDataToL1Cache;
    h_stale_data_to_l0_peek;
    je_sendUnblock_extra;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS, DataS_fromL1E, S) {
    u_writeDataToL1Cache;
    jn_sendUnblock_necessary;
    // hx_load_hit_l1resp_fwde; // downgrading read (l2 miss)
    h_data_to_l0_l1fwde;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS_I, DataS_fromL1E, I) {
    u_writeDataToL1Cache;
    jn_sendUnblock_necessary;
    // hx_load_hit_l1resp_fwde; // downgrading read (l2 miss)
    h_stale_data_to_l0_l1fwde;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  // Transitions from IM
  transition(IM, Inv, IM) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition(IM, Data, SM) {
    u_writeDataToL1Cache;
    q_updateAckCount;
    set_l2_hit_miss_path_direct;
    o_popIncomingResponseQueue;
  }

  transition(IM, DataE_fromL1E_all_Acks, M) {
    u_writeDataToL1Cache;
    // hhx_store_hit_l1resp_fwde; // down+up write (l2 miss)
    hh_xdata_to_l0_l1fwde;
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IM, {Data_all_Acks, Data_all_Acks_lifted}, M) {
    u_writeDataToL1Cache;
    // hhx_store_hit_dynamic; // direct
    hh_xdata_to_l0_peek;
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  
  // transitions from SM
  transition(IM, Ack) {
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }
  transition(SM, Ack) {
    set_l2_hit_miss_path_unxor_conditionally;
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }

  transition(SM, Ack_all, M) {
    set_l2_hit_miss_path_unxor_conditionally;
    jj_sendExclusiveUnblock;
    // hhx_store_hit_dynamic_tbe;
    hh_xdata_to_l0_tbe; 
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(SM, {Inv,L0_Invalidate_Else}, SM_IL0) {
    forward_eviction_to_L0_else;
  }

  // transitions from SM0
  transition(SM0, Inv, IM) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  // transitions from SINK_WB_ACK
  transition(SINK_WB_ACK, Inv){
    fi_sendInvAck;
    l_popRequestQueue;
  }
  
  transition(SINK_WB_ACK, WB_Ack, I){
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }

  transition(SINK_WB_ACK, WB_Nack){ // single address
    g_issuePUTSData_fromTBE;
    o_popIncomingResponseQueue;
  }

  transition({M_IL0}, WriteBack, MM_IL0) {
    u_writeDataFromL0Request;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition({M_IL0}, L0_DataAck, MM) {
    u_writeDataFromL0Response;
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition({M_IL0, MM_IL0}, L0_Ack, MM) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }


  transition(S_IL0, L0_Ack, SS) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition(SM_IL0, L0_Ack, SM0) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }

  transition({S_IL0, M_IL0, SM_IL0, SM}, L0_Invalidate_Own) {
    z0_stallAndWaitL0Queue;
  }

  transition({S_IL0, M_IL0, SM_IL0}, L0_Invalidate_Else) {
    z2_stallAndWaitRequestQueue;
  }

  transition({M_IL0, MM_IL0}, {Inv, Fwd_GETX, Fwd_GETS}) {
    z2_stallAndWaitRequestQueue;
  }
  transition(S_IL0, {Inv, Fwd_GETX}) {
    z2_stallAndWaitRequestQueue;
  }

  // hardware transactional memory

  // If a transaction has aborted, the L0 could re-request
  // data which is in M or MM state in L1.
  transition({MM,M}, Load, M) {
    hh_xdata_to_l0_l1direct; 
    uu_profileHit;
    k_popL0RequestQueue;
  }

  // If a transaction has aborted, the L0 could re-request
  // data which is in M state in L1.
  transition(M, Store, M) {
    hh_xdata_to_l0_l1direct; 
    uu_profileHit;
    k_popL0RequestQueue;
  }

  

  // A NAK from the L0 means that the L0 invalidated its
  // modified line (due to an abort) so it is therefore necessary
  // to use the L1's correct version instead
  transition(M_IL0, L0_DataNak, MM) {
    k_popL0RequestQueue;
    kd_wakeUpDependents;
  }


  /////////////////// local recovery access ///////////////////
  // link to paper: transition 4 and 5 in fig 5
  // sending data: higher level cache
  // block B receiving data A^B
  transition(IS, DataPB_all_Acks, S_serial_PB) {
    u_writeDataToL1Cache_PB;
    t_enq_pb; // this should trigger block A's access
    o_popIncomingResponseQueue;
  }
  transition(S_serial_PB, Serialization_Complete, S) {
    je_sendUnblock_extra;
    t_deq;
    // hx_load_hit_l2resp_pb; //PB
    h_data_to_l0_l2pb;
    s_deallocateTBE;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataPB_all_Acks, I_serial_PB) {
    u_writeDataToL1Cache_PB;
    t_enq_pb; // this should trigger block A's access
    o_popIncomingResponseQueue;
  }
  transition(I_serial_PB, Serialization_Complete, I) {
    je_sendUnblock_extra;
    t_deq;
    // hx_load_hit_l2resp_pb; //PB
    h_stale_data_to_l0_l2pb;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    kd_wakeUpDependents;
  }
  // stalling
  transition({S_serial_PB, I_serial_PB}, {Load, Store, L1_Replacement}) {
    z0_stallAndWaitL0Queue;
  }

  /////////////////// direct forwarding access ///////////////////
  // link to paper: transition 4 and 5 in fig 5
  // sending data
  transition({S,SS,S_IL0}, Fwd_GETS) {
    ds_sendDataSToRequestor;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, Fwd_GETS) {
    dst_sendDataSToRequestor_fromTBE;
    l_popRequestQueue;
  }
  transition(SM, Fwd_GETS) {
    ds_sendDataSToRequestor;
    l_popRequestQueue;
  }

  // receiving data
  transition(IS, DataS_fromL1S, S) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    // hx_load_hit_l2resp_fwda; //FWD-A
    h_data_to_l0_l2fwda;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataS_fromL1S, I) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    // hx_load_hit_l2resp_fwda; //FWD-A
    h_stale_data_to_l0_l2fwda;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  /////////////////// remote recovery access ///////////////////
  // link to paper: transition 4 and 5 in fig 5
  // sending data
  transition({S,SS,S_IL0}, ReconstructS) {
    rcis_sendReconstructDataS;
    l_popRequestQueue;
  }
  transition(SM, ReconstructS) {
    rcis_sendReconstructDataS;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, ReconstructS) {
    rcist_sendReconstructDataS_fromTBE;
    l_popRequestQueue;
  }


  // receiving data
  transition(IS, DataReconstructS, S) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    // hx_load_hit_l2resp_fwdb; //FWD-B
    h_data_to_l0_l2fwdb;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataReconstructS, I) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    // hx_load_hit_l2resp_fwdb; //FWD-B
    h_stale_data_to_l0_l2fwdb;
    s_deallocateTBE;
    ff_deallocateCacheBlock;
    o_popIncomingResponseQueue;
  }
  
  /////////////////// eviction wbreq ///////////////////
  // link to paper: transition 9 and 10 in fig 5
  // invdata (SS triggered eviction OR co-eviction)
  transition({S,SS}, InvData, I) {
    fi_sendInvAckData;
    l_popRequestQueue;
  }
  transition(SM0, InvData, IM) {
    fi_sendInvAckData;
    l_popRequestQueue;
  }

  transition(SINK_WB_ACK, InvData) {
    fi_sendInvAckData_fromTBE;
    l_popRequestQueue;
  }


  // recover (L2ONLY triggered eviction)
  transition({S,SS,S_IL0}, Recover) {
    ri_sendRecoverData;
    l_popRequestQueue;
  }
  transition(SM, Recover) {
    ri_sendRecoverData;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, Recover) {
    rit_sendRecoverData_fromTBE;
    l_popRequestQueue;
  }




  include "MESI_Two_Level-L1cache-transitions-unxor.sm";
}
