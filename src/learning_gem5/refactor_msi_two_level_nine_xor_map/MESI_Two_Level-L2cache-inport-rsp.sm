  in_port(responseL2Network_in, ResponseMsg, responseToL2Cache, rank = 1) {
    if (responseL2Network_in.isReady(clockEdge())) {
      peek(responseL2Network_in, ResponseMsg) {
        // test wether it's from a local L1 or an off chip source
        assert(in_msg.Destination.isElement(machineID));
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];
        DPRINTF(RubySlicc, "Addr: %#x State: %s Sender: %s Type: %s Dest: %s\n",
                in_msg.addr, getState(tbe, cache_entry, in_msg.addr),
                in_msg.Sender, in_msg.Type, in_msg.Destination);

        bool is_secondary := L2cache.isSecondaryAddr(in_msg.addr);
        DPRINTF(RubySlicc, "Addr: %#x, is_secondary: %d, is_valid(cache_entry): %s\n", 
        in_msg.addr, is_secondary, is_valid(cache_entry));


        if(machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
          if(in_msg.Type == CoherenceResponseType:DATA) { // runing xor algorithm
            if (in_msg.Dirty) {
              trigger(Event:WB_Data, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:WB_Data_clean, in_msg.addr, cache_entry, tbe);
            }
          } else if (in_msg.Type == CoherenceResponseType:ACK) {
            if (is_secondary) {
              if ((getPendingAcks(tbe) - in_msg.AckCount) == 0) {
                trigger(Event:Ack_all2, in_msg.addr, cache_entry, tbe);
              } else {
                trigger(Event:Ack2, in_msg.addr, cache_entry, tbe);
              }
            } else {
              if ((getPendingAcks(tbe) - in_msg.AckCount) == 0) {
                trigger(Event:Ack_all, in_msg.addr, cache_entry, tbe);
              } else {
                trigger(Event:Ack, in_msg.addr, cache_entry, tbe);
              }
            }
          } else if (in_msg.Type == CoherenceResponseType:ACKDATA) {
            if (getState(tbe, cache_entry, in_msg.addr) == State:L2ONLY_SI_dd ||
              getState(tbe, cache_entry, in_msg.addr) == State:L2ONLY_II_dc ||
              getState(tbe, cache_entry, in_msg.addr) == State:SI_L2ONLY_dd ||
              getState(tbe, cache_entry, in_msg.addr) == State:II_L2ONLY_cd ||
              getState(tbe, cache_entry, in_msg.addr) == State:SI_L2ONLY_dc ||
              getState(tbe, cache_entry, in_msg.addr) == State:SI_SI_dd ||
              getState(tbe, cache_entry, in_msg.addr) == State:SI_MI_dd ||
              getState(tbe, cache_entry, in_msg.addr) == State:SI_II_dc ||
              getState(tbe, cache_entry, in_msg.addr) == State:SI_MI_dc ||
              getState(tbe, cache_entry, in_msg.addr) == State:II_SI_cd ||
              getState(tbe, cache_entry, in_msg.addr) == State:II_MI_cd ||
              getState(tbe, cache_entry, in_msg.addr) == State:S_I_s
            ) {
              DPRINTF(RubySlicc, "already doing replacement\n");
            } else if (getState(tbe, cache_entry, in_msg.addr) == State:I_I_s) {
              Addr paired_addr := tbe.paired;
              if (data.cacheAvail(paired_addr, block_size_in_bytes)) {
                DPRINTF(RubySlicc, "ok we have space to unxor\n");
              } else {
                DPRINTF(RubySlicc, "WARNING: we should do another replacement\n");
                error("we should do another replacement, but really?\n");
              }
            } else if (getState(tbe, cache_entry, in_msg.addr) == State:SS_s) {
              if (data.cacheAvail(in_msg.addr, block_size_in_bytes)) {
                DPRINTF(RubySlicc, "ok we have space to unxor\n");
              } else {
                DPRINTF(RubySlicc, "WARNING: we should do another replacement\n");
                error("we should do another replacement, but really?\n");
              }
            } else {
              // r1 and r2 states and SS_s
              Addr check_addr := in_msg.addr;
              if (is_secondary) {
                check_addr := L2cache.getPrimaryAddr(in_msg.addr);
              } else {
                check_addr := L2cache.getSecondaryAddr(in_msg.addr);
              }
              if (data.cacheAvail(check_addr, block_size_in_bytes)) {
                DPRINTF(RubySlicc, "ok we have space to unxor\n");
              } else {
                DPRINTF(RubySlicc, "WARNING: we should do another replacement\n");
                error("we should do another replacement, but really?\n");
              }
            }


            if (is_secondary) {
              if ((getPendingAcks(tbe) - in_msg.AckCount) == 0) {
                trigger(Event:Ack_Data_all2, in_msg.addr, cache_entry, tbe);
              } else {
                trigger(Event:Ack_Data2, in_msg.addr, cache_entry, tbe);
              }
            } else {
              if ((getPendingAcks(tbe) - in_msg.AckCount) == 0) {
                trigger(Event:Ack_Data_all, in_msg.addr, cache_entry, tbe);
              } else {
                trigger(Event:Ack_Data, in_msg.addr, cache_entry, tbe);
              }
            }
          } else if (in_msg.Type == CoherenceResponseType:RECOVERDATA) {
            Addr check_addr := in_msg.addr;
            if (is_secondary) {
              check_addr := L2cache.getSecondaryAddr(in_msg.addr);
            } else {
              check_addr := L2cache.getPrimaryAddr(in_msg.addr);
            }
            if (data.cacheAvail(check_addr, block_size_in_bytes)) {
              DPRINTF(RubySlicc, "ok we have space to unxor\n");
            } else {
              DPRINTF(RubySlicc, "WARNING: we should do another replacement\n");
              error("we should do another replacement, but really?\n");
            }

            
            if (is_secondary) {
              trigger(Event:Recover_Data2, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:Recover_Data, in_msg.addr, cache_entry, tbe);
            }

          } else if (in_msg.Type == CoherenceResponseType:DATA_UNXORWB) {
            if (is_secondary) {
              trigger(Event:UNXORWB_Data2, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:UNXORWB_Data, in_msg.addr, cache_entry, tbe);
            }
          } else {
            error("unknown message type");
          }

        } else { // external message
          if(in_msg.Type == CoherenceResponseType:MEMORY_DATA) { // runing xor algorithm
            // check if we can do xor
            if (dmt.isXORPolicyBalanced()) {
              if (getState(tbe, cache_entry, in_msg.addr) == State:IS && 
                (data.cacheFull() || dmtNShared.hasRegisteredCandidate(in_msg.DataBlk) || dmt.hasRegisteredCandidate(in_msg.DataBlk)) 
                && dmt.getAnyRegisteredCandidateCt() > singularTagShared.getCandidateCtThreshold()) {
                Addr candidate := in_msg.addr;
                // prioritize nonshared for compression ratio
                if (dmtNShared.hasRegisteredCandidate(in_msg.DataBlk)) {
                  candidate := dmtNShared.getRandomRegisteredCandidate(in_msg.DataBlk);
                  DPRINTF(RubySlicc, "NS collision CAND Addr: %#x\n",candidate);
                }
                else if (dmt.hasRegisteredCandidate(in_msg.DataBlk)) {
                  candidate := dmt.getRandomRegisteredCandidate(in_msg.DataBlk);
                  DPRINTF(RubySlicc, "ALL collision CAND Addr: %#x\n",candidate);
                } 
                else {
                  assert(dmt.hasAnyRegisteredCandidate());
                  candidate := dmt.getAnyRandomRegisteredCandidate();
                  DPRINTF(RubySlicc, "ALL no collision CAND Addr: %#x\n",candidate);
                }

                Entry xor_candidate_cache_entry := getCacheEntry(candidate);
                TBE xor_candidate_tbe := TBEs[candidate];

                DPRINTF(RubySlicc, "XOR CAND Addr: %#x State: %s\n",
                        candidate, getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate));
                
                // only need to allocate tag and dir
                assert (tag.cacheAvail(in_msg.addr)); 
                assert (dir.cacheAvail(in_msg.addr)); 
                DPRINTF(RubySlicc, "data size at %llx=%d\n",in_msg.addr, data.getDataSize(in_msg.addr));
                assert (data.cacheAvail(in_msg.addr, block_size_in_bytes)); 
                data.deallocate(in_msg.addr);

                L2cache.pair(candidate, in_msg.addr);
                dmt.remove(candidate);
                dmtShared.remove(candidate);
                dmtNShared.remove(candidate);


                // change state to paired state
                getCacheEntry(candidate).Dirty2 := cache_entry.Dirty;
                getCacheEntry(candidate).Sharers2 := cache_entry.Sharers;
                getCacheEntry(candidate).DataBlk2 := cache_entry.DataBlk;

                L2cache.deallocate(in_msg.addr);

                if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:SS) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:SS_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:SS_IS);
                } else if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:L2ONLY) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:L2ONLY_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:L2ONLY_IS);
                  dataNS.deallocate(candidate);
                  DPRINTF(RubySlicc, "dataNS--(%s)\n", candidate);
                } else if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:MT_SB) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:MTSB_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:MTSB_IS);
                } else {
                  DPRINTF(RubySlicc, "XOR CAND Addr: %#x unknow State: %s\n", 
                  candidate, getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate));
                  error("unknow candidate state!");
                }

                DPRINTF(RubySlicc, "responseL2Network_in: ok xor paired, primary=0x%llx, secondary=0x%llx\n",
                  candidate, in_msg.addr);
                trigger(Event:Mem_Data2, in_msg.addr, xor_candidate_cache_entry, tbe);
              }
            } else if (dmt.isXORPolicySynergy()) {
              if (getState(tbe, cache_entry, in_msg.addr) == State:IS && 
                (dmtNShared.hasRegisteredCandidate(in_msg.DataBlk) || dmt.hasRegisteredCandidate(in_msg.DataBlk)) 
                && dmt.getAnyRegisteredCandidateCt() > singularTagShared.getCandidateCtThreshold()) {
                Addr candidate := in_msg.addr;
                // prioritize nonshared for compression ratio
                if (dmtNShared.hasRegisteredCandidate(in_msg.DataBlk)) {
                  candidate := dmtNShared.getRandomRegisteredCandidate(in_msg.DataBlk);
                  DPRINTF(RubySlicc, "NS collision CAND Addr: %#x\n",candidate);
                }
                else if (dmt.hasRegisteredCandidate(in_msg.DataBlk)) {
                  candidate := dmt.getRandomRegisteredCandidate(in_msg.DataBlk);
                  DPRINTF(RubySlicc, "ALL collision CAND Addr: %#x\n",candidate);
                } 
                else {
                  assert(false);
                }

                Entry xor_candidate_cache_entry := getCacheEntry(candidate);
                TBE xor_candidate_tbe := TBEs[candidate];

                DPRINTF(RubySlicc, "XOR CAND Addr: %#x State: %s\n",
                        candidate, getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate));
                
                // only need to allocate tag and dir
                assert (tag.cacheAvail(in_msg.addr)); 
                assert (dir.cacheAvail(in_msg.addr)); 
                DPRINTF(RubySlicc, "data size at %llx=%d\n",in_msg.addr, data.getDataSize(in_msg.addr));
                assert (data.cacheAvail(in_msg.addr, block_size_in_bytes)); 
                data.deallocate(in_msg.addr);

                L2cache.pair(candidate, in_msg.addr);
                dmt.remove(candidate);
                dmtShared.remove(candidate);
                dmtNShared.remove(candidate);


                // change state to paired state
                getCacheEntry(candidate).Dirty2 := cache_entry.Dirty;
                getCacheEntry(candidate).Sharers2 := cache_entry.Sharers;
                getCacheEntry(candidate).DataBlk2 := cache_entry.DataBlk;

                L2cache.deallocate(in_msg.addr);

                if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:SS) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:SS_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:SS_IS);
                } else if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:L2ONLY) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:L2ONLY_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:L2ONLY_IS);
                  dataNS.deallocate(candidate);
                  DPRINTF(RubySlicc, "dataNS--(%s)\n", candidate);
                } else if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:MT_SB) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:MTSB_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:MTSB_IS);
                } else {
                  DPRINTF(RubySlicc, "XOR CAND Addr: %#x unknow State: %s\n", 
                  candidate, getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate));
                  error("unknow candidate state!");
                }

                DPRINTF(RubySlicc, "responseL2Network_in: ok xor paired, primary=0x%llx, secondary=0x%llx\n",
                  candidate, in_msg.addr);
                trigger(Event:Mem_Data2, in_msg.addr, xor_candidate_cache_entry, tbe);
              }
            } else if (dmt.isXORPolicyOppurtunistic()) {
              if (getState(tbe, cache_entry, in_msg.addr) == State:IS && 
                (dmt.hasAnyRegisteredCandidate()) 
                && dmt.getAnyRegisteredCandidateCt() > singularTagShared.getCandidateCtThreshold()) {
                Addr candidate := in_msg.addr;
                // prioritize nonshared for compression ratio
                if (dmtNShared.hasRegisteredCandidate(in_msg.DataBlk)) {
                  candidate := dmtNShared.getRandomRegisteredCandidate(in_msg.DataBlk);
                  DPRINTF(RubySlicc, "NS collision CAND Addr: %#x\n",candidate);
                }
                else if (dmt.hasRegisteredCandidate(in_msg.DataBlk)) {
                  candidate := dmt.getRandomRegisteredCandidate(in_msg.DataBlk);
                  DPRINTF(RubySlicc, "ALL collision CAND Addr: %#x\n",candidate);
                } 
                else {
                  assert(dmt.hasAnyRegisteredCandidate());
                  candidate := dmt.getAnyRandomRegisteredCandidate();
                  DPRINTF(RubySlicc, "ALL no collision CAND Addr: %#x\n",candidate);
                }

                Entry xor_candidate_cache_entry := getCacheEntry(candidate);
                TBE xor_candidate_tbe := TBEs[candidate];

                DPRINTF(RubySlicc, "XOR CAND Addr: %#x State: %s\n",
                        candidate, getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate));
                
                // only need to allocate tag and dir
                assert (tag.cacheAvail(in_msg.addr)); 
                assert (dir.cacheAvail(in_msg.addr)); 
                DPRINTF(RubySlicc, "data size at %llx=%d\n",in_msg.addr, data.getDataSize(in_msg.addr));
                assert (data.cacheAvail(in_msg.addr, block_size_in_bytes)); 
                data.deallocate(in_msg.addr);

                L2cache.pair(candidate, in_msg.addr);
                dmt.remove(candidate);
                dmtShared.remove(candidate);
                dmtNShared.remove(candidate);


                // change state to paired state
                getCacheEntry(candidate).Dirty2 := cache_entry.Dirty;
                getCacheEntry(candidate).Sharers2 := cache_entry.Sharers;
                getCacheEntry(candidate).DataBlk2 := cache_entry.DataBlk;

                L2cache.deallocate(in_msg.addr);

                if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:SS) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:SS_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:SS_IS);
                } else if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:L2ONLY) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:L2ONLY_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:L2ONLY_IS);
                  DPRINTF(RubySlicc, "about to remove cand %llx from dataNS\n",candidate);
                  dataNS.deallocate(candidate);
                  DPRINTF(RubySlicc, "dataNS--(%s)\n", candidate);
                } else if (getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate) == State:MT_SB) {
                  setState(xor_candidate_tbe, xor_candidate_cache_entry, candidate, State:MTSB_IS);
                  setState(tbe, cache_entry, in_msg.addr, State:MTSB_IS);
                } else {
                  DPRINTF(RubySlicc, "XOR CAND Addr: %#x unknow State: %s\n", 
                  candidate, getState(xor_candidate_tbe, xor_candidate_cache_entry, candidate));
                  error("unknow candidate state!");
                }

                DPRINTF(RubySlicc, "responseL2Network_in: ok xor paired, primary=0x%llx, secondary=0x%llx\n",
                  candidate, in_msg.addr);
                trigger(Event:Mem_Data2, in_msg.addr, xor_candidate_cache_entry, tbe);
              }
            }
              
            trigger(Event:Mem_Data, in_msg.addr, cache_entry, tbe);
          } else if(in_msg.Type == CoherenceResponseType:MEMORY_ACK) {
              trigger(Event:Mem_Ack, in_msg.addr, cache_entry, tbe);
          } else if(in_msg.Type == CoherenceResponseType:INV) {
            if (is_valid(cache_entry) && (is_secondary || L2cache.hasSecondaryAddr(in_msg.addr))) {
              Addr primary_addr := L2cache.getPrimaryAddr(in_msg.addr);
              if (data.cacheAvail(primary_addr, block_size_in_bytes)) {
                DPRINTF(RubySlicc, "ok we have space to unxor\n");
              } else {
                DPRINTF(RubySlicc, "WARNING: we should do a replacement as we got mem_inv for a xored block but running out of data space\n");
                // error("we should do another replacement as we got mem_inv for a xored block but running out of data space, but really?\n");
                 
                // No room in the L2 data, so we need to make room before handling the request
                Addr victim := in_msg.addr;
                if (dataNS.candidateCount(in_msg.addr) > 0) {
                  victim := dataNS.candidateProbe(in_msg.addr);
                  DPRINTF(RubyReplacement, "responseL2Network_in: No room in the data (util=%f) NS\n", data.getUtilByte());
                } else {
                  victim := data.candidateProbe(in_msg.addr);
                  DPRINTF(RubyReplacement, "responseL2Network_in: No room in the data (util=%f)\n", data.getUtilByte());
                }
                DPRINTF(RubySlicc, "responseL2Network_in: victim: %llx\n", victim);

                Entry L2cache_entry := getCacheEntry(victim);
                
                if (L2cache.isSecondaryAddr(victim) || L2cache.hasSecondaryAddr(victim)) {
                  // Addr victim_secondary := L2cache.getSecondaryAddr(victim);
                  // Entry L2cache_entry2 := getCacheEntry(victim_secondary);
                  if (isDirty(L2cache_entry) && isSecondaryDirty(L2cache_entry)) {
                    trigger(Event:L2_Replacement_data_dirty_dirty, victim, L2cache_entry, TBEs[victim]);
                  } else if (!isDirty(L2cache_entry) && !isSecondaryDirty(L2cache_entry)) {
                    trigger(Event:L2_Replacement_data_clean_clean, victim, L2cache_entry, TBEs[victim]);
                  } else if (!isDirty(L2cache_entry) && isSecondaryDirty(L2cache_entry)) {
                    trigger(Event:L2_Replacement_data_clean_dirty, victim, L2cache_entry, TBEs[victim]);
                  } else if (isDirty(L2cache_entry) && !isSecondaryDirty(L2cache_entry)) {
                    trigger(Event:L2_Replacement_data_dirty_clean, victim, L2cache_entry, TBEs[victim]);
                  }
                } else {
                  if (isDirty(L2cache_entry)) {
                    trigger(Event:L2_Replacement, victim, L2cache_entry, TBEs[victim]);
                  } 
                  else {
                    trigger(Event:L2_Replacement_clean,
                            victim, L2cache_entry, TBEs[victim]);
                  }
                }
              }
            }
            if (is_secondary) {
              trigger(Event:MEM_Inv2, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:MEM_Inv, in_msg.addr, cache_entry, tbe);
            }
          } else {
            error("unknown message type");
          }
        }
      }
    }  // if not ready, do nothing
  }

  