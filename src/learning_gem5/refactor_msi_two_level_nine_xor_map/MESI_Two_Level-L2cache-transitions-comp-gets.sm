  // transition 1 in fig 5
  // response inport run xor algorithm
  transition(SS_IS, Mem_Data2, SS_SS_UB2) { // already run xor algorithm
    ml2_writeLogicalDataToCache;

    entropy_rm_xor_data;
    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data2;

    mpx_writePhyDataToCache_XOR_compress_update;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    el2_sendLogicalDataToGetSRequestors; // l2 regular miss
    spu_setPendingUBs;

    // just in case ST has not been deallocated
    ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;

    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    // s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    // kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }

