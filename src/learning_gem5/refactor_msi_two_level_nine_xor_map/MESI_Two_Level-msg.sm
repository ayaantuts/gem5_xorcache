// CoherenceRequestType
enumeration(CoherenceRequestType, desc="...") {
  GETX,      desc="Get eXclusive";
  GETX_INV,      desc="Get eXclusive";
  UPGRADE,   desc="UPGRADE to exclusive";
  GETS,      desc="Get Shared";
  GET_INSTR, desc="Get Instruction";
  INV,       desc="INValidate";
  INVDATA,       desc="INValidate with data";
  PUTX,      desc="Replacement message, M state";
  PUTS,      desc="Replacement message, S state";
  PUTSDATA,      desc="Replacement message, S state";

  WB_ACK,    desc="Writeback ack";

  DMA_READ, desc="DMA Read";
  DMA_WRITE, desc="DMA Write";

  RECOVER, desc="data request";
  RECOVERSUB, desc="data request";
  RECONSTRUCTX, desc="reconstruct data request, GETX";
  RECONSTRUCTS, desc="reconstruct data request, GETS";
}

// CoherenceResponseType
enumeration(CoherenceResponseType, desc="...") {
  MEMORY_ACK, desc="Ack from memory controller";
  DATA, desc="Data block for L1 cache in S state";
  DATAS, desc="Data block for L1 cache in S state";
  DATAPB, desc="Data block for L1 cache in S state";
  // DATA_EXCLUSIVE, desc="Data block for L1 cache in M/E state";
  MEMORY_DATA, desc="Data block from / to main memory";
  ACK, desc="Generic invalidate ack";
  ACKS, desc="Generic invalidate ack";
  ACKDATA, desc="Generic invalidate ack";
  WB_ACK, desc="writeback ack";
  WB_NACK, desc="writeback nack";
  UNBLOCK, desc="unblock";
  EXCLUSIVE_UNBLOCK, desc="exclusive unblock";
  EXCLUSIVE_UNBLOCK_DATA, desc="exclusive unblock data";
  INV, desc="Invalidate from directory";
  RECOVERDATA, desc="data response";
  RECONSTRUCTDATAX, desc="data response";
  RECONSTRUCTDATAS, desc="data response";
}



// RequestMsg
structure(RequestMsg, desc="...", interface="Message") {
  Addr addr,              desc="Physical address for this request";
  CoherenceRequestType Type,    desc="Type of request (GetS, GetX, PutX, etc)";
  RubyAccessMode AccessMode,    desc="user/supervisor access type";
  MachineID Requestor      ,    desc="What component request";
  NetDest Destination,          desc="What components receive the request, includes MachineType and num";
  MessageSizeType MessageSize,  desc="size category of the message";
  DataBlock DataBlk,            desc="Data for the cache line (if PUTX)";
  DataBlock DataBlk_phy,            desc="Physical data for the cache line";
  int Len;
  bool Dirty, default="false",  desc="Dirty bit";
  PrefetchBit Prefetch,         desc="Is this a prefetch request";

  int AckCount_communicate, default="0",  desc="number of acks in this message";
  Addr piggybacked_addr,        desc="piggybacked address";

  bool functionalRead(Packet *pkt) {
    // Only PUTX messages contains the data block
    if (Type == CoherenceRequestType:PUTX) {
        return testAndRead(addr, DataBlk, pkt);
    }

    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // No check on message type required since the protocol should
    // read data from those messages that contain the block
    return testAndWrite(addr, DataBlk, pkt);
  }
}

// ResponseMsg
structure(ResponseMsg, desc="...", interface="Message") {
  Addr addr,              desc="Physical address for this request";
  CoherenceResponseType Type,   desc="Type of response (Ack, Data, etc)";
  MachineID Sender,             desc="What component sent the data";
  NetDest Destination,          desc="Node to whom the data is sent";
  DataBlock DataBlk,            desc="Data for the cache line";
  DataBlock DataBlk_phy,            desc="Physical data for the cache line";
  bool Dirty, default="false",  desc="Dirty bit";
  int AckCount, default="0",  desc="number of acks in this message";
  MessageSizeType MessageSize,  desc="size category of the message";
  Addr piggybacked_addr,        desc="piggybacked address";
  L2HitMissPath l2_hit_miss_path, default="L2HitMissPath_NONE",        desc="l2 hit/miss path";

  bool functionalRead(Packet *pkt) {
    // Valid data block is only present in message with following types
    if (Type == CoherenceResponseType:DATA ||
        // Type == CoherenceResponseType:DATA_EXCLUSIVE ||
        Type == CoherenceResponseType:MEMORY_DATA) {

        return testAndRead(addr, DataBlk, pkt);
    }

    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // No check on message type required since the protocol should
    // read data from those messages that contain the block
    return testAndWrite(addr, DataBlk, pkt);
  }
}

// TriggerMsg
structure(TriggerMsg, desc="...", interface="Message") {
  Addr addr,             desc="Physical address for this request";
  Tick enqueTick,     desc="Tick when the message was enqueued";
  // TriggerType Type,            desc="Type of trigger";

  bool functionalRead(Packet *pkt) {
    // Trigger messages do not hold any data!
    return false;
  }

  bool functionalWrite(Packet *pkt) {
    // Trigger messages do not hold any data!
    return false;
  }
}