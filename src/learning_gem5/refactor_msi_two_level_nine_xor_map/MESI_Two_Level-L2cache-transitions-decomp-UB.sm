// // %%%%%%%%%%%%%%%%%%%%%% outof XOR %%%%%%%%%%%%%%%%%%%%%% 
// %%%%%%%%%%%%%%%%%%%%%% stalling %%%%%%%%%%%%%%%%%%%%%%
  // puts blocked
  // repl
  transition({SS_SS_UB1, SS_L2ONLY_UB1, L2ONLY_SS_UB1, 
    SS_SS_UB2, SS_L2ONLY_UB2, L2ONLY_SS_UB2, MTSB_SS_UB2}, 
    {L2_Replacement, L2_Replacement_clean, 
    L2_Replacement2, L2_Replacement_clean2, 
    L2_Replacement_data_dirty_dirty, L2_Replacement_data_clean_clean,
    L2_Replacement_data_clean_dirty, L2_Replacement_data_dirty_clean,
    L1_PUTS_not_last, L1_PUTS_not_last2, L1_PUTS_last, L1_PUTS_last2,
    L1_PUTS_old, L1_PUTS_old2,
    L1_PUTS_blocked, L1_PUTS_blocked2,
    L1_PUTX_not_last, L1_PUTX_not_last2, L1_PUTX_old,
    L1_GETS_pb, L1_GET_INSTR_pb, L1_GETS2_pb, L1_GET_INSTR2_pb,
    L1_GETS_fwd, L1_GET_INSTR_fwd, L1_GETS2_fwd, L1_GET_INSTR2_fwd,
    L1_GETS_recon, L1_GET_INSTR_recon, L1_GETS2_recon, L1_GET_INSTR2_recon,
    L1_GETS, L1_GET_INSTR,
    L1_GETS2_stall, L1_GET_INSTR2_stall,
    }) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({SS_SS_UB1, SS_L2ONLY_UB1, L2ONLY_SS_UB1, 
    SS_SS_UB2, SS_L2ONLY_UB2, L2ONLY_SS_UB2, MTSB_SS_UB2}, 
    {MEM_Inv, MEM_Inv2}) {
    zn_recycleResponseNetwork;
  }


