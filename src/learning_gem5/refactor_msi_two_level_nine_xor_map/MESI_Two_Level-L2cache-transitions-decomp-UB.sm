// %%%%%%%%%%%%%%%%%% back to duo-stable %%%%%%%%%%%%%%%%%%
  // UB1
  // transition(SS_SS_UB1, Unblock_not_all) {
  //   br_removeBlockedSharer;
  //   dpu_decrementPendingUBs;
  //   k_popUnblockQueue;

  //   uur_profileDirRead;
  //   uur_profileTagRead;
  // }
  transition(SS_SS_UB1, Unblock, SS_SS) {
    nnu_addSharerFromUnblock;
    s_deallocateTBE;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  
  // transition(SS_L2ONLY_UB1, Unblock_not_all) {
  //   br_removeBlockedSharer;
  //   dpu_decrementPendingUBs;
  //   k_popUnblockQueue;

  //   uur_profileDirRead;
  //   uur_profileTagRead;
  // }
  transition(SS_L2ONLY_UB1, Unblock, SS_L2ONLY) {
    nnu_addSharerFromUnblock;
    s_deallocateTBE;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }

  // UB2
  transition(SS_SS_UB2, Unblock_not_all2) {
    nnus_addSecondarySharerFromUnblock;
    br_removeBlockedSharer;
    dpu_decrementPendingUBs;
    k_popUnblockQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(SS_SS_UB2, Unblock2, SS_SS) {
    nnus_addSecondarySharerFromUnblock;
    s_deallocateTBE;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  
  transition(L2ONLY_SS_UB2, Unblock_not_all2) {
    nnus_addSecondarySharerFromUnblock;
    br_removeBlockedSharer;
    dpu_decrementPendingUBs;
    k_popUnblockQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(L2ONLY_SS_UB2, Unblock2, L2ONLY_SS) {
    nnus_addSecondarySharerFromUnblock;
    s_deallocateTBE;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }

  transition(MTSB_SS_UB2, Unblock_not_all2) {
    nnus_addSecondarySharerFromUnblock;
    br_removeBlockedSharer;
    dpu_decrementPendingUBs;
    k_popUnblockQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(MTSB_SS_UB2, Unblock2, MTSB_SS) {
    nnus_addSecondarySharerFromUnblock;
    s_deallocateTBE;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileTagRead;
  }


