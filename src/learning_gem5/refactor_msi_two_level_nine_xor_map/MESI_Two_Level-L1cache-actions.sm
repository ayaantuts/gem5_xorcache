        out_msg.AckCount := 1;
        out_msg.DataBlk := tbe.DataBlk;
        out_msg.Dirty := tbe.Dirty;
      }
    }
  }


  
  action(hx_load_hit_dynamic, "hxdynamic", desc="Notify sequencer the load completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    peek(responseL1Network_in, ResponseMsg) {
      if (in_msg.l2_hit_miss_path == L2HitMissPath:MISS) {
        sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:Memory, L2HitMissPath:MISS); // L1 read miss serviced by mem
      } else if (in_msg.l2_hit_miss_path == L2HitMissPath:DIRECT) {
        sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECT); // L1 read miss serviced by l2
      } else {
        error("<hx_load_hit_dynamic> unknown l2 hit miss path");
      }
    }
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }
  ////////////////////////// l2 serviced load miss //////////////////////////
  action(hx_load_hit_l2resp_pb, "hxl2pb", desc="Notify sequencer the load completed;l2 is the responder; pb")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:PB); // L1 miss
    DPRINTF(RubySlicc, "after callback %s; L2 SERVICED (PB)\n", cache_entry.DataBlk);
  }
