  action(set_l2_hit_miss_path_unxor_conditionally, "setpUC", desc="set l2 hit miss path") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(tbe));
      if (in_msg.l2_hit_miss_path == L2HitMissPath:L1COHERENCEUNXOR) {
        tbe.l2_hit_miss_path := L2HitMissPath:L1COHERENCEUNXOR;
        DPRINTF(RubySlicc, "set l2 hit miss path %s\n", in_msg.l2_hit_miss_path);
      }
    }
  }
  action(set_l2_hit_miss_path_direct, "setpMD", desc="set l2 hit miss path") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.l2_hit_miss_path := in_msg.l2_hit_miss_path;
      DPRINTF(RubySlicc, "set l2 hit miss path %s\n", in_msg.l2_hit_miss_path);
      assert(tbe.l2_hit_miss_path == L2HitMissPath:DIRECT || 
        tbe.l2_hit_miss_path == L2HitMissPath:DIRECTUNXOR);
    }
  }
  action(set_l2_hit_miss_path_coh, "setpCOH", desc="set l2 hit miss path") {
    assert(is_valid(tbe));
    tbe.l2_hit_miss_path := L2HitMissPath:L1COHERENCE;
    DPRINTF(RubySlicc, "set l2 hit miss path %s\n", tbe.l2_hit_miss_path);
  }
  action(ds_sendDataSToRequestor, "ds", desc="send dataS to requestor") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, L1Dcache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAS;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        DPRINTF(RubySlicc, "ds_sendDataSToRequestor %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
      }
    }
  }
  action(dst_sendDataSToRequestor_fromTBE, "dst", desc="send dataS to requestor") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, tbe_latency) {
        assert(is_valid(tbe));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAS;
        out_msg.DataBlk := tbe.DataBlk;
        out_msg.Dirty := tbe.Dirty;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        DPRINTF(RubySlicc, "dst_sendDataSToRequestor_fromTBE %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
      }
    }
  }
  action(fi_sendInvAckData, "fid", desc="send data to the L2 cache") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, L1Dcache.getDataLatency()) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACKDATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := 1;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        DPRINTF(RubySlicc, "fi_sendInvAckData %#x, DataBlk=%s\n",
          address, cache_entry.DataBlk);
      }
    }
  }
