    sequencer.readCallback(address, cache_entry.DataBlk, true, MachineType:Memory); // L1 miss
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }
  action(hhx_store_hit_dynamic, "\hxdynamic", desc="Notify sequencer that store completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    peek(responseL1Network_in, ResponseMsg) {
      if (in_msg.l2_hit_miss_path == L2HitMissPath:MISS) {
        sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:Memory, L2HitMissPath:MISS);
      } else if (in_msg.l2_hit_miss_path == L2HitMissPath:DIRECT) {
        sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECT);
      } else if (in_msg.l2_hit_miss_path == L2HitMissPath:DIRECTUNXOR) {
        sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECTUNXOR);
      } else {
        DPRINTF(RubySlicc, "in_msg.l2_hit_miss_path %s, ADDR: %llx\n", in_msg.l2_hit_miss_path, address);
        error("<hhx_store_hit_dynamic> unknown l2 hit miss path");
      }
    }
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  action(hhx_store_hit_dynamic_tbe, "\hxdynamicTBE", desc="Notify sequencer that store completed.")
  {
    assert(is_valid(cache_entry));
    assert(is_valid(tbe));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    // Request misses and new replacement policy info is set for new entry.
    // No need to setMRU on external hit.
    if (tbe.l2_hit_miss_path == L2HitMissPath:DIRECT) {
      sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECT); 
    } else if (tbe.l2_hit_miss_path == L2HitMissPath:DIRECTUNXOR) {
      sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L2Cache, L2HitMissPath:DIRECTUNXOR); 
    } else if (tbe.l2_hit_miss_path == L2HitMissPath:L1COHERENCE) {
      sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L1Cache, L2HitMissPath:L1COHERENCE); 
    } else if (tbe.l2_hit_miss_path == L2HitMissPath:L1COHERENCEUNXOR) {
      sequencer.writeCallback(address, cache_entry.DataBlk, true, MachineType:L1Cache, L2HitMissPath:L1COHERENCEUNXOR); 
    } else {
        DPRINTF(RubySlicc, "in_msg.l2_hit_miss_path %s, ADDR: %llx\n", tbe.l2_hit_miss_path, address);
        error("<hhx_store_hit_dynamic_tbe> unknown l2 hit miss path");
    }
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  ////////////////////////// l2 serviced store miss //////////////////////////
  action(hhx_store_hit_l2resp_pb, "\hxl2pb", desc="Notify sequencer that store completed; l2 is the responder; PB")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
