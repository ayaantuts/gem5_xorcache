  action(u_writeDataToL1Cache_PB, "uPB", desc="Write data to cache") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));

      // DataBlock pb := getDataBlock(in_msg.piggybacked_addr);
      // DPRINTF(RubySlicc, "read pb block (0x%llx)\n", in_msg.piggybacked_addr);
      // assert(is_valid(getCacheEntry(in_msg.piggybacked_addr))); // tbe should be valid
      
      // DPRINTF(RubySlicc, "xorer: %s\n", in_msg.DataBlk);
      // DataBlock dataBlk := dataProcL1.preprocess(pb, in_msg.DataBlk);
      // DPRINTF(RubySlicc, "after xor: %s\n", dataBlk);
      cache_entry.DataBlk := in_msg.DataBlk;
      cache_entry.Dirty := in_msg.Dirty;
      DPRINTF(RubySlicc, "%llx dirty to (%d) in cache from in_msg\n", address, in_msg.Dirty);
    }
  }
  