// %%%%%%%%%%%%%%%%%%%%%% outof XOR %%%%%%%%%%%%%%%%%%%%%% 
//  ==== PUT ====
  transition(L2ONLY_SS, L1_PUTS_last2, L2ONLY_SS_s) { 
    // expand from 1 to 2 entries
    tn_sendWBNack;
    aad_allocateData; // allocate new for secondary
    expand_data1; // expand original block to full size to overprovision

    jj_popL1RequestQueue;

    uur_profileDirRead;
  }
  transition(L2ONLY_SS_s, L1_PUTS_last_data2, L2ONLY) { 
    entropy_rm_xor_data;
    entropyXOR_rm_xor_data;

    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    aadns1_allocateDataNS;
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest;

    mpxr_writePhyDataToCache_XOR_fromRequest; // recover because primary needs to be recovered

    update_data1;
    entropy_reg_primary_data; // add primary toward entropy calculation

    update_data2;
    entropy_reg_secondary_data; // add secondary toward entropy calculation
    
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    l2a2_allocateL2;
    set_secondary_as_cache_entry; // implicitly transition to L2ONLY
    // l2set2_l2only; // secondary: SS -> L2ONLY
    l2set1_l2only; // primary: L2ONLY

    aast1_allocateSingularTag_primary;
    aast2_allocateSingularTag_secondary;

    dmt_insert_fromCache2;
    dmtNS_insert_fromCache2;
    dmt_insert_fromCache1;
    dmtNS_insert_fromCache1;


    t_sendWBAck;
    jj_popL1RequestQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
  }
  
  transition(L2ONLY_SS, L1_PUTX2, L2ONLY_SS_s) { //NOTE: It's possible to receive old PUTX at SS state
    // expand from 1 to 2 entries
    tn_sendWBNack;
    aad_allocateData; // allocate new for secondary
    expand_data1; // expand original block to full size to overprovision

    jj_popL1RequestQueue;

    uur_profileDirRead;
  }
  

  transition(SS_L2ONLY, L1_PUTS_last, SS_L2ONLY_s) { 
    tn_sendWBNack;
    aad2_allocateData;// allocate new for secondary
    expand_data1; // expand original block to full size to overprovision

    jj_popL1RequestQueue;

    uur_profileDirRead;
  }
  transition(SS_L2ONLY_s, L1_PUTS_last_data, L2ONLY) { 
    entropy_rm_xor_data;
    entropyXOR_rm_xor_data;

    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    aadns2_allocateDataNS;
    ll_clearSharers;

    mlr1_writeLogicalDataToCacheFromRequest;

    mpr_writePhyDataToCache_fromRequest; // directly write because primary needs to be remained

    update_data1;
    entropy_reg_primary_data; // add primary toward entropy calculation

    update_data2;
    entropy_reg_secondary_data;

    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    l2a2_allocateL2;
    l2set2_l2only;
    // l2set1_l2only; // implicitly transition to L2ONLY

    aast1_allocateSingularTag_primary;
    aast2_allocateSingularTag_secondary;

    dmt_insert_fromCache1;
    dmtNS_insert_fromCache1;
    dmt_insert_fromCache2;
    dmtNS_insert_fromCache2;


    t_sendWBAck;
    jj_popL1RequestQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
  }
  
  transition(SS_L2ONLY, L1_PUTX, L2ONLY) { //NOTE: It's possible to receive old PUTX at SS state
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    aadns2_allocateDataNS;
    ll_clearSharers;

    mlr1_writeLogicalDataToCacheFromRequest;

    entropy_rm_xor_data;
    entropyXOR_rm_xor_data;

    mpr_writePhyDataToCache_fromRequest; // directly write because primary needs to be remained

    update_data1;
    entropy_reg_primary_data; // add primary toward entropy calculation
    
    aad2_allocateData_size_accordingly;
    entropy_reg_secondary_data; // add secondary toward entropy calculation


    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    l2a2_allocateL2;
    l2set2_l2only;
    // l2set1_l2only; // implicitly transition to L2ONLY

    aast1_allocateSingularTag_primary;
    aast2_allocateSingularTag_secondary;

    dmt_insert_fromCache1;
    dmtNS_insert_fromCache1;
    dmt_insert_fromCache2;
    dmtNS_insert_fromCache2;


    t_sendWBAck;
    jj_popL1RequestQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
  }

  

  
  
  //  ==== replace ====
  transition({SI_L2ONLY_r1, SI_SS_r1, I_I_sm, I_I_s}, Ack) { 
    q_updateAck;
    o_popIncomingResponseQueue;
    uur_profileDirRead;
  }
  transition({SS_SI_r2, L2ONLY_SI_r2}, Ack2) { 
    q_updateAck;
    o_popIncomingResponseQueue;
    uur_profileDirRead;
  }



  transition(SS_SS, L2_Replacement_clean, I_I_s) { 
    i_allocateTBE;
    buf_secondary;

    ddt_deallocateTag; // primary
    dddir_deallocateDir; // primary

    entropy_rm_xor_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    entropyXOR_rm_xor_data;

    expand_data1; //overprovision
    change_data_addr_from_primary_to_secondary;

    fsn1_sendInvSpecialToSharers_newest;
    fr1_sendInvToSharers_rest;
    // secondary block data needs to be recovered => L2ONLY_s
    // primary block gone => I_I_s
    l2a2_allocateL2_preservingPhy; // removed xored block from entropy calculation
    l2set2_sss;

    xor_unpair;
    ddl21_deallocateL2CacheBlock;
    
    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  
  transition(SS_SS, L2_Replacement_clean2, I_I_s) { 
    i2_allocateTBE;
    set_secondary_as_tbe;
    buf_primary; // since unpairing now

    ddt_deallocateTag; // secondary
    dddir_deallocateDir; // secondary

    entropy_rm_xor_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    entropyXOR_rm_xor_data;

    // primary block data needs to be recovered => L2ONLY_s
    // secondary block gone => I_I_s
    fsn2_sendInvSpecialToSharers_newest;
    fr2_sendInvToSharers_rest;
    l2set1_sss;
    expand_data1; //overprovision

    usc;
    xor_unpair;
    
    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }

  transition(I_I_s, Ack_Data, I_I_sm) {
    q_updateAck;

    mpxp_processWritePhyDataToPairedCache;
    update_data_paired;
    entropy_reg_paired_data;

    o_popIncomingResponseQueue;

    uur_profileDataRead;
  }
  transition(I_I_sm, Ack_all, M_I) {//TODO:
    l2_setPairedStateBack;

    aastp_allocateSingularTag_paired;
    dmt_insert_fromCache_paried;
    c_exclusiveCleanReplacement;
    o_popIncomingResponseQueue;
    kdp_wakeUpDependents;

    uur_profileDMTRead;
  }
  transition(I_I_s, Ack_Data_all, M_I) {//TODO:
    // recover data in secondary block and 
    // set secondary block to L2ONLY/SS
    mpxp_processWritePhyDataToPairedCache;
    update_data_paired;
    entropy_reg_paired_data;

    l2_setPairedStateBack;

    aastp_allocateSingularTag_paired;
    dmt_insert_fromCache_paried;
    c_exclusiveCleanReplacement;
    o_popIncomingResponseQueue;
    kdp_wakeUpDependents;

    uur_profileDataRead;
    uur_profileDMTRead;
  }

  transition(SS_SS, {L2_Replacement, MEM_Inv}, SI_SS_r1) {
    i_allocateTBE;

    ddt_deallocateTag;
    dddir_deallocateDir;
    
    entropy_rm_xor_data;

    expand_data1; //overprovision
    change_data_addr_from_primary_to_secondary;

    fsn1_sendInvSpecialToSharers_newest;
    fr1_sendInvToSharers_rest;
    
    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SI_SS_r1, Ack_Data, S_I) { 
    entropyXOR_rm_xor_data;
    q_updateAck;

    mpx_writePhyDataToCache_XOR_noUpdate;

    update_data2;
    entropy_reg_secondary_data;

    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    qq_writeDataToTBE;

    aaststs2_allocateSingularTagBoth_secondary;
    dmt_insert_fromCache2;
    dmtS_insert_fromCache2;

    l2a2_allocateL2;
    l2set2_ss;
    ooo_run_xor2;

    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;
    xor_unpair;
    ddl21_deallocateL2CacheBlock;

    uur_profileDataRead;
    uur_profileDMTRead;
  }
  transition(SI_SS_r1, Ack_Data_all, M_I) { 
    entropyXOR_rm_xor_data;
    mpx_writePhyDataToCache_XOR_noUpdate;

    update_data2;
    entropy_reg_secondary_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    qq_writeDataToTBE;
    ct_exclusiveReplacementFromTBE;

    aaststs2_allocateSingularTagBoth_secondary;
    dmt_insert_fromCache2;
    dmtS_insert_fromCache2;

    l2a2_allocateL2;
    l2set2_ss;
    ooo_run_xor2;

    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;
    xor_unpair;
    ddl21_deallocateL2CacheBlock;

    uur_profileDataRead;
    uur_profileDMTRead;
  }

  transition(SS_SS, {L2_Replacement2, MEM_Inv2}, SS_SI_r2) {
    i2_allocateTBE;
    set_secondary_as_tbe;

    ddt_deallocateTag;
    dddir_deallocateDir;

    entropy_rm_xor_data;

    fsn2_sendInvSpecialToSharers_newest;
    fr2_sendInvToSharers_rest;

    expand_data1; //overprovision
    
    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SS_SI_r2, Ack_Data2, S_I) { 
    entropyXOR_rm_xor_data;
    q_updateAck;

    mpx_writePhyDataToCache_XOR_noUpdate;

    qq_writeDataToTBE;
    update_data1;
    entropy_reg_primary_data; // add primary toward entropy calculation

    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    aaststs1_allocateSingularTagBoth_primary;
    dmt_insert_fromCache1;
    dmtS_insert_fromCache1;
    l2set1_ss;
    ooo_run_xor1;

    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    xor_unpair;
    usc;

    uur_profileDataRead;
    uur_profileDMTRead;
  }
  transition(SS_SI_r2, Ack_Data_all2, M_I) { 
    entropyXOR_rm_xor_data;
    mpx_writePhyDataToCache_XOR_noUpdate;

    qq_writeDataToTBE;
    update_data1;
    entropy_reg_primary_data; // add primary toward entropy calculation

    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    ct_exclusiveReplacementFromTBE;

    aaststs1_allocateSingularTagBoth_primary;
    dmt_insert_fromCache1;
    dmtS_insert_fromCache1;
    l2set1_ss;
    ooo_run_xor1;

    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    xor_unpair;
    usc;

    uur_profileDataRead;
    uur_profileDMTRead;
  }
  


  transition(SS_L2ONLY, L2_Replacement_clean, I_I_s) {
    entropyXOR_rm_xor_data;
    i_allocateTBE;
    buf_secondary;

    ddt_deallocateTag; // primary
    dddir_deallocateDir; // primary

    entropy_rm_xor_data;

    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    expand_data1; //overprovision
    change_data_addr_from_primary_to_secondary;

    fsn1_sendInvSpecialToSharers_newest;
    fr1_sendInvToSharers_rest;
    // secondary block data needs to be recovered => L2ONLY_s
    // primary block gone => I_I_s
    l2a2_allocateL2_preservingPhy;
    l2set2_l2onlys;

    xor_unpair;
    ddl21_deallocateL2CacheBlock;
    
    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
