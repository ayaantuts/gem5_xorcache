  transition({L2ONLY_IS, L2ONLY_SS, SS_SS}, L1_PUTS_old2) {
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
  }

// %%%%%%%%%%%%%%%%%%%%%% into XOR %%%%%%%%%%%%%%%%%%%%%%
  
  // using secondary addr, primary (candidate) block
  transition(SS, Goto_SS_SS, SS_SS) { 
    check_phy;
    ddd_deallocateData;

    ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;
    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;

    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;

    cj_clearStallCount;

    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(SS, Goto_SS_MTSB, SS_MTSB) { 
    check_phy;
    ddd_deallocateData;

    ddststs1_deallocateSTSTS;
    // ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;
    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(L2ONLY, Goto_L2ONLY_SS, L2ONLY_SS) { 
    check_phy;
    ddd_deallocateData;

    ddst1_deallocateST;
    ddststs_deallocateSTSTS;

    dmt_rm1;
    dmtNS_rm1;
    dmt_rm2;
    dmtS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    dddns1_deallocateDataNS; // primary is no longer nonshared due to xor
    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(L2ONLY, Goto_L2ONLY_MTSB, L2ONLY_MTSB) { 
    check_phy;
    ddd_deallocateData;

    ddst1_deallocateST;
    // ddststs_deallocateSTSTS;
    
    dmt_rm1;
    dmtNS_rm1;
    dmt_rm2;
    dmtS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    dddns1_deallocateDataNS; // primary is no longer nonshared due to xor
    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(MT_SB,Goto_MTSB_SS, MTSB_SS) {
    check_phy;
    ddd_deallocateData;

    // ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;

    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(MT_SB,Goto_MTSB_MTSB, MTSB_MTSB) {
    check_phy;
    ddd_deallocateData;

    // ddststs1_deallocateSTSTS;
    // ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(MT_SB,Goto_MTSB_L2ONLY, MTSB_L2ONLY) {
    check_phy;
    ddd_deallocateData;
    dddns_deallocateDataNS;

    ddst2_deallocateST;

    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtNS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(SS, Goto_SS_L2ONLY, SS_L2ONLY) {
    check_phy;
    ddd_deallocateData;
    dddns_deallocateDataNS;

    ddststs1_deallocateSTSTS;
    ddst2_deallocateST;

    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtNS_rm2;

    populate_secondary_logical_data;
    
    entropy_rm_primary_data;
    entropy_rm_secondary_data;

    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    ppp_populatePhyData_fromBlk1and2;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    ddl2_deallocateL2CacheBlock;
    set_primary_as_cache_entry;

    cj_clearStallCount;
    js_popTriggerQueue_success; //success

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  
  
  transition(SS_IS, Mem_Data2, SS_SS) { // already run xor algorithm
    ml2_writeLogicalDataToCache;

    entropy_rm_xor_data;
    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data2;

    mpx_writePhyDataToCache_XOR_compress_update;

    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    el2_sendLogicalDataToGetSRequestors;

    // just in case ST has not been deallocated
    ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;

    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }

  transition(MTSB_IS, Mem_Data2, MTSB_SS) { // already run xor algorithm
    ml2_writeLogicalDataToCache;

    entropy_rm_xor_data;
    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data2;

    mpx_writePhyDataToCache_XOR_compress_update;
    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    el2_sendLogicalDataToGetSRequestors;

    // just in case ST has not been deallocated
    // ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;
    kd1_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(MTSB_SS, Unblock, SS_SS) {
    nnu_addSharerFromUnblock;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
  }
  transition(MTSB_MTSB, Unblock, SS_MTSB) {
    nnu_addSharerFromUnblock;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
  }
  transition(L2ONLY_MTSB, Unblock2, L2ONLY_SS) {
    nnus_addSecondarySharerFromUnblock;
    k_popUnblockQueue;
    kd2_wakeUpDependents;
    kd1_wakeUpDependents;

    uur_profileDirRead;
  }
  transition(SS_MTSB, Unblock2, SS_SS) {
    nnus_addSecondarySharerFromUnblock;
    k_popUnblockQueue;
    kd2_wakeUpDependents;
    kd1_wakeUpDependents;

    uur_profileDirRead;
  }
  transition(MTSB_MTSB, Unblock2, MTSB_SS) {
    nnus_addSecondarySharerFromUnblock;
    k_popUnblockQueue;
    kd2_wakeUpDependents;
    kd1_wakeUpDependents;

    uur_profileDirRead;
  }


  transition(SS, L1_PUTX_XOR, SS_L2ONLY) { 
    check_phy;
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aat_allocateTag;
    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    ddl2_deallocateL2CacheBlock;
    
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest;

    entropy_rm_xor_data;
    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data2;
    
    mpxr_writePhyDataToCache_XOR_fromRequest_compress_update;
    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }


  transition(IS, L1_PUTX_XOR, IS_L2ONLY) {
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aat_allocateTag;
    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    ddl2_deallocateL2CacheBlock;
    
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest; 

    mpr_writePhyDataToCache_fromRequest; // no processing yet, need processing when primary data is arrived
    entropy_reg_xor_data;


    
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(IS_L2ONLY, Mem_Data, SS_L2ONLY) { // already run xor algorithm
    ml1_writeLogicalDataToCache;

    entropy_rm_xor_data;
    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data;

    mpx_writePhyDataToCache_XOR_compress_update;
    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    el1_sendLogicalDataToGetSRequestors;


    s_deallocateTBE; // primary
    set_primary_as_cache_entry;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }

  transition(MT_SB, L1_PUTX_XOR, MTSB_L2ONLY) {
    check_phy;
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aat_allocateTag;
    // ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    ddl2_deallocateL2CacheBlock;
    
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest; 

    entropy_rm_xor_data;
    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data2;

    mpxr_writePhyDataToCache_XOR_fromRequest_compress_update;
    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;
    
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(MTSB_L2ONLY, Unblock, SS_L2ONLY) {
    nnu_addSharerFromUnblock;
    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
  }


  transition(L2ONLY, {L1_GETS_XOR, L1_GET_INSTR_XOR},  L2ONLY_IS) {
    aadir_allocateDir;
    aat_allocateTag;
    set1_tagMRU;
    set1_dataMRU;
    ddst1_deallocateST;
    dddns_deallocateDataNS;
    dmt_rm1;
    dmtNS_rm1;
    dmt_rm2;
    dmtS_rm2;

    lls_clearSecondarySharers;
    nns_addSecondarySharer;

    i_allocateTBE;
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(L2ONLY_IS, Mem_Data2, L2ONLY_SS) {  // already run xor algorithm
    ml2_writeLogicalDataToCache;

    entropy_rm_xor_data;
    entropyRaw_reg_primary_data;
    entropyRaw_reg_secondary_data2;

    mpx_writePhyDataToCache_XOR_compress_update;
    entropy_reg_xor_data;
    entropyXOR_reg_xor_data;

    el2_sendLogicalDataToGetSRequestors;

    // just in case ST has not been deallocated
    ddst1_deallocateST;
    ddststs_deallocateSTSTS;
    // dddns1_deallocateDataNS;
    dmt_rm1;
    dmtNS_rm1;
    dmt_rm2;
    dmtS_rm2;

    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }



// %%%%%%%%%%%%%%%%%%%%%% internal %%%%%%%%%%%%%%%%%%%%%%
// ==== PUT ====
  // ss_ss
  transition(SS_SS, L1_PUTS_last, L2ONLY_SS) { 
    // nothing changes entropy
    dddir_deallocateDir;
    aatns_allocateTagNS;
    ll_clearSharers;
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SS_SS, L1_PUTS_not_last) {
    l_removeSharer;
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
