    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }

  transition(L2ONLY_SS, L2_Replacement_clean, M_I) { 
