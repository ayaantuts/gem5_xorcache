  // ss_ss
  transition(SS_SS, {L1_GETS2_pb, L1_GET_INSTR2_pb}) {
    ds2pb1_sendSharedData2ToRequestor_piggyback1; 
    
    nns_addSecondarySharer;

    set_tagMRU;
    set1_tagMRU;
    set1_dataMRU;
    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDataRead;
