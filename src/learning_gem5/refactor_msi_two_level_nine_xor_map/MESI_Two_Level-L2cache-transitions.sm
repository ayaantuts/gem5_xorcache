    // mmsu_markSecondaryExclusiveFromUnblock;
    mmu_markExclusiveFromUnblock;
    ooo_run_xor1;


    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }

  transition(L2ONLY_SS, L1_UPGRADE2, L2ONLY_SSMB_s) { 
    // nothing changes entropy
    ddt_deallocateTag;

    expand_data1; // overprovision
    fwm2_sendFwdInvToSharersMinusRequestor;
    tsS2_sendInvAckSToUpgrader;

    set_dirMRU;
    uu_profileHit;

    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }

  // SS_L2ONLY
  transition(SS_L2ONLY, L1_GETX2_pb, SS_SSMB_s) { 
    // nothing changes entropy
    expand_data1; // overprovision
    d2pb1_sendData2ToRequestor_piggyback1;
    ddt_deallocateTag;
    ddtns_deallocateTagNS;
    aadir2_allocateDir;

    set_tagMRU;
    set1_dataMRU;
    set_dirMRU;

    uu_profileHit;


    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }

  transition(SS_L2ONLY, L1_GETX2_recon, SS_L2ONLY_s) {
    ddt_deallocateTag;
    aadir_allocateDir;
    ddtns_deallocateTagNS;

    srx1_sendReconstructXToSharer;

    set_tagMRU;
    set_dataMRU;
    expand_data1; // overprovision

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  transition(SS_L2ONLY_s, Recover_Data, SS) { //primary should have enough space
    entropyXOR_rm_xor_data;
    aaststs1_allocateSingularTagBoth_primary;
    dmt_insert_fromCache1;
    dmtS_insert_fromCache1;

    entropy_rm_xor_data;
    mp_writePhyDataToCache_compress_update;

    update_data1;
    entropy_reg_primary_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    l2a2_allocateL2;
    set_primary_as_cache_entry; // will implicitly transition to SS
    
    l2set2_mb;
    ooo_run_xor1;

    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }
  transition(SS_L2ONLY_s, Exclusive_Unblock2, MT) {
    entropyXOR_rm_xor_data;
    entropy_rm_xor_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    l2a2_allocateL2;
    l2set1_sss;
    set_secondary_as_cache_entry;
    mmu_markExclusiveFromUnblock;

    // mmsu_markSecondaryExclusiveFromUnblock;
    k_popUnblockQueue;
    kd_wakeUpDependents;
    xor_unpair;
    // usc;

    uur_profileDirRead;
    uur_profileTagRead;
  }

  transition(SS_L2ONLY, L1_GETX_fwd, SSMB_L2ONLY_s) {
    ddt_deallocateTag;
    expand_data1; // overprovision
    change_data_addr_from_primary_to_secondary;
    

    fwr1_sendFwdReqInvToSharers;
    fwmn1_sendFwdInvToSharersMinusNewest;

    set_dirMRU;
    uu_profileHit;

    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SSMB_L2ONLY_s, Exclusive_Unblock_Data, MT) { 
    entropyXOR_rm_xor_data;
    entropy_rm_xor_data;

    mpub_processWriteDataToCache_fromUblock; // adding recovered data (secondary) toward entropy calculation
    
    update_data2;
    entropy_reg_secondary_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    aast2_allocateSingularTag_secondary;
    aadns2_allocateDataNS;
    dmt_insert_fromCache2;
    dmtNS_insert_fromCache2;

    l2a2_allocateL2;
    l2set2_l2only;
    set_primary_as_cache_entry;
    mmu_markExclusiveFromUnblock;
    ooo_run_xor2;

    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }

  transition(SS_L2ONLY, L1_UPGRADE, SSMB_L2ONLY_s) { 
    // nothing changes entropy
    ddt_deallocateTag;
    
    expand_data1; // overprovision
    change_data_addr_from_primary_to_secondary;

    fwm_sendFwdInvToSharersMinusRequestor;
    tsS_sendInvAckSToUpgrader;

    set_dirMRU;
    uu_profileHit;

    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }

  // L2ONLY_IS
  transition(L2ONLY_IS, {L1_GETX_recon, L1_GETX_pb}, SS_OR_MT_MB) { // just undo pairing
    entropyXOR_rm_xor_data;
    aadir_allocateDir;
    ddtns_deallocateTagNS;
    ddt_deallocateTag;

    entropy_rm_xor_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    
    change_data_addr_from_primary_to_secondary;

    d_sendDataToRequestor;
    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set2_is;
    set_primary_as_cache_entry;

    aaststs2_allocateSingularTagBoth_secondary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  // SS_IS
  transition(SS_IS, {L1_GETX_fwd}, SS_OR_MT_MB) {// just undo pairing
    entropyXOR_rm_xor_data;
    ddt_deallocateTag;
    
    entropy_rm_xor_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;



    change_data_addr_from_primary_to_secondary;

    set_dirMRU;
    d_sendDataToRequestor;
    fwm_sendFwdInvToSharersMinusRequestor;

    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set2_is;
    set_primary_as_cache_entry;

    aaststs2_allocateSingularTagBoth_secondary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(SS_IS, {L1_GETX_pb}, SS_OR_MT_MB) {// just undo pairing
    entropyXOR_rm_xor_data;
    ddt_deallocateTag;
    
    entropy_rm_xor_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;

    
    change_data_addr_from_primary_to_secondary;

    set_dirMRU;
    d_sendDataToRequestor;
    fwm_sendFwdInvToSharersMinusRequestor;

    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set2_is;
    set_primary_as_cache_entry;

    aaststs2_allocateSingularTagBoth_secondary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  transition(SS_IS, L1_UPGRADE, SS_OR_MT_MB) { // just undo pairing
    entropyXOR_rm_xor_data;
    ddt_deallocateTag;

    entropy_rm_xor_data;
    entropyRaw_rm_secondary_data;
    entropyRaw_rm_primary_data;


    change_data_addr_from_primary_to_secondary;

    set_dirMRU;
    fwm_sendFwdInvToSharersMinusRequestor;
    ts_sendInvAckToUpgrader;

    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set2_is;
    set_primary_as_cache_entry;

    aaststs2_allocateSingularTagBoth_secondary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;
  }

// %%%%%%%%%%%%%%%%%%%%%% stalling %%%%%%%%%%%%%%%%%%%%%%
  // repl
  transition({IS_IS, L2ONLY_SS_s, L2ONLY_SS_r1, L2ONLY_SI_r2, L2ONLY_SSMB_s, SS_SSMB_s, SSMB_L2ONLY_s, SSMB_SS_s
    SS_L2ONLY_s, SS_L2ONLY_r2, L2ONLY_MTSB, SS_MTSB
    SI_SS_r1, SS_SI_r2, L2ONLY_SI_dd, L2ONLY_II_dc, II_L2ONLY_cd, SI_L2ONLY_dc, SI_MI_dc,
    SI_L2ONLY_r1, SI_L2ONLY_dd}, 
    {L2_Replacement, L2_Replacement_clean, 
    L2_Replacement2, L2_Replacement_clean2, 
    L2_Replacement_data_dirty_dirty, L2_Replacement_data_clean_clean,
    L2_Replacement_data_clean_dirty, L2_Replacement_data_dirty_clean}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({IS_IS, L2ONLY_SS_s, L2ONLY_SS_r1, L2ONLY_SI_r2, L2ONLY_SSMB_s, SS_SSMB_s, SSMB_L2ONLY_s, SSMB_SS_s
    SS_L2ONLY_s, SS_L2ONLY_r2, L2ONLY_MTSB,
    SI_SS_r1, SS_SI_r2, L2ONLY_SI_dd, L2ONLY_II_dc, II_L2ONLY_cd, SI_L2ONLY_dc, SI_MI_dc,
    SI_L2ONLY_r1, SI_L2ONLY_dd}, 
    {MEM_Inv, MEM_Inv2}) {
    zn_recycleResponseNetwork;
  }

  transition({L2ONLY_IS, SS_IS, IS_L2ONLY, IS_SS, MTSB_SS, MTSB_L2ONLY, MTSB_IS}, {L2_Replacement_data_dirty_clean, L2_Replacement_data_dirty_dirty, 
    L2_Replacement_data_clean_clean, L2_Replacement_data_clean_dirty}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({IS_L2ONLY, IS_SS, MTSB_SS}, {L2_Replacement_clean, L2_Replacement}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({SS_IS, L2ONLY_IS,MTSB_L2ONLY,MTSB_SS}, {L2_Replacement_clean2, L2_Replacement2}) {
    zz_stallAndWaitL1RequestQueue;
  }


  transition({IS_L2ONLY, IS_SS, MTSB_SS, MTSB_L2ONLY, MTSB_IS}, {MEM_Inv}) {
    zn_recycleResponseNetwork;
  }
  transition({SS_IS, L2ONLY_IS, MTSB_IS}, {MEM_Inv2}) {
    zn_recycleResponseNetwork;
  }

  // put
  transition({L2ONLY_SI_dd, L2ONLY_II_dc, II_L2ONLY_cd, SI_L2ONLY_dc, SI_L2ONLY_dd, SI_SI_dd, SI_II_dc, II_SI_cd, SI_MI_dc, SI_MI_dd, II_MI_cd, 
    SI_L2ONLY_r1, SI_SS_r1, L2ONLY_SS_r1, L2ONLY_SI_r2, SS_L2ONLY_r2, SS_SI_r2, SSMB_SS_s, SS_SSMB_s, SS_L2ONLY_s, L2ONLY_SS_s, SSMB_L2ONLY_s, L2ONLY_SSMB_s,
    L2ONLY_MTSB,MTSB_MTSB}, 
    {L1_PUTS_last, L1_PUTS_last2, L1_PUTS_not_last,L1_PUTS_not_last2}) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition(SS_MTSB, L1_PUTS_last2) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({IS_SS, IS_L2ONLY, SS_MTSB}, {L1_PUTS_last}) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({SS_L2ONLY,L2ONLY_SS}, L1_PUTS_old) {
    t_sendWBAck;
    jj_popL1RequestQueue;
  }

  transition({L2ONLY_MTSB}, L1_PUTS_old2) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({MTSB_SS,MTSB_L2ONLY}, L1_PUTS_last) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({SSMB_L2ONLY_s, SSMB_SS_s, SS_L2ONLY_s, SS_SSMB_s, 
    SI_L2ONLY_r1, SI_L2ONLY_dd, SI_SS_r1, SS_L2ONLY_r2, SI_II_dc,SI_L2ONLY_dc}, L1_PUTX_not_last) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({L2ONLY_SSMB_s, SS_SSMB_s, L2ONLY_SS_s,SSMB_SS_s,
    L2ONLY_SS_r1, L2ONLY_SI_r2, 
    L2ONLY_SI_dd}, L1_PUTX_not_last2) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({L2ONLY_SSMB_s, SS_SSMB_s,L2ONLY_MTSB,SS_MTSB,L2ONLY_SS_s,L2ONLY_SS_r1}, L1_PUTX2) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({L2ONLY_SS, L2ONLY_IS, SS_L2ONLY, SS_IS, SS_SS}, L1_PUTX_old) {
    t_sendWBAck;
    jj_popL1RequestQueue;
  }
  transition({MTSB_SS, MTSB_L2ONLY, MTSB_IS, S_I_s}, L1_PUTX_old) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({SSMB_SS_s, SSMB_L2ONLY_s, SI_L2ONLY_dd,MTSB_L2ONLY,MTSB_SS}, L1_PUTX) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({SSMB_L2ONLY_s, SSMB_SS_s, SS_SSMB_s, SI_L2ONLY_r1, L2ONLY_SS_r1, L2ONLY_SSMB_s, IS_L2ONLY, SS_L2ONLY_s}, {L1_PUTX_old}) {
    zz_stallAndWaitL1RequestQueue;
  }


  // get

  transition({MTSB_SS,SS_MTSB}, {L1_GETS_pb, L1_GET_INSTR_pb, L1_GETX_pb, L1_GETS_fwd, L1_GET_INSTR_fwd, L1_GETX_fwd, L1_UPGRADE,
    L1_GETS2_pb, L1_GET_INSTR2_pb, L1_GETX2_pb, L1_GETS2_fwd, L1_GET_INSTR2_fwd,L1_GETX2_fwd, L1_UPGRADE2}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition(MTSB_L2ONLY, {L1_GETX_pb, L1_GETS_fwd, L1_GET_INSTR_fwd, L1_GETX_fwd, L1_UPGRADE,
    L1_GET_INSTR2_recon, L1_GETS2_recon, L1_GETS2_pb, L1_GET_INSTR2_pb, L1_UPGRADE2, L1_GETX2_recon}) {
    zz_stallAndWaitL1RequestQueue;
  }


  transition(L2ONLY_SS_r1, {L1_GETX2_fwd,L1_GETX_pb, L1_GETX_recon,
    L1_GETS_pb, L1_GET_INSTR_pb, L1_GETS_recon, L1_GET_INSTR_recon}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition(L2ONLY_SS_r1, {L1_GETS2_fwd, L1_GET_INSTR2_fwd}) {
    zz_stallAndWaitL1RequestQueue;
  }
  

  transition({SS_L2ONLY_s, L2ONLY_SSMB_s, SSMB_SS_s, SS_SSMB_s, SS_L2ONLY_r2, SI_SS_r1, SS_SI_r2, SI_L2ONLY_r1, L2ONLY_SS_s, L2ONLY_SI_r2, SSMB_L2ONLY_s,
    L2ONLY_II_dc, SI_L2ONLY_dd, L2ONLY_SI_dd, II_L2ONLY_cd, SI_L2ONLY_dc, SI_II_dc, SI_SI_dd, II_SI_cd, SI_MI_dd, SI_MI_dc, II_MI_cd, 
    L2ONLY_MTSB}, 
   {L1_GETS_pb, L1_GETX_pb, L1_GET_INSTR_pb, L1_GETS_fwd, L1_GETX_fwd, L1_GET_INSTR_fwd,
    L1_GETS2_pb, L1_GETX2_pb, L1_GET_INSTR2_pb, L1_GETS2_fwd, L1_GETX2_fwd, L1_GET_INSTR2_fwd,
    L1_GETS_recon, L1_GETX_recon, L1_GET_INSTR_recon, L1_GETS2_recon, L1_GETX2_recon, L1_GET_INSTR2_recon}) {
    zz_stallAndWaitL1RequestQueue;
  }

  // getx
  transition(SS_IS, {L1_GETX2_pb, L1_GETX2_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }
  transition(IS_SS, {L1_GETX_pb, L1_GETX_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }


  transition(L2ONLY_IS, {L1_GETX2, L1_GETX2_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }
  transition(IS_L2ONLY, {L1_GETX_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }


  transition(IS_IS, {L1_GETX_pb, L1_GETX_fwd, L1_GETX2_pb, L1_GETX2_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }


  transition({IS_L2ONLY, IS_SS, 
    SI_L2ONLY_r1, SI_SS_r1, L2ONLY_SS_r1, 
    SS_L2ONLY_r2, SS_SI_r2, 
    }, 
    L1_UPGRADE) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({SS_IS, L2ONLY_IS, 
    SI_SS_r1, L2ONLY_SS_r1, SI_L2ONLY_r1
    L2ONLY_SI_r2, SS_SI_r2, SS_L2ONLY_r2, 
    }, 
    L1_UPGRADE2) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({IS_IS, 
    SI_L2ONLY_dd, SI_L2ONLY_dc, SI_SI_dd, SI_MI_dd, SI_MI_dc, SI_II_dc,
    II_L2ONLY_cd, II_SI_cd, L2ONLY_SI_dd, L2ONLY_II_dc, II_MI_cd,
    L2ONLY_MTSB,
    L2ONLY_SS_s, SS_L2ONLY_s, SSMB_SS_s, SS_SSMB_s, L2ONLY_SSMB_s, SSMB_L2ONLY_s}, 
    {L1_UPGRADE, L1_UPGRADE2}) {
    zz_stallAndWaitL1RequestQueue;
  }

  //singular states
  transition(SS_s, {L1_GETS, L1_GET_INSTR, L1_GETX, L1_UPGRADE,
    L2_Replacement, L2_Replacement_clean, 
    L1_PUTS_last, L1_PUTS_last2, L1_PUTS_not_last,L1_PUTS_not_last2,
    L1_PUTX_not_last, L1_PUTX}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition(L2ONLY_s, {L1_GETS, L1_GET_INSTR, L1_GETX, 
    L2_Replacement, L2_Replacement_clean, L1_PUTS_last, L1_PUTS_last2, L1_PUTS_not_last,L1_PUTS_not_last2}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({I_I_s, I_I_sm, S_I_s}, {L1_GETS, L1_GET_INSTR, L1_GETX, L1_PUTS_old}) {
    zz_stallAndWaitL1RequestQueue;
  }
  
  transition({SS_s, L2ONLY_s, I_I_s, I_I_sm, S_I_s}, MEM_Inv) {
    zn_recycleResponseNetwork;
  }


// %%%%%%%%%%%%%%%%%%%%%% cannot xor %%%%%%%%%%%%%%%%%%%%%%
  transition({SS,MT_SB}, Stall_XOR) {
    dmt_insert_fromCache1;
    dmtS_insert_fromCache1;
    ij_increaseStallCount;
    znj_recycleTriggerQueue;
  }
  transition(L2ONLY, Stall_XOR) {
    dmt_insert_fromCache1;
    dmtNS_insert_fromCache1;
    ij_increaseStallCount;
    znj_recycleTriggerQueue;
  }
// %%%%%%%%%%%%%%%%%%%%%% skip xor %%%%%%%%%%%%%%%%%%%%%%
  transition({SS, L2ONLY,
    }, Skip_XOR) {
    // dmt_insert_fromCache1;
    // dmtS_insert_fromCache1;
    cj_clearStallCount;
    jf_popTriggerQueue_fail;
  }
  transition({
    SS_OR_MT_MB, MT,
    SS_SS, SS_L2ONLY, L2ONLY_SS, SS_MTSB, MTSB_SS, L2ONLY_MTSB, MTSB_L2ONLY, MTSB_MTSB,
    SS_SSMB_s,L2ONLY_SSMB_s,SSMB_L2ONLY_s,SS_L2ONLY_s,SSMB_SS_s,L2ONLY_SS_s,L2ONLY_s,
    SS_L2ONLY_r2,SS_SI_r2,L2ONLY_SS_r1,SI_L2ONLY_r1,SI_SS_r1,L2ONLY_SI_r2,
    L2ONLY_SS_UB2, SS_L2ONLY_UB1, SS_SS_UB2,SS_SS_UB1,SS_SS_UB12,L2ONLY_SS_UB1,SS_L2ONLY_UB2,
    M_I, I_I, S_I,
    SS_s, I_I_s, I_I_sm, S_I_s,
    II_L2ONLY_cd,L2ONLY_II_dc,SI_II_dc,SI_L2ONLY_dd,
    }, Skip_XOR) 
  {
    cj_clearStallCount;
    jf_popTriggerQueue_fail;
  }