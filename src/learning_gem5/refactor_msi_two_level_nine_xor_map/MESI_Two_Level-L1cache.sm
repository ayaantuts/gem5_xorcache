
structure(DataProc, external="yes") {
  DataBlock preprocess(DataBlock, DataBlock);
  DataBlock peek_preproc(DataBlock, DataBlock); // functionally identical to preprocess, but stats are not updated
  int compress(DataBlock);
  int peek_compress(DataBlock);
  int peek_compress(DataBlock, DataBlock);
  Cycles decompress();
  Cycles reverse_proc();
  bool has_compression_scheme();
  bool has_preproc_scheme();
  bool do_xor();
}

machine(MachineType:L1Cache, "MSI Directory L1 Cache CMP")
 : Sequencer * sequencer;
   CacheMemory * L1Icache;
   CacheMemory * L1Dcache;
   DataProc * dataProcL1;
   int l2_select_num_bits;
   Cycles bypass_latency := 1;
   Cycles tbe_latency := 1;
   bool send_evictions;

   // Message Queues
   // From this node's L1 cache TO the network

   // a local L1 -> this L2 bank, currently ordered with directory forwarded requests
   MessageBuffer * requestFromL1Cache, network="To", virtual_network="0",
        vnet_type="request";

   // a local L1 -> this L2 bank
   MessageBuffer * responseFromL1Cache, network="To", virtual_network="1",
        vnet_type="response";

   MessageBuffer * unblockFromL1Cache, network="To", virtual_network="2",
        vnet_type="unblock";


   // To this node's L1 cache FROM the network
   // a L2 bank -> this L1
   MessageBuffer * requestToL1Cache, network="From", virtual_network="2",
        vnet_type="request";

   // a L2 bank -> this L1
   MessageBuffer * responseToL1Cache, network="From", virtual_network="1",
        vnet_type="response";

  // Buffer for requests generated by the processor core.
  MessageBuffer * mandatoryQueue;
  MessageBuffer * triggerQueue; // for serializing access latency for PB and FWD-B
{
  // STATES
  state_declaration(State, desc="Cache states", default="L1Cache_State_I") {
    // Base states
    NP, AccessPermission:Invalid, desc="Not present in either cache";
    I, AccessPermission:Invalid, desc="a L1 cache entry Idle";
    S, AccessPermission:Read_Only, desc="a L1 cache entry Shared";
    M, AccessPermission:Read_Write, desc="a L1 cache entry Modified", format="!b";

    // Transient States
    IS, AccessPermission:Busy, desc="L1 idle, issued GETS, have not seen response yet";
    IM, AccessPermission:Busy, desc="L1 idle, issued GETX, have not seen response yet";
    SM, AccessPermission:Read_Only, desc="L1 idle, issued GETX, have not seen response yet";
    SM_pb, AccessPermission:Read_Only, desc="L1 idle, issued GETX, have not seen response yet";
    SM_sd, AccessPermission:Read_Only, desc="L1 idle, issued GETX, have not seen response yet, should send eub with data";
    SM_acks, AccessPermission:Read_Only, desc="L1 idle, issued GETX, have not seen response yet, should send eub with data";
    IS_I, AccessPermission:Busy, desc="L1 idle, issued GETS, saw Inv before data because directory doesn't block on GETS hit";

    M_I, AccessPermission:Busy, desc="L1 replacing, waiting for ACK";
    SINK_WB_ACK, AccessPermission:Busy, desc="This is to sink WB_Acks from L2";
    
    // transient states for serializing access latency for PB and FWD-B
    S_serial_PB, AccessPermission:Busy, desc="waiting for triggerque pop";
    I_serial_PB, AccessPermission:Busy, desc="waiting for triggerque pop";
  }

  // EVENTS
  enumeration(Event, desc="Cache events") {
    // L1 events
    Load,            desc="Load request from the home processor";
    Ifetch,          desc="I-fetch request from the home processor";
    Store,           desc="Store request from the home processor";

    Inv,           desc="Invalidate request from L2 bank";
    InvData,           desc="Invalidate request WITH DATA from L2 bank";

    // internal generated request
    L1_Replacement,  desc="L1 Replacement", format="!r";

    // other requests
    Fwd_GETX,   desc="GETX from other processor";
    Fwd_GETS,   desc="GETS from other processor";
    Fwd_GET_INSTR,   desc="GET_INSTR from other processor";

    UNXOR_WB,   desc="unxorwb";

    Data,       desc="Data for processor";
    DataPB,       desc="Data for processor";
    // Data_Exclusive,       desc="Data for processor";
    DataS_fromL1E,       desc="data for GETS request, need to unblock directory";
    DataS_fromL1S,       desc="data for GETS request, need to unblock directory";
    DataS_fromL1S_all_acks,       desc="";
    Data_all_Acks,       desc="Data for processor, all acks";
    DataE_fromL1E_all_Acks,       desc="Data for processor, all acks";
    DataPB_all_Acks,       desc="Data for processor, all acks";
    DataReconstructS,       desc="Data for processor";

    Ack,        desc="Ack for processor";
    Ack_all,      desc="Last ack for processor";
    AckS,        desc="Ack for processor";
    AckS_all,      desc="Last ack for processor";

    WB_Ack,        desc="Ack for replacement";
    WB_Nack,        desc="Nack for replacement";

    Recover, desc="recover request from L2";
    ReconstructS, desc="reconstruct request from L2";

    Serialization_Complete, desc="trigger queue pop";
  }

  // TYPES

  // CacheEntry
  structure(Entry, desc="...", interface="AbstractCacheEntry" ) {
    State CacheState,        desc="cache state";
    DataBlock DataBlk,       desc="data for the block";
    bool Dirty, default="false",   desc="data is dirty";
  }

  // TBE fields
  structure(TBE, desc="...") {
    Addr addr,              desc="Physical address for this TBE";
    State TBEState,        desc="Transient state";
    DataBlock DataBlk,                desc="Buffer for the data block";
    bool Dirty, default="false",   desc="data is dirty";
    int pendingAcks, default="0", desc="number of pending acks";
    L2HitMissPath l2_hit_miss_path, default="L2HitMissPath_NONE", desc="l2 hit/miss path";
  }

  structure(TBETable, external="yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }

  TBETable TBEs, template="<L1Cache_TBE>", constructor="m_number_of_TBEs";

  int l2_select_low_bit, default="RubySystem::getBlockSizeBits()";

  Tick clockEdge();
  Cycles ticksToCycles(Tick t);
  void set_cache_entry(AbstractCacheEntry a);
  void unset_cache_entry();
  void set_tbe(TBE a);
  void unset_tbe();
  void wakeUpBuffers(Addr a);
  void profileMsgDelay(int virtualNetworkType, Cycles c);

  // inclusive cache returns L1 entries only
  Entry getCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache[addr]);
    if(is_valid(L1Dcache_entry)) {
      return L1Dcache_entry;
    }

    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache[addr]);
    return L1Icache_entry;
  }

  DataBlock getDataBlock(Addr addr){
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      DPRINTF(RubySlicc, "getDataBlock: tbe valid, blk=%s\n", tbe.DataBlk);
      return tbe.DataBlk;
    }
    Entry L1cache_entry := getCacheEntry(addr);
    if(is_valid(L1cache_entry)) {
      DPRINTF(RubySlicc, "getDataBlock: l1cache valid, blk=%s\n", L1cache_entry.DataBlk);
      return L1cache_entry.DataBlk;
    } else {
      error("L1: getDataBlock: Invalid");
    }
  }

  Entry getL1DCacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Dcache_entry := static_cast(Entry, "pointer", L1Dcache[addr]);
    return L1Dcache_entry;
  }

  Entry getL1ICacheEntry(Addr addr), return_by_pointer="yes" {
    Entry L1Icache_entry := static_cast(Entry, "pointer", L1Icache[addr]);
    return L1Icache_entry;
  }

  State getState(TBE tbe, Entry cache_entry, Addr addr) {
    assert((L1Dcache.isTagPresent(addr) && L1Icache.isTagPresent(addr)) == false);

    if(is_valid(tbe)) {
      return tbe.TBEState;
    } else if (is_valid(cache_entry)) {
      return cache_entry.CacheState;
    }
    return State:NP;
  }

  void setState(TBE tbe, Entry cache_entry, Addr addr, State state) {
    assert((L1Dcache.isTagPresent(addr) && L1Icache.isTagPresent(addr)) == false);

    // MUST CHANGE
    if(is_valid(tbe)) {
      tbe.TBEState := state;
    }

    if (is_valid(cache_entry)) {
      cache_entry.CacheState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      DPRINTF(RubySlicc, "%llx, %s\n", addr, L1Cache_State_to_permission(tbe.TBEState));
      return L1Cache_State_to_permission(tbe.TBEState);
    }

    Entry cache_entry := getCacheEntry(addr);
    if(is_valid(cache_entry)) {
      DPRINTF(RubySlicc, "%llx, %s\n", addr, L1Cache_State_to_permission(cache_entry.CacheState));
      return L1Cache_State_to_permission(cache_entry.CacheState);
    }

    DPRINTF(RubySlicc, "%llx, %s\n", addr, AccessPermission:NotPresent);
    return AccessPermission:NotPresent;
  }

  void functionalRead(Addr addr, Packet *pkt) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      testAndRead(addr, tbe.DataBlk, pkt);
    } else {
      testAndRead(addr, getCacheEntry(addr).DataBlk, pkt);
    }
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    int num_functional_writes := 0;

    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
      num_functional_writes := num_functional_writes +
        testAndWrite(addr, tbe.DataBlk, pkt);
      return num_functional_writes;
    }

    num_functional_writes := num_functional_writes +
        testAndWrite(addr, getCacheEntry(addr).DataBlk, pkt);
    return num_functional_writes;
  }

  void setAccessPermission(Entry cache_entry, Addr addr, State state) {
    if (is_valid(cache_entry)) {
      cache_entry.changePermission(L1Cache_State_to_permission(state));
    }
  }

  Event mandatory_request_type_to_event(RubyRequestType type) {
    if (type == RubyRequestType:LD) {
      return Event:Load;
    } else if (type == RubyRequestType:IFETCH) {
      return Event:Ifetch;
    } else if ((type == RubyRequestType:ST) || (type == RubyRequestType:ATOMIC)) {
      return Event:Store;
    } else {
      error("Invalid RubyRequestType");
    }
  }


  int getPendingAcks(TBE tbe) {
    return tbe.pendingAcks;
  }

  out_port(requestL1Network_out, RequestMsg, requestFromL1Cache);
  out_port(responseL1Network_out, ResponseMsg, responseFromL1Cache);
  out_port(unblockNetwork_out, ResponseMsg, unblockFromL1Cache);
  out_port(triggerQueue_out, TriggerMsg, triggerQueue);


  in_port(triggerQueue_in, TriggerMsg, triggerQueue, rank = 3) {
    if (triggerQueue_in.isReady(clockEdge())) {
      peek(triggerQueue_in, TriggerMsg) {
        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];
        trigger(Event:Serialization_Complete, in_msg.addr, cache_entry, tbe);
      }
    }
  }

  // Response  L1 Network - response msg to this L1 cache
  in_port(responseL1Network_in, ResponseMsg, responseToL1Cache, rank = 2) {
    if (responseL1Network_in.isReady(clockEdge())) {
      peek(responseL1Network_in, ResponseMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        // if(in_msg.Type == CoherenceResponseType:DATA_EXCLUSIVE) {
        //   trigger(Event:Data_Exclusive, in_msg.addr, cache_entry, tbe);
        // } else 
        DPRINTF(RubySlicc, "L1 responseL1Network_in: type:%s, addr:%llx\n", 
          in_msg.Type, in_msg.addr);

        if(in_msg.Type == CoherenceResponseType:DATA) {
          if ((getState(tbe, cache_entry, in_msg.addr) == State:IS ||
               getState(tbe, cache_entry, in_msg.addr) == State:IS_I) &&
              machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
              trigger(Event:DataS_fromL1E, in_msg.addr, cache_entry, tbe);
          } else if ((getState(tbe, cache_entry, in_msg.addr) == State:IM) &&
            machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
              assert( (getPendingAcks(tbe) - in_msg.AckCount) == 0 );
              trigger(Event:DataE_fromL1E_all_Acks, in_msg.addr, cache_entry, tbe);
          } else if ( (getPendingAcks(tbe) - in_msg.AckCount) == 0 ) {
            trigger(Event:Data_all_Acks, in_msg.addr, cache_entry, tbe);
          } else {
            assert(machineIDToMachineType(in_msg.Sender) == MachineType:L2Cache);
            trigger(Event:Data, in_msg.addr, cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceResponseType:DATAS) {
          if ((getState(tbe, cache_entry, in_msg.addr) == State:IS ||
               getState(tbe, cache_entry, in_msg.addr) == State:IS_I
               ) &&
              machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
            trigger(Event:DataS_fromL1S, in_msg.addr, cache_entry, tbe);
          } else if ((getState(tbe, cache_entry, in_msg.addr) == State:IM
               ) &&
              machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache) {
            if ((getPendingAcks(tbe) - in_msg.AckCount) == 0) {
              trigger(Event:DataS_fromL1S_all_acks, in_msg.addr, cache_entry, tbe);
            } else {
              trigger(Event:DataS_fromL1S, in_msg.addr, cache_entry, tbe);
            }
          } else {
            error("L1: DataS: Invalid state transition");
          }
        } else if(in_msg.Type == CoherenceResponseType:DATAPB) {
          if ( (getPendingAcks(tbe) - in_msg.AckCount) == 0 ) {
            trigger(Event:DataPB_all_Acks, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:DataPB, in_msg.addr, cache_entry, tbe);
          }
        } else if(in_msg.Type == CoherenceResponseType:RECONSTRUCTDATAS) {
            trigger(Event:DataReconstructS, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceResponseType:ACK) {
          if ( (getPendingAcks(tbe) - in_msg.AckCount) == 0 ) {
            trigger(Event:Ack_all, in_msg.addr, cache_entry, tbe);
          } else {
            trigger(Event:Ack, in_msg.addr, cache_entry, tbe);
          }
        } else if (in_msg.Type == CoherenceResponseType:WB_ACK) {
          trigger(Event:WB_Ack, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceResponseType:WB_NACK) {
          trigger(Event:WB_Nack, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceResponseType:UNXORWB) {
          trigger(Event:UNXOR_WB, in_msg.addr, cache_entry, tbe);
        }
         else {
          error("Invalid L1 response type");
        }
      }
    }
  }

  // Request InterChip network - request from this L1 cache to the shared L2
  in_port(requestL1Network_in, RequestMsg, requestToL1Cache, rank = 1) {
    if(requestL1Network_in.isReady(clockEdge())) {
      peek(requestL1Network_in, RequestMsg, block_on="addr") {
        assert(in_msg.Destination.isElement(machineID));

        Entry cache_entry := getCacheEntry(in_msg.addr);
        TBE tbe := TBEs[in_msg.addr];

        if (in_msg.Type == CoherenceRequestType:INV) {
          trigger(Event:Inv, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceRequestType:INVDATA) {
          trigger(Event:InvData, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceRequestType:GETX ||
                   in_msg.Type == CoherenceRequestType:UPGRADE) {
          // upgrade transforms to GETX due to race
          trigger(Event:Fwd_GETX, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceRequestType:GETS) {
          trigger(Event:Fwd_GETS, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceRequestType:GET_INSTR) {
          trigger(Event:Fwd_GET_INSTR, in_msg.addr, cache_entry, tbe);
        } 
        else if (in_msg.Type == CoherenceRequestType:RECOVER) {
          trigger(Event:Recover, in_msg.addr, cache_entry, tbe);
        } else if (in_msg.Type == CoherenceRequestType:RECONSTRUCTS) {
          trigger(Event:ReconstructS, in_msg.addr, cache_entry, tbe);
        }  else {
          error("Invalid forwarded request type");
        }
      }
    }
  }

  // Mandatory Queue betweens Node's CPU and it's L1 caches
  in_port(mandatoryQueue_in, RubyRequest, mandatoryQueue, desc="...", rank = 0) {
    if (mandatoryQueue_in.isReady(clockEdge())) {
      peek(mandatoryQueue_in, RubyRequest, block_on="LineAddress") {

        // Check for data access to blocks in I-cache and ifetchs to blocks in D-cache

        if (in_msg.Type == RubyRequestType:IFETCH) {
          // ** INSTRUCTION ACCESS ***

          Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
          if (is_valid(L1Icache_entry)) {
            // The tag matches for the L1, so the L1 asks the L2 for it.
            trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress,
                    L1Icache_entry, TBEs[in_msg.LineAddress]);
          } else {

            // Check to see if it is in the OTHER L1
            Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
            if (is_valid(L1Dcache_entry)) {
              // The block is in the wrong L1, put the request on the queue to the shared L2
              trigger(Event:L1_Replacement, in_msg.LineAddress,
                      L1Dcache_entry, TBEs[in_msg.LineAddress]);
            }

            if (L1Icache.cacheAvail(in_msg.LineAddress)) {
              // L1 does't have the line, but we have space for it
              // in the L1 so let's see if the L2 has it.
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress,
                      L1Icache_entry, TBEs[in_msg.LineAddress]);
            } else {
              // No room in the L1, so we need to make room in the L1

              // Check if the line we want to evict is not locked
              Addr addr := L1Icache.cacheProbe(in_msg.LineAddress);
              check_on_cache_probe(mandatoryQueue_in, addr);

              trigger(Event:L1_Replacement, addr,
                      getL1ICacheEntry(addr),
                      TBEs[addr]);
            }
          }
        } else {

          // *** DATA ACCESS ***
          Entry L1Dcache_entry := getL1DCacheEntry(in_msg.LineAddress);
          if (is_valid(L1Dcache_entry)) {
            // The tag matches for the L1, so the L1 ask the L2 for it
            trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress,
                    L1Dcache_entry, TBEs[in_msg.LineAddress]);
          } else {

            // Check to see if it is in the OTHER L1
            Entry L1Icache_entry := getL1ICacheEntry(in_msg.LineAddress);
            if (is_valid(L1Icache_entry)) {
              // The block is in the wrong L1, put the request on the queue to the shared L2
              trigger(Event:L1_Replacement, in_msg.LineAddress,
                      L1Icache_entry, TBEs[in_msg.LineAddress]);
            }

            if (L1Dcache.cacheAvail(in_msg.LineAddress)) {
              // L1 does't have the line, but we have space for it
              // in the L1 let's see if the L2 has it.
              trigger(mandatory_request_type_to_event(in_msg.Type), in_msg.LineAddress,
                      L1Dcache_entry, TBEs[in_msg.LineAddress]);
            } else {
              // No room in the L1, so we need to make room in the L1

              // Check if the line we want to evict is not locked
              Addr addr := L1Dcache.cacheProbe(in_msg.LineAddress);
              check_on_cache_probe(mandatoryQueue_in, addr);

              trigger(Event:L1_Replacement, addr,
                      getL1DCacheEntry(addr),
                      TBEs[addr]);
            }
          }
        }
      }
    }
  }


  // ACTIONS

  // 3. triggerqueue ops
  action(t_enq_pb, "tenqpb", desc="push to trigger queue to serialize access latency") {
    peek(responseL1Network_in, ResponseMsg) {
      DPRINTF(RubySlicc, "read pb block (0x%llx)\n", in_msg.piggybacked_addr);
      assert(is_valid(TBEs[in_msg.piggybacked_addr]) || is_valid(getCacheEntry(in_msg.piggybacked_addr))); // tbe should be valid
      enqueue(triggerQueue_out, TriggerMsg, L1Dcache.getTagLatency()) {
        out_msg.addr := address;
        out_msg.enqueTick := clockEdge();
        out_msg.to_send_unblock_addr := in_msg.piggybacked_addr;
      }
    }
  }
  action(t_enq, "tenq", desc="push to trigger queue to serialize access latency") {
    enqueue(triggerQueue_out, TriggerMsg, L1Dcache.getTagLatency()) {
      out_msg.addr := address;
      out_msg.enqueTick := clockEdge();
    }
  }

  action(t_deq, "tdeq", desc="Pop trigger queue") {
    peek(triggerQueue_in, TriggerMsg) {
      Tick delay := clockEdge() - in_msg.enqueTick;
      DPRINTF(RubySlicc, "t_deq: delay=%d\n", delay);
      profileMsgDelay(3, ticksToCycles(delay)); // l1 triggerqueue
    }
    triggerQueue_in.dequeue(clockEdge());
  }

  
  
  // 2. responseL1Network_in
  action(q_updateAckCount, "q", desc="Update ack count") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(tbe));
      tbe.pendingAcks := tbe.pendingAcks - in_msg.AckCount;
      APPEND_TRANSITION_COMMENT(in_msg.AckCount);
      APPEND_TRANSITION_COMMENT(" p: ");
      APPEND_TRANSITION_COMMENT(tbe.pendingAcks);
    }
  }
  action(u_writeDataToL1Cache, "u", desc="Write data to cache") {
    peek(responseL1Network_in, ResponseMsg) {
      assert(is_valid(cache_entry));
      cache_entry.DataBlk := in_msg.DataBlk;
      cache_entry.Dirty := in_msg.Dirty;
      DPRINTF(RubySlicc, "%llx dirty to (%d) in cache from in_msg\n", address, in_msg.Dirty);
    }
  }
  action(o_popIncomingResponseQueue, "o", desc="Pop Incoming Response queue and profile the delay within this virtual network") {
    Tick delay := responseL1Network_in.dequeue(clockEdge());
    profileMsgDelay(2, ticksToCycles(delay));
  }
  action(f_sendDataToL2, "f", desc="send data to the L2 cache") {
    enqueue(responseL1Network_out, ResponseMsg, L1Dcache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
      DPRINTF(RubySlicc, "f_sendDataToL2 %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }
  action(ft_sendDataToL2_fromTBE, "ft", desc="send data to the L2 cache") {
    enqueue(responseL1Network_out, ResponseMsg, tbe_latency) {
      assert(is_valid(tbe));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Dirty := tbe.Dirty;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Writeback_Data;
      DPRINTF(RubySlicc, "ft_sendDataToL2_fromTBE %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }
  
  
  // 1. requestL1Network_in
  action(d_sendDataToRequestor, "d", desc="send data to requestor") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, L1Dcache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        DPRINTF(RubySlicc, "d_sendDataToRequestor %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
      }
    }
  }
  action(dt_sendDataToRequestor_fromTBE, "dt", desc="send data to requestor") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, tbe_latency) {
        assert(is_valid(tbe));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATA;
        out_msg.DataBlk := tbe.DataBlk;
        out_msg.Dirty := tbe.Dirty;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        DPRINTF(RubySlicc, "dt_sendDataToRequestor_fromTBE %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
      }
    }
  }
  action(fi_sendInvAck, "fi", desc="send data to the L2 cache") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, bypass_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Control;
        out_msg.AckCount := 1;
      }
    }
  }
  action(l_popRequestQueue, "l", desc="Pop incoming request queue and profile the delay within this virtual network") {
    Tick delay := requestL1Network_in.dequeue(clockEdge());
    profileMsgDelay(1, ticksToCycles(delay));
  }
  action(z_stallAndWaitRequestQueue, "\zr", desc="Stall and wait the L1 request queue") {
    stall_and_wait(requestL1Network_in, address);
  }
  // xor-special
  action(dsa_sendDataSToRequestor_with1Ack, "dsa", desc="send dataS to requestor with 1 ack") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, L1Dcache.getDataLatency()) {
        assert(is_valid(cache_entry));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAS;
        out_msg.DataBlk := cache_entry.DataBlk;
        out_msg.Dirty := cache_entry.Dirty;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := in_msg.AckCount_communicate + 1;
        DPRINTF(RubySlicc, "dsa_sendDataSToRequestor_with1Ack %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
      }
    }
  }
  action(dsat_sendDataSToRequestor_with1Ack_fromTBE, "dsat", desc="send dataS to requestor with 1 ack") {
    peek(requestL1Network_in, RequestMsg) {
      enqueue(responseL1Network_out, ResponseMsg, tbe_latency) {
        assert(is_valid(tbe));
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:DATAS;
        out_msg.DataBlk := tbe.DataBlk;
        out_msg.Dirty := tbe.Dirty;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.Requestor);
        out_msg.MessageSize := MessageSizeType:Response_Data;
        out_msg.AckCount := in_msg.AckCount_communicate + 1;
        DPRINTF(RubySlicc, "dsat_sendDataSToRequestor_with1Ack_fromTBE %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
      }
    }
  }
  
  // 0. mandatory queue ops
  action(a_issueGETS, "a", desc="Issue GETS") {
    peek(mandatoryQueue_in, RubyRequest) {
      enqueue(requestL1Network_out, RequestMsg, L1Dcache.getTagLatency()) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETS;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
        DPRINTF(RubySlicc, "address: %#x, destination: %s\n",
                address, out_msg.Destination);
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
      }
    }
  }
  action(ai_issueGETINSTR, "ai", desc="Issue GETINSTR") {
    peek(mandatoryQueue_in, RubyRequest) {
      enqueue(requestL1Network_out, RequestMsg, L1Icache.getTagLatency()) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GET_INSTR;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
        DPRINTF(RubySlicc, "address: %#x, destination: %s\n",
                address, out_msg.Destination);
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
      }
    }
  }
  action(b_issueGETX, "b", desc="Issue GETX") {
    peek(mandatoryQueue_in, RubyRequest) {
      enqueue(requestL1Network_out, RequestMsg, L1Dcache.getTagLatency()) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:GETX;
        out_msg.Requestor := machineID;
        DPRINTF(RubySlicc, "%s\n", machineID);
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
        DPRINTF(RubySlicc, "address: %#x, destination: %s\n",
                address, out_msg.Destination);
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
      }
    }
  }
  action(c_issueUPGRADE, "c", desc="Issue GETX") {
    peek(mandatoryQueue_in, RubyRequest) {
      enqueue(requestL1Network_out, RequestMsg,  L1Dcache.getTagLatency()) {
        out_msg.addr := address;
        out_msg.Type := CoherenceRequestType:UPGRADE;
        out_msg.Requestor := machineID;
        out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
        DPRINTF(RubySlicc, "address: %#x, destination: %s\n",
                address, out_msg.Destination);
        out_msg.MessageSize := MessageSizeType:Control;
        out_msg.AccessMode := in_msg.AccessMode;
      }
    }
  }
  action(k_popMandatoryQueue, "k", desc="Pop mandatory queue.") {
    mandatoryQueue_in.dequeue(clockEdge());
  }
  action(z_stallAndWaitMandatoryQueue, "\z", desc="Stall and wait the L1 mandatory request queue") {
    stall_and_wait(mandatoryQueue_in, address);
  }

  // requestL1Network_out
  action(g_issuePUTX, "gX", desc="send data to the L2 cache, from M state") {
    enqueue(requestL1Network_out, RequestMsg, L1Dcache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:PUTX;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Requestor:= machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      if (cache_entry.Dirty) {
        out_msg.MessageSize := MessageSizeType:Writeback_Data;
      } else {
        out_msg.MessageSize := MessageSizeType:Writeback_Control;
      }
      DPRINTF(RubySlicc, "g_issuePUTX %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }
  action(g_issuePUTS, "gS", desc="send data to the L2 cache, from S state") {
    enqueue(requestL1Network_out, RequestMsg, bypass_latency) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:PUTS;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Requestor:= machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      // assert (!cache_entry.Dirty); 
      out_msg.MessageSize := MessageSizeType:Writeback_Control;

      DPRINTF(RubySlicc, "g_issuePUTS %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }
  // xor-special
  action(g_issuePUTSData_fromTBE, "gSD", desc="send data to the L2 cache, from S state") {
    enqueue(requestL1Network_out, RequestMsg, tbe_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceRequestType:PUTSDATA;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Dirty := tbe.Dirty;
      out_msg.Requestor:= machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      // assert (!cache_entry.Dirty); 
      out_msg.MessageSize := MessageSizeType:Writeback_Data;

      DPRINTF(RubySlicc, "g_issuePUTSData_fromTBE %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }

  // unblockNetwork_out
  action(je_sendUnblock_extra, "je", desc="send unblock to the L2 cache") {
    enqueue(unblockNetwork_out, ResponseMsg, bypass_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:UNBLOCK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Extra_Unblock_Control;
      DPRINTF(RubySlicc, "%#x\n", address);
    }
  }
  action(jn_sendUnblock_necessary, "jn", desc="send unblock to the L2 cache") {
    enqueue(unblockNetwork_out, ResponseMsg, bypass_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:UNBLOCK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Necessary_Unblock_Control;
      DPRINTF(RubySlicc, "%#x\n", address);
    }
  }
  action(jj_sendExclusiveUnblock, "\j", desc="send unblock to the L2 cache") {
    enqueue(unblockNetwork_out, ResponseMsg, bypass_latency) {
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:EXCLUSIVE_UNBLOCK;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Necessary_Unblock_Control;
      DPRINTF(RubySlicc, "%#x\n", address);

    }
  }
 

  //responseL1Network_out
  action(d2_sendDataToL2, "d2", desc="send data to the L2 cache because of M downgrade") {
    enqueue(responseL1Network_out, ResponseMsg, L1Dcache.getDataLatency()) {
      assert(is_valid(cache_entry));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.DataBlk := cache_entry.DataBlk;
      out_msg.Dirty := cache_entry.Dirty;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Response_Data;
      DPRINTF(RubySlicc, "d2_sendDataToL2 %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }
  action(d2t_sendDataToL2_fromTBE, "d2t", desc="send data to the L2 cache") {
    enqueue(responseL1Network_out, ResponseMsg, tbe_latency) {
      assert(is_valid(tbe));
      out_msg.addr := address;
      out_msg.Type := CoherenceResponseType:DATA;
      out_msg.DataBlk := tbe.DataBlk;
      out_msg.Dirty := tbe.Dirty;
      out_msg.Sender := machineID;
      out_msg.Destination.add(mapAddressToRange(address, MachineType:L2Cache,
                          l2_select_low_bit, l2_select_num_bits, intToID(0)));
      out_msg.MessageSize := MessageSizeType:Response_Data;
      DPRINTF(RubySlicc, "d2t_sendDataToL2_fromTBE %#x dirty(%d) send out\n",
                address, out_msg.Dirty);
    }
  }


  // structure maintainance actions
  action(assertfalse, "assertfalse", desc="assert false") {
    assert(false);
  }
  action(forward_eviction_to_cpu, "\cc", desc="sends eviction information to the processor") {
    if (send_evictions) {
      DPRINTF(RubySlicc, "Sending invalidation for %#x to the CPU\n", address);
      sequencer.evictionCallback(address);
    }
  }
  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpBuffers(address);
  }
  
  action(i_allocateTBE, "i", desc="Allocate TBE (number of invalidates=0)") {
    check_allocate(TBEs);
    assert(is_valid(cache_entry));
    TBEs.allocate(address);
    set_tbe(TBEs[address]);
    tbe.Dirty := cache_entry.Dirty;
    DPRINTF(RubySlicc, "0x%llx dirty is %d in tbe\n", address, tbe.Dirty);
    tbe.DataBlk := cache_entry.DataBlk;
  }
  action(s_deallocateTBE, "s", desc="Deallocate TBE") {
    TBEs.deallocate(address);
    unset_tbe();
  }
  
  action(ff_deallocateL1CacheBlock, "\f", desc="Deallocate L1 cache block.  Sets the cache to not present, allowing a replacement in parallel with a fetch.") {
    if (L1Dcache.isTagPresent(address)) {
      L1Dcache.deallocate(address);
    } else {
      L1Icache.deallocate(address);
    }
    unset_cache_entry();
    APPEND_TRANSITION_COMMENT(" l1--");
  }
  action(oo_allocateL1DCacheBlock, "\o", desc="Set L1 D-cache tag equal to tag of block B.") {
    if (is_invalid(cache_entry)) {
      set_cache_entry(L1Dcache.allocate(address, new Entry));
    }
    APPEND_TRANSITION_COMMENT(" l1++");
  }
  action(pp_allocateL1ICacheBlock, "\p", desc="Set L1 I-cache tag equal to tag of block B.") {
    if (is_invalid(cache_entry)) {
      set_cache_entry(L1Icache.allocate(address, new Entry));
    }
    APPEND_TRANSITION_COMMENT(" l1++");
  }

  
  // hit management
  action(h_load_hit, "hd", desc="Notify sequencer the load completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    L1Dcache.setMRU(cache_entry);
    sequencer.readCallback(address, cache_entry.DataBlk, false, machineIDToMachineType(machineID)); // L1 hit
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }
  action(h_ifetch_hit, "hi", desc="Notify sequencer the instruction fetch completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    L1Icache.setMRU(cache_entry);
    sequencer.readCallback(address, cache_entry.DataBlk, false, machineIDToMachineType(machineID)); // L1 hit
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
  }
  action(hh_store_hit, "\h", desc="Notify sequencer that store completed.")
  {
    assert(is_valid(cache_entry));
    DPRINTF(RubySlicc, "before callback %s\n", cache_entry.DataBlk);
    L1Dcache.setMRU(cache_entry);
    sequencer.writeCallback(address, cache_entry.DataBlk, false, machineIDToMachineType(machineID)); // L1 hit
    cache_entry.Dirty := true;
    DPRINTF(RubySlicc, "after callback %s\n", cache_entry.DataBlk);
    DPRINTF(RubySlicc, "%llx dirty set\n", address);
  }
  
  // profile hit miss
  action(uu_profileInstMiss, "\uim", desc="Profile the demand miss") {
    L1Icache.profileDemandMiss();
  }
  action(uu_profileInstHit, "\uih", desc="Profile the demand hit") {
    L1Icache.profileDemandHit();
  }
  action(uu_profileDataMiss, "\udm", desc="Profile the demand miss") {
    L1Dcache.profileDemandMiss();
  }
  action(uu_profileDataHit, "\udh", desc="Profile the demand hit") {
    L1Dcache.profileDemandHit();
  }
  
  include "MESI_Two_Level-L1cache-actions.sm";
  include "MESI_Two_Level-L1cache-actions-unxor.sm";


  //*****************************************************
  // TRANSITIONS
  //*****************************************************

  // Transitions for Load/Store/Replacement/WriteBack from transient states
  transition({IS, IM, IS_I, M_I, SM, SINK_WB_ACK}, {Load, Ifetch, Store, L1_Replacement}) {
    z_stallAndWaitMandatoryQueue;
  }

  // Transitions from Idle
  transition({NP,I}, {L1_Replacement}) {
    ff_deallocateL1CacheBlock;
  }

  transition({NP,I}, Load, IS) {
    oo_allocateL1DCacheBlock;
    i_allocateTBE;
    a_issueGETS;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition({NP,I}, Ifetch, IS) {
    pp_allocateL1ICacheBlock;
    i_allocateTBE;
    ai_issueGETINSTR;
    uu_profileInstMiss;
    k_popMandatoryQueue;
  }

  transition({NP,I}, Store, IM) {
    oo_allocateL1DCacheBlock;
    i_allocateTBE;
    b_issueGETX;
    uu_profileDataMiss;
    k_popMandatoryQueue;
  }

  transition({NP, I}, Inv) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  // Transitions from Shared
  transition({S,M}, Load) {
    h_load_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition({S,M}, Ifetch) {
    h_ifetch_hit;
    uu_profileInstHit;
    k_popMandatoryQueue;
  }

  transition(S, Store, SM) {
    i_allocateTBE;
    c_issueUPGRADE;
    uu_profileDataMiss; //COHERENCE MISS
    set_l2_hit_miss_path_coh;
    k_popMandatoryQueue;
  }

  transition(S, {L1_Replacement}, SINK_WB_ACK) {
    forward_eviction_to_cpu;
    i_allocateTBE;
    g_issuePUTS;
    ff_deallocateL1CacheBlock;
  }

  transition(S, Inv, I) {
    forward_eviction_to_cpu;
    fi_sendInvAck;
    l_popRequestQueue;
  }


  // Transitions from Modified
  transition({M}, Store, M) {
    hh_store_hit;
    uu_profileDataHit;
    k_popMandatoryQueue;
  }

  transition(M, {L1_Replacement}, M_I) {
    forward_eviction_to_cpu;
    i_allocateTBE;
    g_issuePUTX;   // send data, but hold in case forwarded request
    ff_deallocateL1CacheBlock;
  }
  
  transition(M_I, WB_Ack, I) {
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(M, Inv, I) {
    forward_eviction_to_cpu;
    f_sendDataToL2;
    l_popRequestQueue;
  }

  transition(M_I, Inv, SINK_WB_ACK) {
    ft_sendDataToL2_fromTBE;
    l_popRequestQueue;
  }

  transition(M, Fwd_GETX, I) {
    forward_eviction_to_cpu;
    d_sendDataToRequestor;
    l_popRequestQueue;
  }

  transition(M, {Fwd_GETS, Fwd_GET_INSTR}, S) {
    d_sendDataToRequestor;
    d2_sendDataToL2;
    l_popRequestQueue;
  }

  transition(M_I, Fwd_GETX, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    l_popRequestQueue;
  }

  transition(M_I, {Fwd_GETS, Fwd_GET_INSTR}, SINK_WB_ACK) {
    dt_sendDataToRequestor_fromTBE;
    d2t_sendDataToL2_fromTBE;
    l_popRequestQueue;
  }

  //Transitions from IS
  transition({IS, IS_I}, Inv, IS_I) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition(IS, Data_all_Acks, S) {
    u_writeDataToL1Cache;
    hx_load_hit_dynamic;
    je_sendUnblock_extra;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IS_I, Data_all_Acks, I) {
    u_writeDataToL1Cache;
    hx_load_hit_dynamic;
    je_sendUnblock_extra;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  
  

  transition(IS, DataS_fromL1E, S) {
    u_writeDataToL1Cache;
    jn_sendUnblock_necessary;
    hx_load_hit_l1resp_fwde; // downgrading read (l2 miss)
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataS_fromL1E, I) {
    u_writeDataToL1Cache;
    jn_sendUnblock_necessary;
    hx_load_hit_l1resp_fwde; // downgrading read (l2 miss)
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  // Transitions from IM
  transition(IM, Inv, IM) {
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition(IM, Data, SM) {
    u_writeDataToL1Cache;
    q_updateAckCount;
    set_l2_hit_miss_path_direct;
    o_popIncomingResponseQueue;
  }

  transition(IM, DataE_fromL1E_all_Acks, M) {
    u_writeDataToL1Cache;
    hhx_store_hit_l1resp_fwde; // down+up write (l2 miss)
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  transition(IM, Data_all_Acks, M) {
    u_writeDataToL1Cache;
    hhx_store_hit_dynamic; // direct
    jj_sendExclusiveUnblock;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  
  // transitions from SM
  transition({SM}, Inv, IM) {
    forward_eviction_to_cpu;
    fi_sendInvAck;
    l_popRequestQueue;
  }

  transition(IM, Ack) {
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }
  transition(SM, Ack) {
    set_l2_hit_miss_path_unxor_conditionally;
    q_updateAckCount;
    o_popIncomingResponseQueue;
  }

  transition(SM, Ack_all, M) {
    set_l2_hit_miss_path_unxor_conditionally;
    jj_sendExclusiveUnblock;
    hhx_store_hit_dynamic_tbe;
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  // transitions from SINK_WB_ACK
  transition(SINK_WB_ACK, Inv){
    fi_sendInvAck;
    l_popRequestQueue;
  }
  
  transition(SINK_WB_ACK, WB_Ack, I){
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(SINK_WB_ACK, WB_Nack){ // single address
    g_issuePUTSData_fromTBE;
    o_popIncomingResponseQueue;
  }

  /////////////////// local recovery access ///////////////////
  // link to paper: transition 4 and 5 in fig 5
  // sending data: higher level cache
  // block B receiving data A^B
  transition(IS, DataPB_all_Acks, S_serial_PB) {
    u_writeDataToL1Cache_PB;
    t_enq_pb; // this should trigger block A's access
    o_popIncomingResponseQueue;
  }
  transition(S_serial_PB, Serialization_Complete, S) {
    je_sendUnblock_extra;
    t_deq;
    hx_load_hit_l2resp_pb; //PB
    s_deallocateTBE;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataPB_all_Acks, I_serial_PB) {
    u_writeDataToL1Cache_PB;
    t_enq_pb; // this should trigger block A's access
    o_popIncomingResponseQueue;
  }
  transition(I_serial_PB, Serialization_Complete, I) {
    je_sendUnblock_extra;
    t_deq;
    hx_load_hit_l2resp_pb; //PB
    s_deallocateTBE;
    kd_wakeUpDependents;
  }
  // stalling
  transition({S_serial_PB, I_serial_PB}, {Load, Ifetch, Store, L1_Replacement}) {
    z_stallAndWaitMandatoryQueue;
  }

  /////////////////// direct forwarding access ///////////////////
  // link to paper: transition 4 and 5 in fig 5
  // sending data
  transition(S, {Fwd_GETS, Fwd_GET_INSTR}) {
    ds_sendDataSToRequestor;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, {Fwd_GETS, Fwd_GET_INSTR}) {
    dst_sendDataSToRequestor_fromTBE;
    l_popRequestQueue;
  }
  transition(SM, {Fwd_GETS, Fwd_GET_INSTR}) {
    ds_sendDataSToRequestor;
    l_popRequestQueue;
  }
  // transition(IS, {Fwd_GETS, Fwd_GET_INSTR}) {
  //   z_stallAndWaitRequestQueue;
  // }

  // receiving data
  transition(IS, DataS_fromL1S, S) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    hx_load_hit_l2resp_fwda; //FWD-A
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataS_fromL1S, I) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    hx_load_hit_l2resp_fwda; //FWD-A
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }

  /////////////////// remote recovery access ///////////////////
  // link to paper: transition 4 and 5 in fig 5
  // sending data
  transition(S, ReconstructS) {
    rcis_sendReconstructDataS;
    l_popRequestQueue;
  }
  transition(SM, ReconstructS) {
    rcis_sendReconstructDataS;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, ReconstructS) {
    rcist_sendReconstructDataS_fromTBE;
    l_popRequestQueue;
  }
  // transition(IS, ReconstructS) {
  //   z_stallAndWaitRequestQueue;
  // }

  // receiving data
  transition(IS, DataReconstructS, S) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    hx_load_hit_l2resp_fwdb; //FWD-B
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
  }
  transition(IS_I, DataReconstructS, I) {
    u_writeDataToL1Cache;
    je_sendUnblock_extra;
    hx_load_hit_l2resp_fwdb; //FWD-B
    s_deallocateTBE;
    o_popIncomingResponseQueue;
  }
  
  /////////////////// eviction wbreq ///////////////////
  // link to paper: transition 9 and 10 in fig 5
  // invdata (SS triggered eviction OR co-eviction)
  transition(S, InvData, I) {
    forward_eviction_to_cpu;
    fi_sendInvAckData;
    l_popRequestQueue;
  }
  transition(SM, InvData, IM) {
    forward_eviction_to_cpu;
    fi_sendInvAckData;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, InvData) {
    fi_sendInvAckData_fromTBE;
    l_popRequestQueue;
  }
  // transition(IS, InvData) {
  //   z_stallAndWaitRequestQueue;
  // }

  // recover (L2ONLY triggered eviction)
  transition(S, Recover) {
    ri_sendRecoverData;
    l_popRequestQueue;
  }
  transition(SM, Recover) {
    ri_sendRecoverData;
    l_popRequestQueue;
  }
  transition(SINK_WB_ACK, Recover) {
    rit_sendRecoverData_fromTBE;
    l_popRequestQueue;
  }
  // transition(IS, Recover) {
  //   z_stallAndWaitRequestQueue;
  // }



  include "MESI_Two_Level-L1cache-transitions-unxor.sm";
}
