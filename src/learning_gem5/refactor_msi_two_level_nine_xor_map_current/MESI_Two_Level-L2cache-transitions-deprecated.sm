// %%%%%%%%%%%%%%%%%%%%%% into XOR %%%%%%%%%%%%%%%%%%%%%%
  transition(SS, {L1_GETS_XOR, L1_GET_INSTR_XOR},  SS_IS) { 
    af;
    aadir_allocateDir;
    aat_allocateTag;
    set1_tagMRU;
    set1_dataMRU;
    set1_dirMRU;

    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;

    lls_clearSecondarySharers;
    nns_addSecondarySharer;

    i_allocateTBE;
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
  }
  
  transition(IS, {L1_GETS_XOR, L1_GET_INSTR_XOR}, IS_IS) {
    af;
    aadir_allocateDir;
    aat_allocateTag;
    set1_tagMRU;
    set1_dataMRU;
    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;

    l2set1_isis;

    lls_clearSecondarySharers;
    nns_addSecondarySharer;

    i_allocateTBE; //secondary
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
  }
  transition(IS_IS, Mem_Data2, IS_SS) {
    af;
    ml2_writeLogicalDataToCache;

    entropy_reg_xor_data;
    mp_writePhyDataToCache_compress_update;
    entropy_reg_xor_data;


    el2_sendLogicalDataToGetSRequestors;
    // just in case ST has not been deallocated
    ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    l2set1_isss;
    

    s_deallocateTBE; // secondary
    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }
  transition(IS_IS, Mem_Data, SS_IS) {
    af;
    ml1_writeLogicalDataToCache;

    entropy_reg_xor_data;
    mp_writePhyDataToCache_compress_update;
    entropy_reg_xor_data;

    el1_sendLogicalDataToGetSRequestors;

    l2set2_ssis;

    s_deallocateTBE; // primary
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }
  transition(IS_SS, Mem_Data, SS_SS) {
    af;
    ml1_writeLogicalDataToCache;

    entropy_reg_xor_data;
    mpx_writePhyDataToCache_XOR_compress_update;
    entropy_reg_xor_data;

    el1_sendLogicalDataToGetSRequestors;

    s_deallocateTBE; // primary
    set_primary_as_cache_entry;
    l2set1_ssss;
    l2set2_ssss;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }
  transition(IS_SS, L1_PUTS_last2, L2ONLY) { // just undo xor
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    aad_allocateData;
    af;


    l2set1_is;
    l2a2_allocateL2;
    set_secondary_as_cache_entry;
    ll_clearSharers;

    aaststs1_allocateSingularTagBoth_primary;
    aast2_allocateSingularTag_secondary;

    dmt_insert_fromCache2;
    dmtNS_insert_fromCache2;

    xor_unpair;

    t_sendWBAck;
    jj_popL1RequestQueue;
  }
// %%%%%%%%%%%%%%%%%%%%%% outof XOR %%%%%%%%%%%%%%%%%%%%%%
  
  // IS_L2ONLY
  transition(IS_L2ONLY, {L1_GETX2_fwd}, SS_OR_MT_MB) {// just undo pairing
    af;
    aadir_allocateDir;
    ddtns_deallocateTagNS;
    ddt_deallocateTag;

    entropy_rm_xor_data;
    set1_dataMRU;

    // d_sendDataToRequestor;
    d2_sendDataToRequestor;
    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set1_is;
    set_secondary_as_cache_entry;

    aaststs1_allocateSingularTagBoth_primary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(IS_L2ONLY, {L1_GETX2_pb, L1_GETX2_recon}, SS_OR_MT_MB) {// just undo pairing
    af;
    aadir_allocateDir;
    ddtns_deallocateTagNS;
    ddt_deallocateTag;

    set1_dataMRU;

    // d_sendDataToRequestor;
    d2_sendDataToRequestor;
    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set1_is;
    set_secondary_as_cache_entry;

    aaststs1_allocateSingularTagBoth_primary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  
  // IS_SS
  transition(IS_SS, {L1_GETX2_fwd}, SS_OR_MT_MB) {// just undo pairing 
    af;
    ddt_deallocateTag;
    set1_dataMRU;
    set_dirMRU;

    // d_sendDataToRequestor;
    d2_sendDataToRequestor;
    fwm2_sendFwdInvToSharersMinusRequestor;

    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set1_is;
    set_secondary_as_cache_entry;

    aaststs1_allocateSingularTagBoth_primary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(IS_SS, {L1_GETX2_pb}, SS_OR_MT_MB) {// just undo pairing 
    af;
    ddt_deallocateTag;
    set1_dataMRU;
    set_dirMRU;

    // d_sendDataToRequestor;
    d2_sendDataToRequestor;
    fwm2_sendFwdInvToSharersMinusRequestor;

    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set1_is;
    set_secondary_as_cache_entry;

    aaststs1_allocateSingularTagBoth_primary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDirRead;
  }
  transition(IS_SS, L1_UPGRADE2, SS_OR_MT_MB) { // checking entropy
    af;
    // just undo pairing 
    ddt_deallocateTag;
    set1_dataMRU;
    set_dirMRU;

    fwm2_sendFwdInvToSharersMinusRequestor;
    ts2_sendInvAckToUpgrader;

    // allocate a new block for secondary block and set it to IS state
    l2a2_allocateL2;
    l2set1_is;
    set_secondary_as_cache_entry;

    aaststs1_allocateSingularTagBoth_primary;

    uu_profileHit;
    xor_unpair;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    af;
  }

