// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% INTO XOR STATES %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// ======= proactive transition to XOR states (green 1) =======
transition(NP, {L1_GETS_XOR, L1_GET_INSTR_XOR},  IS_x) {
    qq_allocateDirCacheBlock;
    bb_allocateL2CacheTagandLinkData;
    set_setXORed;
    s_schedulePairing;
    ll_clearSharers;
    nn_addSharer;
    i_allocateTBE;
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss_dir;
    uu_profileMiss;
    jj_popL1RequestQueue;
}
transition(IS_x, Mem_Data, SS_x) {
    pp_procWriteDataToCache;
    qq_writeDataToTBE;
    et_sendDataToGetSRequestors_fromTBE; // bypassing the mem data (raw)
    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd_wakeUpDependents;
}

// ======= reactive transition to XOR states (green 2) =======
transition(SS, GO_TO_XOR, SS_x) {
    set_setXORed;
    p_popTriggerQueue;
}
transition(L2ONLYS, GO_TO_XOR, L2ONLYS_x) {
    set_setXORed;
    p_popTriggerQueue;
}


// ======= internal transition =======
// transition(SS_x, {L1_GETS_piggyback, L1_GET_INSTR_piggyback}) {
