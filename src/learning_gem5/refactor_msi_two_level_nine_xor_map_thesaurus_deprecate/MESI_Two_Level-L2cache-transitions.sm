  }


  transition(L2ONLY_IS, {L1_GETX2, L1_GETX2_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }
  transition(IS_L2ONLY, {L1_GETX_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }


  transition(IS_IS, {L1_GETX_pb, L1_GETX_fwd, L1_GETX2_pb, L1_GETX2_fwd}){
    zz_stallAndWaitL1RequestQueue;
  }


  transition({IS_L2ONLY, IS_SS, 
    SI_L2ONLY_r1, SI_SS_r1, L2ONLY_SS_r1, 
    SS_L2ONLY_r2, SS_SI_r2, 
    }, 
    L1_UPGRADE) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({SS_IS, L2ONLY_IS, 
    SI_SS_r1, L2ONLY_SS_r1, SI_L2ONLY_r1
    L2ONLY_SI_r2, SS_SI_r2, SS_L2ONLY_r2, 
    }, 
    L1_UPGRADE2) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({IS_IS, 
    SI_L2ONLY_dd, SI_L2ONLY_dc, SI_SI_dd, SI_MI_dd, SI_MI_dc, SI_II_dc,
    II_L2ONLY_cd, II_SI_cd, L2ONLY_SI_dd, L2ONLY_II_dc, II_MI_cd,
    L2ONLY_SS_s, SS_L2ONLY_s, SSMB_SS_s, SS_SSMB_s, L2ONLY_SSMB_s, SSMB_L2ONLY_s}, 
    {L1_UPGRADE, L1_UPGRADE2}) {
    zz_stallAndWaitL1RequestQueue;
  }

  //singular states
  transition(SS_s, {L1_GETS, L1_GET_INSTR, L1_GETX, L1_UPGRADE,
    L2_Replacement, L2_Replacement_clean, 
    L1_PUTS_last, L1_PUTS_last2, L1_PUTS_not_last,L1_PUTS_not_last2,
    L1_PUTX_not_last, L1_PUTX}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition(L2ONLY_s, {L1_GETS, L1_GET_INSTR, L1_GETX, 
    L2_Replacement, L2_Replacement_clean, L1_PUTS_last, L1_PUTS_last2, L1_PUTS_not_last,L1_PUTS_not_last2}) {
    zz_stallAndWaitL1RequestQueue;
  }
  transition({I_I_s, I_I_sm, S_I_s}, {L1_GETS, L1_GET_INSTR, L1_GETX, L1_PUTS_old}) {
    zz_stallAndWaitL1RequestQueue;
  }

  transition({SS_s, L2ONLY_s, I_I_s, I_I_sm, S_I_s}, MEM_Inv) {
    zn_recycleResponseNetwork;
  }
