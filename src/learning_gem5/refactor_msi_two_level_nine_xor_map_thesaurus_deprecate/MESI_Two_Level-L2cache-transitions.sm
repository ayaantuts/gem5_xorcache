  transition({L2ONLY_IS, L2ONLY_SS}, L1_PUTS_old2) {
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
  }

// %%%%%%%%%%%%%%%%%%%%%% into XOR %%%%%%%%%%%%%%%%%%%%%%
  transition(SS, {L1_GETS_XOR, L1_GET_INSTR_XOR},  SS_IS) {
    aadir_allocateDir;
    aat_allocateTag;
    set1_tagMRU;
    set1_dataMRU;
    set1_dirMRU;

    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;

    lls_clearSecondarySharers;
    nns_addSecondarySharer;

    i_allocateTBE;
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
  }
  transition(SS_IS, Mem_Data2, SS_SS) {
    ml2_writeLogicalDataToCache;
    mpx_writePhyDataToCache_XOR_compress_update;
    el2_sendLogicalDataToGetSRequestors;

    // just in case ST has not been deallocated
    ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;

    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }

  transition(MTSB_IS, Mem_Data2, MTSB_SS) {
    ml2_writeLogicalDataToCache;
    mpx_writePhyDataToCache_XOR_compress_update;
    el2_sendLogicalDataToGetSRequestors;

    // just in case ST has not been deallocated
    // ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(MTSB_SS, Unblock, SS_SS) {
    nnu_addSharerFromUnblock;
    k_popUnblockQueue;
    kd1_wakeUpDependents;

    uur_profileDirRead;
  }


  transition(SS, L1_PUTX_XOR, SS_L2ONLY) {
    check_phy;
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aat_allocateTag;
    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    ddl2_deallocateL2CacheBlock;
    
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest;
    mpxr_writePhyDataToCache_XOR_fromRequest_compress_update;

    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }


  transition(IS, L1_PUTX_XOR, IS_L2ONLY) {
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aat_allocateTag;
    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    ddl2_deallocateL2CacheBlock;
    
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest; 
    mpr_writePhyDataToCache_fromRequest; // no processing yet, need processing when primary data is arrived

    
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(IS_L2ONLY, Mem_Data, SS_L2ONLY) {
    af;
    ml1_writeLogicalDataToCache;
    mpx_writePhyDataToCache_XOR_compress_update;
    el1_sendLogicalDataToGetSRequestors;


    s_deallocateTBE; // primary
    set_primary_as_cache_entry;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }

  transition(MT_SB, L1_PUTX_XOR, MTSB_L2ONLY) {
    check_phy;
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aat_allocateTag;
    // ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    ddl2_deallocateL2CacheBlock;
    
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest; 
    mpxr_writePhyDataToCache_XOR_fromRequest_compress_update;
    
    t_sendWBAck;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
    uur_profileDataRead;
  }
  transition(MTSB_L2ONLY, Unblock, SS_L2ONLY) {
    nnu_addSharerFromUnblock;
    k_popUnblockQueue;
    kd1_wakeUpDependents;

    uur_profileDirRead;
  }

  transition(IS, {L1_GETS_XOR, L1_GET_INSTR_XOR}, IS_IS) {
    aadir_allocateDir;
    aat_allocateTag;
    set1_tagMRU;
    set1_dataMRU;
    ddststs1_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;

    l2set1_isis;

    lls_clearSecondarySharers;
    nns_addSecondarySharer;

    i_allocateTBE; //secondary
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileDMTRead;
  }
  transition(IS_IS, Mem_Data2, IS_SS) {
    ml2_writeLogicalDataToCache;
    mp_writePhyDataToCache_compress_update;
    af;

    el2_sendLogicalDataToGetSRequestors;
    // just in case ST has not been deallocated
    ddststs1_deallocateSTSTS;
    ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtS_rm1;
    dmt_rm2;
    dmtS_rm2;

    l2set1_isss;
    

    s_deallocateTBE; // secondary
    o_popIncomingResponseQueue;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }
  transition(IS_IS, Mem_Data, SS_IS) {
    ml1_writeLogicalDataToCache;
    mp_writePhyDataToCache_compress_update;
    af;
    el1_sendLogicalDataToGetSRequestors;

    l2set2_ssis;

    s_deallocateTBE; // primary
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }
  transition(IS_SS, Mem_Data, SS_SS) {
    af;
    ml1_writeLogicalDataToCache;
    mpx_writePhyDataToCache_XOR_compress_update;
    el1_sendLogicalDataToGetSRequestors;

    s_deallocateTBE; // primary
    set_primary_as_cache_entry;
    l2set1_ssss;
    l2set2_ssss;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }

  transition(L2ONLY, {L1_GETS_XOR, L1_GET_INSTR_XOR},  L2ONLY_IS) {
    aadir_allocateDir;
    aat_allocateTag;
    set1_tagMRU;
    set1_dataMRU;
    ddst1_deallocateST;
    dddns_deallocateDataNS;
    dmt_rm1;
    dmtNS_rm1;

    lls_clearSecondarySharers;
    nns_addSecondarySharer;

    i_allocateTBE;
    ss_recordGetSL1ID;
    a_issueFetchToMemory;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
  }
  transition(L2ONLY_IS, Mem_Data2, L2ONLY_SS) {
    ml2_writeLogicalDataToCache;
    mpx_writePhyDataToCache_XOR_compress_update;
    el2_sendLogicalDataToGetSRequestors;

    // just in case ST has not been deallocated
    ddst1_deallocateST;
    ddststs_deallocateSTSTS;
    dmt_rm1;
    dmtNS_rm1;
    dmt_rm2;
    dmtS_rm2;

    s_deallocateTBE;
    o_popIncomingResponseQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;

    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
    uur_profileTagRead;
    uur_profileDataRead;
  }



