    buf_primary; // since unpairing now

    ddt_deallocateTag; // secondary
    dddir_deallocateDir; // secondary

    // primary block data needs to be recovered => L2ONLY_s
    // secondary block gone => I_I_s
    fsn2_sendInvSpecialToSharers_newest;
    fr2_sendInvToSharers_rest;
    l2set1_sss;

