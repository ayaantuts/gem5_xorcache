    ss_recordGetSL1ID;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(IS_IS, {L1_GETS2_pb, L1_GET_INSTR2_pb}) {
    nns_addSecondarySharer;
    set_secondary_as_tbe;
    ss_recordGetSL1ID;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDataRead;
  }
  // is_ss
  transition(IS_SS, {L1_GETS_fwd, L1_GET_INSTR_fwd}) {
    nn_addSharer;
    set_primary_as_tbe;
    ss_recordGetSL1ID;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(IS_SS, {L1_GETS_pb, L1_GET_INSTR_pb}) {
    nn_addSharer;
    set_primary_as_tbe;
    ss_recordGetSL1ID;
    uu_profileMiss;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDataRead;
  }
  transition(IS_SS, {L1_GETS2_fwd, L1_GET_INSTR2_fwd}) {
    dls2_sendSharedDataToRequestor;

    nns_addSecondarySharer;

    set_tagMRU;
    set_dataMRU;
    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }
  transition(IS_SS, {L1_GETS2_pb, L1_GET_INSTR2_pb}) {
    dls2_sendSharedDataToRequestor;

    nns_addSecondarySharer;

    set_tagMRU;
    set_dataMRU;
    set_dirMRU;

    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDataRead;
  }
// %%%%%%%%%%%%%%%%%%%%%% outof XOR %%%%%%%%%%%%%%%%%%%%%% 
//  ==== PUT ====
  transition(L2ONLY_SS, L1_PUTS_last2, L2ONLY_SS_s) { // expand from 1 to 2 entries
    tn_sendWBNack;
    aad_allocateData;
    update_data1;
    jj_popL1RequestQueue;

    uur_profileDirRead;
  }
  transition(L2ONLY_SS_s, L1_PUTS_last_data2, L2ONLY) {
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    aadns1_allocateDataNS;
    lls_clearSecondarySharers;

    mlr2_writeLogicalDataToCacheFromRequest;
    mpxr_writePhyDataToCache_XOR_fromRequest; // recover because primary needs to be recovered

    update_data1;
    update_data2;

    l2a2_allocateL2;
    set_secondary_as_cache_entry; // implicitly transition to L2ONLY
    // l2set2_l2only; // secondary: SS -> L2ONLY
    l2set1_l2only; // primary: L2ONLY

    aast1_allocateSingularTag_primary;
    aast2_allocateSingularTag_secondary;

    dmt_insert_fromCache2;
    dmt_insert_fromCache1;
    dmtNS_insert_fromCache2;
    dmtNS_insert_fromCache1;


    t_sendWBAck;
    jj_popL1RequestQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
  }
  
  

  transition(SS_L2ONLY, L1_PUTS_last, SS_L2ONLY_s) {
    tn_sendWBNack;
    aad2_allocateData;
    update_data1;
    jj_popL1RequestQueue;

    uur_profileDirRead;
  }
  transition(SS_L2ONLY_s, L1_PUTS_last_data, L2ONLY) {
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    aadns2_allocateDataNS;
    ll_clearSharers;

    mlr1_writeLogicalDataToCacheFromRequest;
    mpr_writePhyDataToCache_fromRequest; // directly write because primary needs to be remained

    update_data1;
    update_data2;

    l2a2_allocateL2;
    l2set2_l2only;
    // l2set1_l2only; // implicitly transition to L2ONLY

    aast1_allocateSingularTag_primary;
    aast2_allocateSingularTag_secondary;

    dmt_insert_fromCache1;
    dmt_insert_fromCache2;
    dmtNS_insert_fromCache1;
    dmtNS_insert_fromCache2;


    t_sendWBAck;
    jj_popL1RequestQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
  }
  
  transition(SS_L2ONLY, L1_PUTX, L2ONLY) { //NOTE: It's possible to receive old PUTX at SS state
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    aadns2_allocateDataNS;
    ll_clearSharers;

    mlr1_writeLogicalDataToCacheFromRequest;
    mpr_writePhyDataToCache_fromRequest; // directly write because primary needs to be remained

    update_data1;
    
    aad2_allocateData_size_accordingly;
    af;


    l2a2_allocateL2;
    l2set2_l2only;
    // l2set1_l2only; // implicitly transition to L2ONLY

    aast1_allocateSingularTag_primary;
    aast2_allocateSingularTag_secondary;

    dmt_insert_fromCache1;
    dmt_insert_fromCache2;
    dmtNS_insert_fromCache1;
    dmtNS_insert_fromCache2;


    t_sendWBAck;
    jj_popL1RequestQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
  }

  transition(SS_SS, L1_PUTX, L2ONLY) { //NOTE: It's possible to receive old PUTX at SS state
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
    ll_clearSharers;

    mlr1_writeLogicalDataToCacheFromRequest;
    mpr_writePhyDataToCache_fromRequest; // directly write because primary needs to be remained

    update_data1;
    aad2_allocateData_size_accordingly;

    l2a2_allocateL2;
    l2set2_ss;
    // l2set1_l2only; // implicitly transition to L2ONLY

    aast1_allocateSingularTag_primary;
    aaststs2_allocateSingularTagBoth_secondary;

    dmt_insert_fromCache1;
    dmtNS_insert_fromCache1;
    dmt_insert_fromCache2;
    dmtS_insert_fromCache2;


    t_sendWBAck;
    jj_popL1RequestQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
    uur_profileDMTRead;
    uur_profileDMTRead;
  }

  transition(IS_SS, L1_PUTS_last2, L2ONLY) { // just undo xor
    dddir_deallocateDir;
    aatns_allocateTagNS;
    aadns_allocateDataNS;
