    dmtS_insert_fromCache1;

    l2set1_ss;
    l2a2_allocateL2;
    set_secondary_as_cache_entry;
    mmu_markExclusiveFromUnblock;

    k_popUnblockQueue;
    kd1_wakeUpDependents;
    kd2_wakeUpDependents;
    xor_unpair;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDataRead;
