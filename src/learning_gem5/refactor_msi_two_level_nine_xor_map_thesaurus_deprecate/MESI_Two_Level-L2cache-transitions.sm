    fwr2_sendFwdReqInvToSharers;
    fwmn2_sendFwdInvToSharersMinusNewest;
    set_dirMRU;
    uu_profileHit;
    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }

  transition(SS_SS, L1_UPGRADE, SSMB_SS_s) { 
    ddt_deallocateTag;

    change_data_addr_from_primary_to_secondary;

    fwm_sendFwdInvToSharersMinusRequestor;
    tsS_sendInvAckSToUpgrader;

    set_dirMRU;
    uu_profileHit;

    jj_popL1RequestQueue;

    uur_profileDirRead;
    uur_profileTagRead;
    uur_profileDirRead;
  }

  transition(SS_SS, L1_UPGRADE2, SS_SSMB_s) { 
